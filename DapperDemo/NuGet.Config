<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      AvaloniaFramework is consumed as a NuGet package. Until it is published, it is restored from
      the sibling repo's pack output — building AvaloniaFramework drops the .nupkg there, since
      GeneratePackageOnBuild is on. Drop this source once the package is on nuget.org.
    -->
    <add key="AvaloniaFramework.Local" value="../../AvaloniaFramework/AvaloniaFramework/bin/Debug" />
  </packageSources>
</configuration>
