<Project>

    <PropertyGroup>
        <!--
            The app's release number, and the only place it is written. Change it here and it
            reaches everything else on the next build:

              * every assembly, as AssemblyInformationalVersion — which AppVersion
                (DapperDemo.Viewmodel/Viewmodels/Utils) reads back for the login and profile screens;
              * android:versionName, via ApplicationDisplayVersion in DapperDemo.Android;
              * CFBundleShortVersionString, via the same property in DapperDemo.iOS and .MacOS.

            The heads' ApplicationVersion is deliberately *not* wired to this: that is the integer
            build counter (versionCode / CFBundleVersion), which the stores require to increase on
            every upload and which cannot hold a dotted version.

            This file is imported by MSBuild for every project under the solution, which is why the
            property reaches all of them without any project referencing it. Note that central
            package management is still off — see CLAUDE.md; this file carries only this and NoWarn.
        -->
        <VersionPrefix>1.0.0</VersionPrefix>
        <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>
        <NoWarn>$(NoWarn);AVLN3001;AVLN:0005;AVLN:0003;SA1649;SA1300;CA1008;CA1062;CS8604;IDE0028;SA1101;IDE0008;IDE0011;IDE0046;IDE0060;IDE0290;IDE0058;IDE0160;IDE0066;IDE0051;IDE1006;IDE0010;IDE0032;IDE0045;IDE0052;IDE0057;IDE0022;IDE0005</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <IsTestProject Condition="$(MSBuildProjectName.Contains('Tests'))">true</IsTestProject>
        <IsApplicationProject Condition="$(MSBuildProjectName.Contains('App'))">true</IsApplicationProject>
        <IsLibraryProject Condition=" '$(IsTestProject)' != 'true' And '$(IsApplicationProject)' != 'true' ">true</IsLibraryProject>

        <!--
            Assembly and root namespaces are set per project rather than derived here: the app
            projects are already named DapperDemo.*, and the data layer maps to
            DapperDemo.Mensagens.Dapper.
        -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

</Project>
