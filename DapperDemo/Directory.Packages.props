<Project>

    <PropertyGroup>
        <VersionPrefix>1.0.0</VersionPrefix>
        <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>
        <NoWarn>$(NoWarn);AVLN3001;AVLN:0005;AVLN:0003;SA1649;SA1300;CA1008;CA1062;CS8604;IDE0028;SA1101;IDE0008;IDE0011;IDE0046;IDE0060;IDE0290;IDE0058;IDE0160;IDE0066;IDE0051;IDE1006;IDE0010;IDE0032;IDE0045;IDE0052;IDE0057;IDE0022;IDE0005</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <IsTestProject Condition="$(MSBuildProjectName.Contains('Tests'))">true</IsTestProject>
        <IsApplicationProject Condition="$(MSBuildProjectName.Contains('App'))">true</IsApplicationProject>
        <IsLibraryProject Condition=" '$(IsTestProject)' != 'true' And '$(IsApplicationProject)' != 'true' ">true</IsLibraryProject>

        <!--
            Assembly and root namespaces are set per project rather than derived here: the app
            projects are already named DapperDemo.*, and the data layer maps to
            DapperDemo.Mensagens.Dapper.
        -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

</Project>
