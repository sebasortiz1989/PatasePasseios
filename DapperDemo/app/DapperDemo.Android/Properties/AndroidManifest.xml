<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.example.patasePasseios" xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
	<uses-permission android:name="android.permission.INTERNET" />

	<!--
		Android 11 (API 30) hid other installed apps from package queries by default. Launching the
		Google Calendar link resolves an ACTION_VIEW intent, so the browser and the Calendar app
		have to be declared visible here or the launch silently finds no handler on API 30+.

		This is visibility, not a permission: the pre-filled link opens Calendar's own compose
		screen and the user saves the event there, so the app never reads or writes their calendar
		and needs no READ_CALENDAR/WRITE_CALENDAR grant.
	-->
	<queries>
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="https" />
		</intent>
	</queries>

	<!--
		The launcher icon. roundIcon is declared alongside it for the launchers that ask for a
		circular variant; both resolve to the same adaptive icon on API 26+, and to the plain
		bitmaps in mipmap-*dpi on the older versions this app still supports.
	-->
	<application android:label="@string/app_name" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round">
		<!--
			Lets a rendered report be handed to another app as a content:// URI. Since API 24 an
			intent carrying a file:// path throws FileUriExposedException, so sharing the PNG at
			all requires a provider.

			exported="false" plus grantUriPermissions="true" is the pair that matters: nothing can
			address the provider on its own, and the only access anyone gets is the temporary,
			read-only grant that rides along with the share intent. What it may address is one
			folder inside the app's cache — see Resources/xml/file_paths.xml.

			${applicationId} is substituted at build time, so the authority follows the csproj's
			ApplicationId rather than the package attribute above; AndroidShareSheet builds the
			same string from the running package name so the two cannot drift.
		-->
		<provider
			android:name="androidx.core.content.FileProvider"
			android:authorities="${applicationId}.fileprovider"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/file_paths" />
		</provider>
	</application>
</manifest>
