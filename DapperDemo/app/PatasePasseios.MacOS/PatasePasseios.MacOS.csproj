<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
    <TargetFramework>net10.0-macOS</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <ApplicationTitle>PatasePasseios.MacOS</ApplicationTitle>
    <ApplicationId>com.dapperdemo.app</ApplicationId>
    <!--  CFBundleShortVersionString, from the one place the release number is written.  -->
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <!--  CFBundleVersion — a build counter rather than the release number, so it is bumped by hand.  -->
    <ApplicationVersion>1</ApplicationVersion>
    <AssemblyName>PatasePasseios.MacOS</AssemblyName>
    <RootNamespace>PatasePasseios.MacOS</RootNamespace>
<!--    <VerifyXcodeVersion>false</VerifyXcodeVersion>-->
</PropertyGroup>

<ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
</ItemGroup>

<ItemGroup>
    <ProjectReference Include="..\PatasePasseios.Infrastructure\PatasePasseios.Infrastructure.csproj" />
</ItemGroup>


</Project>
