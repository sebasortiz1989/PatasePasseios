<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>DapperDemo.Viewmodel</AssemblyName>
        <RootNamespace>DapperDemo.Viewmodel</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Void and the container types are used pervasively across view models. -->
        <Using Include="AvaloniaFramework" />
        <Using Include="AvaloniaFramework.DependencyInjection" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\external\AvaloniaFramework\AvaloniaFramework\AvaloniaFramework.csproj" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Repository.Dapper\Repository.Dapper.csproj" />
    </ItemGroup>

</Project>
