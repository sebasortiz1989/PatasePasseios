<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.MainViewViews.AgendaView"
    x:DataType="mainViewViewmodels:AgendaViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mainViewViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.MainViewViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Background="{StaticResource ColorBg}"
        Width="720">
        <ScrollViewer>
            <StackPanel Spacing="0">
                <StackPanel Margin="32,32,32,16" Spacing="2">
                    <TextBlock
                        Classes="Heading1"
                        FontSize="62"
                        Text="Agenda" />
                    <TextBlock Classes="Kicker" Text="{Binding TodayLabel}" />
                </StackPanel>

                <!--  Date range filters  -->
                <StackPanel
                    Margin="32,16,32,0"
                    Orientation="Horizontal"
                    Spacing="16">
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsRangeHoje}"
                        Command="{Binding SetRangeHoje}"
                        Content="Hoje" />
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsRangeSemana}"
                        Command="{Binding SetRangeSemana}"
                        Content="Semana" />
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsRangeData}"
                        Command="{Binding SetRangeData}"
                        Content="Data" />
                </StackPanel>

                <!--
                    Revealed by the Data chip: the month and year the list is scoped to. The month
                    list carries an "Ano todo" entry, so this one control covers a single month and
                    a whole year without needing a chip for each.
                -->
                <Grid
                    ColumnDefinitions="*,16,Auto"
                    IsVisible="{Binding ShowDatePicker}"
                    Margin="32,16,32,0">
                    <ComboBox
                        Classes="FormInput"
                        ItemsSource="{Binding MonthOptions}"
                        SelectedItem="{Binding SelectedMonth}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="mainViewViewmodels:MonthOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox
                        Classes="FormInput"
                        Grid.Column="2"
                        ItemsSource="{Binding YearOptions}"
                        MinWidth="180"
                        SelectedItem="{Binding SelectedYear}" />
                </Grid>

                <!--
                    Service type filters. A WrapPanel rather than a horizontal StackPanel: five
                    chips no longer fit across the 720 canvas, so the row is allowed to break.
                    Spacing comes from each chip's margin, which WrapPanel honours.
                -->
                <WrapPanel Margin="32,16,32,0">
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsTypeTodos}"
                        Command="{Binding SetTypeTodos}"
                        Content="Tudo"
                        Margin="0,0,16,12" />
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsTypeWalk}"
                        Command="{Binding SetTypeWalk}"
                        Content="Passeio"
                        Margin="0,0,16,12" />
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsTypeSitting}"
                        Command="{Binding SetTypeSitting}"
                        Content="Pet sitting"
                        Margin="0,0,16,12" />
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsTypeHotel}"
                        Command="{Binding SetTypeHotel}"
                        Content="Hotel"
                        Margin="0,0,16,12" />
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsTypeDayCare}"
                        Command="{Binding SetTypeDayCare}"
                        Content="Day-Care"
                        Margin="0,0,16,12" />
                </WrapPanel>

                <CheckBox
                    Content="Mostrar serviços já pagos"
                    FontFamily="{StaticResource FontBody}"
                    FontSize="28"
                    Foreground="{StaticResource ColorTextMuted65}"
                    IsChecked="{Binding HomeShowPaid}"
                    Margin="32,24,32,16"
                    Theme="{StaticResource ClassicCheckBox}"
                />

                <Border
                    BorderBrush="{StaticResource ColorDivider}"
                    BorderThickness="0,2,0,0"
                    IsVisible="{Binding HasNoServices}"
                    Margin="32,0,32,0"
                    Padding="32,64">
                    <TextBlock
                        FontFamily="{StaticResource FontBody}"
                        FontSize="29"
                        FontStyle="Italic"
                        Foreground="{StaticResource ColorTextMuted45}"
                        HorizontalAlignment="Center"
                        Text="Nenhum serviço neste filtro." />
                </Border>

                <!--
                    Per-dog summary. Replaces the chronological list while "incluir pagos" is on,
                    where every past booking is in scope and a flat list runs to hundreds of rows.
                -->
                <ItemsControl
                    IsVisible="{Binding ShowSummary}"
                    ItemsSource="{Binding DogSummaries}"
                    Margin="32,0,32,48">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="mainViewViewmodels:DogSummaryRow">
                            <Border
                                BorderBrush="{StaticResource ColorDivider}"
                                BorderThickness="0,2,0,0"
                                Padding="0,24">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            FontFamily="{StaticResource FontHeading}"
                                            FontSize="40"
                                            FontWeight="Medium"
                                            Foreground="{StaticResource ColorText}"
                                            Text="{Binding DogName}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            FontFamily="{StaticResource FontHeading}"
                                            FontSize="37"
                                            Foreground="{StaticResource ColorAccentDark800}"
                                            Grid.Column="1"
                                            Text="{Binding TotalLabel}"
                                            VerticalAlignment="Center" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="mainViewViewmodels:DogSummaryLine">
                                                <Grid ColumnDefinitions="*,Auto" Margin="24,0,0,8">
                                                    <TextBlock
                                                        FontFamily="{StaticResource FontBody}"
                                                        FontSize="27"
                                                        Foreground="{StaticResource ColorTextMuted65}"
                                                        Text="{Binding CountLabel}"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        FontFamily="{StaticResource FontBody}"
                                                        FontSize="27"
                                                        Foreground="{StaticResource ColorTextMuted55}"
                                                        Grid.Column="1"
                                                        Text="{Binding AmountLabel}"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl
                    IsVisible="{Binding ShowServiceList}"
                    ItemsSource="{Binding FilteredServices}"
                    Margin="32,0,32,48">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="mainViewViewmodels:ServiceRow">
                            <Button Classes="RowButton" Command="{Binding OpenCommand}">
                                <Border
                                    BorderBrush="{StaticResource ColorDivider}"
                                    BorderThickness="0,2,0,0"
                                    Padding="0,24">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <Border
                                            BorderBrush="{StaticResource ColorDivider}"
                                            BorderThickness="0,0,2,0"
                                            Padding="0,0,16,0"
                                            Width="91">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    FontFamily="{StaticResource FontHeading}"
                                                    FontSize="46"
                                                    Foreground="{StaticResource ColorText}"
                                                    HorizontalAlignment="Center"
                                                    Text="{Binding DayNum}" />
                                                <TextBlock
                                                    FontFamily="{StaticResource FontBody}"
                                                    FontSize="20"
                                                    Foreground="{StaticResource ColorTextMuted50}"
                                                    HorizontalAlignment="Center"
                                                    LetterSpacing="1"
                                                    Text="{Binding MonthShort}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="24,0,16,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontFamily="{StaticResource FontHeading}"
                                                FontSize="37"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource ColorText}"
                                                Text="{Binding DogName}" />
                                            <TextBlock
                                                FontFamily="{StaticResource FontBody}"
                                                FontSize="25"
                                                Foreground="{StaticResource ColorTextMuted55}">
                                                <Run Text="{Binding TypeLabel}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding TimeLabel}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding PriceLabel}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button
                                            Classes="Tag"
                                            Classes.Paid="{Binding Paid}"
                                            Classes.Pending="{Binding !Paid}"
                                            Command="{Binding ToggleCommand}"
                                            Content="{Binding PaidLabel}"
                                            Grid.Column="2"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
