<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.MainViewViews.UsersView"
    x:DataType="mainViewViewmodels:UsersViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:buttons="using:AvaloniaFramework.Controls.Buttons"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mainViewViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.MainViewViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="using:System"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource ColorBg}" Height="1460" Width="720">
        <ScrollViewer>
            <StackPanel Spacing="0">
                <StackPanel Margin="32,32,32,16" Spacing="2">
                    <TextBlock Classes="Heading1" FontSize="62" Text="{Binding CurrentUserName}" />
                    <TextBlock Classes="Kicker" Text="Conta" />
                </StackPanel>

                <StackPanel Margin="32,16,32,48" Spacing="32">
                    <!--  Profile card  -->
                    <Border Classes="Card">
                        <StackPanel Spacing="16">
                            <!--  Reading state  -->
                            <StackPanel IsVisible="{Binding IsViewingProfile}" Spacing="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="CardTitle" FontSize="37" Text="Perfil" VerticalAlignment="Center" />
                                    <buttons:VButton
                                        Classes="BtnSecondary"
                                        Command="{Binding EditProfileCommand}"
                                        Grid.Column="1"
                                        Height="64"
                                        VText="Editar"
                                        VerticalAlignment="Center"
                                        Width="160" />
                                </Grid>
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="Kicker" Text="E-mail" />
                                        <TextBlock
                                            FontFamily="{StaticResource FontBody}"
                                            FontSize="29"
                                            Foreground="{StaticResource ColorText}"
                                            Text="{Binding Email}" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="Kicker" Text="Chave Pix" />
                                        <TextBlock
                                            FontFamily="{StaticResource FontBody}"
                                            FontSize="29"
                                            Foreground="{StaticResource ColorText}"
                                            Text="{Binding PixLabel}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="Kicker" Text="Nascimento" />
                                        <TextBlock
                                            FontFamily="{StaticResource FontBody}"
                                            FontSize="29"
                                            Foreground="{StaticResource ColorText}"
                                            Text="{Binding BirthDateLabel}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!--  Editing state  -->
                            <StackPanel IsVisible="{Binding IsEditingProfile}" Spacing="16">
                                <TextBlock Classes="CardTitle" Text="Editar perfil" />
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="FormLabel" Text="Nome" />
                                    <TextBox Classes="FormInput" FontSize="29" MinHeight="74" Text="{Binding EditName}" />
                                </StackPanel>
                                <!--
                                    Shown but not editable: the e-mail is the login, so it is
                                    fixed once the account exists. Kept visible rather than
                                    dropped, so it does not look like it went missing.
                                -->
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="FormLabel" Text="E-mail" />
                                    <Border
                                        BorderBrush="{StaticResource ColorDivider}"
                                        BorderThickness="2"
                                        CornerRadius="7"
                                        MinHeight="74"
                                        Padding="18,0">
                                        <TextBlock
                                            FontFamily="{StaticResource FontBody}"
                                            FontSize="29"
                                            Foreground="{StaticResource ColorTextMuted50}"
                                            Text="{Binding Email}"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="23"
                                        FontStyle="Italic"
                                        Foreground="{StaticResource ColorTextMuted45}"
                                        Text="O e-mail identifica a conta e não pode ser alterado."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="FormLabel" Text="Chave Pix" />
                                    <TextBox
                                        Classes="FormInput"
                                        FontSize="29"
                                        MinHeight="74"
                                        PlaceholderText="telefone, e-mail, CPF ou chave aleatória"
                                        Text="{Binding EditPix}" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="FormLabel" Text="Nascimento" />
                                    <CalendarDatePicker
                                        Background="Transparent"
                                        BorderBrush="{StaticResource ColorDivider}"
                                        BorderThickness="2"
                                        CornerRadius="7"
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="29"
                                        Foreground="{StaticResource ColorText}"
                                        MinHeight="74"
                                        SelectedDate="{Binding EditBirthDate}" />
                                </StackPanel>
                                <TextBlock
                                    Classes="FormMsg Error"
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="28"
                                    FontStyle="Italic"
                                    IsVisible="{Binding HasProfileMsg}"
                                    Text="{Binding ProfileMsg}"
                                    TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,16,*">
                                    <buttons:VButton Classes="BtnSecondary" Command="{Binding CancelProfileCommand}" Height="70" VText="Cancelar" />
                                    <buttons:VButton Classes="BtnPrimary" Command="{Binding SaveProfileCommand}" Grid.Column="2" Height="70" VText="Salvar" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  Password card  -->
                    <Border Classes="Card">
                        <StackPanel Spacing="16">
                            <!--  Editing state  -->
                            <StackPanel IsVisible="{Binding ShowPasswordForm}" Spacing="16">
                                <TextBlock Classes="CardTitle" Text="Alterar senha" />
                                <!--  The current one is required: the app has no lock of its own.  -->
                                <TextBox
                                    Classes="FormInput"
                                    FontSize="29"
                                    MinHeight="74"
                                    PasswordChar="•"
                                    PlaceholderText="Senha atual"
                                    Text="{Binding CurrentPw}" />
                                <TextBox
                                    Classes="FormInput"
                                    FontSize="29"
                                    MinHeight="74"
                                    PasswordChar="•"
                                    PlaceholderText="Nova senha"
                                    Text="{Binding NewPw}" />
                                <TextBox
                                    Classes="FormInput"
                                    FontSize="29"
                                    MinHeight="74"
                                    PasswordChar="•"
                                    PlaceholderText="Confirmar senha"
                                    Text="{Binding ConfirmPw}" />
                                <Grid ColumnDefinitions="*,16,*">
                                    <buttons:VButton Classes="BtnSecondary" Command="{Binding CancelPasswordFormCommand}" Height="70" VText="Cancelar" />
                                    <buttons:VButton Classes="BtnPrimary" Command="{Binding SavePasswordCommand}" Grid.Column="2" Height="70" VText="Salvar" />
                                </Grid>
                            </StackPanel>

                            <!--  Outside both states: a success has to survive the form closing.  -->
                            <TextBlock
                                Classes="FormMsg"
                                Classes.Error="{Binding PwMsgIsError}"
                                FontFamily="{StaticResource FontBody}"
                                FontSize="28"
                                FontStyle="Italic"
                                IsVisible="{Binding HasPwMsg}"
                                Text="{Binding PwMsg}"
                                TextWrapping="Wrap" />

                            <!--  Summary state  -->
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowPasswordSummary}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="CardTitle" FontSize="37" Text="Senha" />
                                    <TextBlock
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="25"
                                        Foreground="{StaticResource ColorTextMuted50}"
                                        LetterSpacing="3"
                                        Text="••••••••" />
                                </StackPanel>
                                <buttons:VButton
                                    Classes="BtnSecondary"
                                    Command="{Binding OpenPasswordFormCommand}"
                                    Grid.Column="1"
                                    Height="64"
                                    VText="Alterar"
                                    VerticalAlignment="Center"
                                    Width="160" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Portfolio counters  -->
                    <Grid ColumnDefinitions="*,*,*,*">
                        <StackPanel Spacing="2">
                            <TextBlock FontFamily="{StaticResource FontHeading}" FontSize="46" Foreground="{StaticResource ColorText}" Text="{Binding TutorCountLabel}" />
                            <TextBlock Classes="Kicker" Text="Tutores" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock FontFamily="{StaticResource FontHeading}" FontSize="46" Foreground="{StaticResource ColorText}" Text="{Binding DogCountLabel}" />
                            <TextBlock Classes="Kicker" Text="Cães" />
                        </StackPanel>
                        <!--  Scoped to the month selected below, unlike the three around it.  -->
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock FontFamily="{StaticResource FontHeading}" FontSize="46" Foreground="{StaticResource ColorText}" Text="{Binding ServiceCountLabel}" />
                            <TextBlock Classes="Kicker" Text="No mês" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock FontFamily="{StaticResource FontHeading}" FontSize="46" Foreground="{StaticResource ColorAccentDark700}" Text="{Binding PendingCountLabel}" />
                            <TextBlock Classes="Kicker" Text="Pendentes" />
                        </StackPanel>
                    </Grid>

                    <!--  Monthly billing  -->
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontFamily="{StaticResource FontBody}"
                            FontSize="23"
                            Foreground="{StaticResource ColorAccent}"
                            LetterSpacing="2"
                            Text="FATURAMENTO" />

                        <!--  Month and year pick the period; the eye hides the figures.  -->
                        <Grid ColumnDefinitions="*,12,Auto,12,Auto" Margin="0,10,0,0">
                            <ComboBox
                                Classes="FormInput"
                                FontSize="29"
                                ItemsSource="{Binding MonthOptions}"
                                MinHeight="72"
                                SelectedItem="{Binding SelectedMonth}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="mainViewViewmodels:MonthOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox
                                Classes="FormInput"
                                FontSize="29"
                                Grid.Column="2"
                                ItemsSource="{Binding YearOptions}"
                                MinHeight="72"
                                MinWidth="150"
                                SelectedItem="{Binding SelectedYear}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="sys:Int32">
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button
                                Classes="IconToggle"
                                Command="{Binding ToggleMoneyVisibleCommand}"
                                Grid.Column="4"
                                ToolTip.Tip="Mostrar ou ocultar valores">
                                <Viewbox Height="36" Width="36">
                                    <Panel>
                                        <Path
                                            Data="{StaticResource IconEyeOpen}"
                                            IsVisible="{Binding MoneyVisible}"
                                            Stroke="{StaticResource ColorAccent}"
                                            StrokeThickness="1.8" />
                                        <Path
                                            Data="{StaticResource IconEyeClosed}"
                                            IsVisible="{Binding MoneyHidden}"
                                            Stroke="{StaticResource ColorAccent}"
                                            StrokeThickness="1.8" />
                                    </Panel>
                                </Viewbox>
                            </Button>
                        </Grid>

                        <TextBlock
                            FontFamily="{StaticResource FontHeading}"
                            FontSize="88"
                            Foreground="{StaticResource ColorText}"
                            Margin="0,16,0,16"
                            Text="{Binding MonthTotalLabel}" />

                        <ItemsControl ItemsSource="{Binding IncomeBreakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="mainViewViewmodels:IncomeRow">
                                    <Border BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,2,0,0" Padding="0,16">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock FontFamily="{StaticResource FontBody}" FontSize="29" Foreground="{StaticResource ColorTextMuted75}" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" FontFamily="{StaticResource FontHeading}" FontSize="36" Foreground="{StaticResource ColorText}" Text="{Binding Amount}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,2,0,0" Padding="0,16,0,0">
                            <TextBlock
                                FontFamily="{StaticResource FontBody}"
                                FontSize="23"
                                FontStyle="Italic"
                                Foreground="{StaticResource ColorTextMuted45}"
                                Text="Considera apenas serviços marcados como pagos. Pendentes conta todos os meses."
                                TextWrapping="Wrap" />
                        </Border>

                        <buttons:VButton
                            Classes="BtnSecondary"
                            Command="{Binding ExportMonthCommand}"
                            Height="80"
                            HorizontalAlignment="Stretch"
                            Margin="0,20,0,0"
                            VText="Exportar resumo do mês (PDF)" />
                        <TextBlock
                            Classes="FormMsg"
                            FontFamily="{StaticResource FontBody}"
                            FontSize="24"
                            FontStyle="Italic"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding HasExportMsg}"
                            Margin="0,8,0,0"
                            Text="{Binding ExportMsg}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <buttons:VButton Classes="BtnGhost" Command="{Binding LogoutCommand}" Height="70" HorizontalAlignment="Stretch" VText="Sair da conta" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>