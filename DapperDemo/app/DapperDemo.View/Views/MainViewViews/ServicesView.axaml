<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.MainViewViews.ServicesView"
    x:DataType="mainViewViewmodels:ServicesViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:buttons="using:AvaloniaFramework.Controls.Buttons"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mainViewViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.MainViewViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource ColorBg}" Width="720">
        <ScrollViewer>
            <StackPanel Spacing="0">
                <StackPanel Margin="32,32,32,16" Spacing="2">
                    <TextBlock Classes="Heading1" FontSize="62" Text="Novo serviço" />
                    <TextBlock Classes="Kicker" Text="Agendar" />
                </StackPanel>

                <!--  Nothing can be scheduled without a dog, so say so instead of showing an empty picker  -->
                <Border BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,2,0,0" IsVisible="{Binding HasNoDogs}" Margin="32,16,32,0" Padding="32,64">
                    <TextBlock
                        FontFamily="{StaticResource FontBody}"
                        FontSize="29"
                        FontStyle="Italic"
                        Foreground="{StaticResource ColorTextMuted45}"
                        HorizontalAlignment="Center"
                        Text="Cadastre um tutor e um cachorro antes de agendar."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>

                <StackPanel IsVisible="{Binding HasDogs}" Margin="32,16,32,48" Spacing="24">
                    <!--  Service type — segmented control  -->
                    <StackPanel Spacing="10">
                        <TextBlock FontFamily="{StaticResource FontBody}" FontSize="25" Foreground="{StaticResource ColorTextMuted70}" Text="Tipo de serviço" />
                        <!--
                            Two by two rather than one row of four: at a quarter of the canvas
                            "Pet sitting" no longer fits inside its own segment.
                        -->
                        <Border BorderBrush="{StaticResource ColorDivider}" BorderThickness="2" CornerRadius="7">
                            <Grid ColumnDefinitions="*,2,*" RowDefinitions="Auto,2,Auto">
                                <Button Classes="SegOption" Classes.Active="{Binding IsTypeWalk}" Command="{Binding SetTypeWalk}" Content="Passeio" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Border Background="{StaticResource ColorDivider}" Grid.Column="1" />
                                <Button Classes="SegOption" Classes.Active="{Binding IsTypeSitting}" Command="{Binding SetTypeSitting}" Content="Pet sitting" Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

                                <Border Background="{StaticResource ColorDivider}" Grid.ColumnSpan="3" Grid.Row="1" />

                                <Button Classes="SegOption" Classes.Active="{Binding IsTypeHotel}" Command="{Binding SetTypeHotel}" Content="Hotel" Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Border Background="{StaticResource ColorDivider}" Grid.Column="1" Grid.Row="2" />
                                <Button Classes="SegOption" Classes.Active="{Binding IsTypeDayCare}" Command="{Binding SetTypeDayCare}" Content="Day-Care" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!--  Dog picker  -->
                    <StackPanel Spacing="10">
                        <TextBlock FontFamily="{StaticResource FontBody}" FontSize="25" Foreground="{StaticResource ColorTextMuted70}" Text="Cachorro" />
                        <ComboBox
                            Background="Transparent"
                            BorderBrush="{StaticResource ColorDivider}"
                            BorderThickness="2"
                            CornerRadius="7"
                            FontFamily="{StaticResource FontBody}"
                            FontSize="31"
                            Foreground="{StaticResource ColorText}"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding DogOptions}"
                            MinHeight="74"
                            Padding="18,0"
                            PlaceholderText="Selecione…"
                            SelectedItem="{Binding SelectedDog}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="mainViewViewmodels:DogOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!--  Confirms which tutor the booking is with, derived from the chosen dog.  -->
                        <StackPanel
                            IsVisible="{Binding HasSelectedTutor}"
                            Orientation="Horizontal"
                            Spacing="10">
                            <TextBlock
                                Classes="Kicker"
                                Text="Tutor"
                                VerticalAlignment="Center" />
                            <TextBlock
                                FontFamily="{StaticResource FontBody}"
                                FontSize="27"
                                Foreground="{StaticResource ColorText}"
                                Text="{Binding SelectedTutorName}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Hotel: check-in / check-out / walks / price per day  -->
                    <StackPanel IsVisible="{Binding SvcIsHotel}" Spacing="24">
                        <StackPanel Spacing="10">
                            <TextBlock FontFamily="{StaticResource FontBody}" FontSize="25" Foreground="{StaticResource ColorTextMuted70}" Text="Entrada" />
                            <Grid ColumnDefinitions="*,16,Auto">
                                <CalendarDatePicker
                                    Background="Transparent"
                                    BorderBrush="{StaticResource ColorDivider}"
                                    BorderThickness="2"
                                    CornerRadius="7"
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="29"
                                    Foreground="{StaticResource ColorText}"
                                    MinHeight="74"
                                    SelectedDate="{Binding SvcDatePart}" />
                                <TimePicker
                                    ClockIdentifier="24HourClock"
                                    Grid.Column="2"
                                    MinHeight="74"
                                    SelectedTime="{Binding SvcTimePart}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock FontFamily="{StaticResource FontBody}" FontSize="25" Foreground="{StaticResource ColorTextMuted70}" Text="Saída" />
                            <Grid ColumnDefinitions="*,16,Auto">
                                <CalendarDatePicker
                                    Background="Transparent"
                                    BorderBrush="{StaticResource ColorDivider}"
                                    BorderThickness="2"
                                    CornerRadius="7"
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="29"
                                    Foreground="{StaticResource ColorText}"
                                    MinHeight="74"
                                    SelectedDate="{Binding SvcEndDatePart}" />
                                <TimePicker
                                    ClockIdentifier="24HourClock"
                                    Grid.Column="2"
                                    MinHeight="74"
                                    SelectedTime="{Binding SvcEndTimePart}" />
                            </Grid>
                        </StackPanel>

                        <CheckBox
                            Content="Inclui passeios diários"
                            FontFamily="{StaticResource FontBody}"
                            FontSize="29"
                            Foreground="{StaticResource ColorTextMuted70}"
                            IsChecked="{Binding SvcRequiresWalking}"
                            Theme="{StaticResource ClassicCheckBox}"
                        />

                        <StackPanel Spacing="10">
                            <TextBlock FontFamily="{StaticResource FontBody}" FontSize="25" Foreground="{StaticResource ColorTextMuted70}" Text="Preço por dia (R$)" />
                            <TextBox
                                Background="Transparent"
                                BorderBrush="{StaticResource ColorDivider}"
                                BorderThickness="2"
                                CaretBrush="{StaticResource ColorAccent}"
                                CornerRadius="7"
                                FontFamily="{StaticResource FontBody}"
                                FontSize="31"
                                Foreground="{StaticResource ColorText}"
                                MinHeight="74"
                                Padding="18,0"
                                Text="{Binding SvcPricePerDay}"
                                VerticalContentAlignment="Center"
                                PlaceholderText="0,00" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Walk / pet sitting: single date + price  -->
                    <StackPanel IsVisible="{Binding SvcIsSingleDate}" Spacing="24">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="25"
                                    Foreground="{StaticResource ColorTextMuted70}"
                                    Text="Datas"
                                    VerticalAlignment="Center" />
                                <buttons:VButton
                                    Classes="BtnGhost"
                                    Command="{Binding AddDateCommand}"
                                    Grid.Column="1"
                                    Height="56"
                                    IsVisible="{Binding SvcUsesDateList}"
                                    VText="+ Data" />
                            </Grid>

                            <CheckBox
                                Content="Usar intervalo de datas"
                                FontFamily="{StaticResource FontBody}"
                                FontSize="27"
                                Foreground="{StaticResource ColorTextMuted70}"
                                IsChecked="{Binding SvcUseDateRange}"
                                Theme="{StaticResource ClassicCheckBox}"
                            />

                            <!--  Individual days: the 1st, 3rd and 10th rather than a run.  -->
                            <ItemsControl IsVisible="{Binding SvcUsesDateList}" ItemsSource="{Binding SvcDates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="mainViewViewmodels:ServiceDateSlot">
                                        <Grid ColumnDefinitions="*,12,Auto" Margin="0,0,0,12">
                                            <CalendarDatePicker
                                                Background="Transparent"
                                                BorderBrush="{StaticResource ColorDivider}"
                                                BorderThickness="2"
                                                CornerRadius="7"
                                                FontFamily="{StaticResource FontBody}"
                                                FontSize="29"
                                                Foreground="{StaticResource ColorText}"
                                                HorizontalAlignment="Stretch"
                                                MinHeight="74"
                                                SelectedDate="{Binding Date}" />
                                            <buttons:VButton
                                                Classes="BtnGhost"
                                                Command="{Binding RemoveCommand}"
                                                Grid.Column="2"
                                                Height="74"
                                                IsVisible="{Binding CanRemove}"
                                                VText="Remover"
                                                Width="150" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--  Continuous range: every day from one date through another.  -->
                            <StackPanel IsVisible="{Binding SvcUseDateRange}" Spacing="10">
                                <TextBlock FontFamily="{StaticResource FontBody}" FontSize="25" Foreground="{StaticResource ColorTextMuted70}" Text="De" />
                                <CalendarDatePicker
                                    Background="Transparent"
                                    BorderBrush="{StaticResource ColorDivider}"
                                    BorderThickness="2"
                                    CornerRadius="7"
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="29"
                                    Foreground="{StaticResource ColorText}"
                                    HorizontalAlignment="Stretch"
                                    MinHeight="74"
                                    SelectedDate="{Binding SvcRangeFromPart}" />
                                <TextBlock FontFamily="{StaticResource FontBody}" FontSize="25" Foreground="{StaticResource ColorTextMuted70}" Text="Até" />
                                <CalendarDatePicker
                                    Background="Transparent"
                                    BorderBrush="{StaticResource ColorDivider}"
                                    BorderThickness="2"
                                    CornerRadius="7"
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="29"
                                    Foreground="{StaticResource ColorText}"
                                    HorizontalAlignment="Stretch"
                                    MinHeight="74"
                                    SelectedDate="{Binding SvcRepeatUntilPart}" />
                            </StackPanel>
                        </StackPanel>

                        <!--
                            Extra times of day — a sitting often runs morning and night. Hidden for
                            day-care, which is booked for the day rather than for a time.
                        -->
                        <StackPanel IsVisible="{Binding SvcUsesTimes}" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="25"
                                    Foreground="{StaticResource ColorTextMuted70}"
                                    Text="Horários por dia"
                                    VerticalAlignment="Center" />
                                <buttons:VButton
                                    Classes="BtnGhost"
                                    Command="{Binding AddTimeCommand}"
                                    Grid.Column="1"
                                    Height="56"
                                    VText="+ Horário" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding SvcTimes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="mainViewViewmodels:ServiceTimeSlot">
                                        <Grid ColumnDefinitions="*,12,Auto" Margin="0,0,0,12">
                                            <TimePicker
                                                ClockIdentifier="24HourClock"
                                                HorizontalAlignment="Stretch"
                                                MinHeight="74"
                                                SelectedTime="{Binding Time}" />
                                            <!--  Hidden on the last remaining row: the form needs at least one time.  -->
                                            <buttons:VButton
                                                Classes="BtnGhost"
                                                Command="{Binding RemoveCommand}"
                                                Grid.Column="2"
                                                Height="74"
                                                IsVisible="{Binding CanRemove}"
                                                VText="Remover"
                                                Width="150" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!--  Day-care bundles walks the same way a hotel stay does.  -->
                        <CheckBox
                            Content="Inclui passeios"
                            FontFamily="{StaticResource FontBody}"
                            FontSize="29"
                            Foreground="{StaticResource ColorTextMuted70}"
                            IsChecked="{Binding SvcRequiresWalking}"
                            IsVisible="{Binding SvcIsDayCare}"
                            Theme="{StaticResource ClassicCheckBox}"
                        />

                        <TextBlock
                            Classes="Kicker"
                            IsVisible="{Binding HasSvcOccurrenceSummary}"
                            Text="{Binding SvcOccurrenceSummary}" />

                        <StackPanel Spacing="10">
                            <TextBlock FontFamily="{StaticResource FontBody}" FontSize="25" Foreground="{StaticResource ColorTextMuted70}" Text="Preço (R$)" />
                            <TextBox
                                Background="Transparent"
                                BorderBrush="{StaticResource ColorDivider}"
                                BorderThickness="2"
                                CaretBrush="{StaticResource ColorAccent}"
                                CornerRadius="7"
                                FontFamily="{StaticResource FontBody}"
                                FontSize="31"
                                Foreground="{StaticResource ColorText}"
                                MinHeight="74"
                                Padding="18,0"
                                Text="{Binding SvcPrice}"
                                VerticalContentAlignment="Center"
                                PlaceholderText="0,00" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        Classes="FormMsg"
                        Classes.Error="{Binding SvcMsgIsError}"
                        FontFamily="{StaticResource FontBody}"
                        FontSize="28"
                        FontStyle="Italic"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding HasSvcMsg}"
                        Text="{Binding SvcMsg}"
                        TextAlignment="Center" />

                    <buttons:VButton Classes="BtnPrimary" Command="{Binding CreateServiceCommand}" Height="80" HorizontalAlignment="Stretch" VText="Agendar serviço" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
