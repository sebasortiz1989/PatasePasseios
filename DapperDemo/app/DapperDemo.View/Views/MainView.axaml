<UserControl
    d:DesignHeight="1560"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="Verion.Treinamento.DapperDemo.View.Views.MainView"
    x:DataType="viewmodels:MainViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:buttons="clr-namespace:Verion.Apresentacao.Avalonia.Buttons;assembly=Verion.Apresentacao.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:Verion.Treinamento.DapperDemo.Viewmodel.Viewmodels;assembly=Verion.Treinamento.DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Viewbox>
        <Grid
            Background="#FDFBF7"
            RowDefinitions="1460, 100"
            Width="720">

            <TransitioningContentControl Content="{Binding CurrentView}" Grid.Row="0">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.25" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>

            <buttons:VButton
                Classes="DapperButton"
                Command="{Binding BackCommand}"
                Grid.Row="0"
                HorizontalAlignment="Left"
                Margin="50"
                VText="Voltar"
                VerticalAlignment="Top" />

            <!--  Bottom navigation bar  -->
            <Border
                BorderBrush="Black"
                BorderThickness="0,3,0,0"
                Grid.Row="1">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="-2">

                    <!--  Dog Tap  -->
                    <buttons:GroupButton
                        Command="{Binding DogsViewCommand}"
                        GroupName="tes2"
                        Height="100"
                        VCheckedBackground="Transparent"
                        VCheckedImageOne="../Assets/DogIconSelected.png"
                        VCornerRadius="0"
                        VImageOneHeight="80"
                        VImageOneWidth="80"
                        VNormalBackground="Transparent"
                        VNormalImageOne="../Assets/DogIconUnselected.png"
                        VPointeroverBackgroundColor="Transparent"
                        Width="146" />

                    <!--  Tutor Tap  -->
                    <buttons:GroupButton
                        Command="{Binding TutorsViewCommand}"
                        GroupName="tes2"
                        Height="100"
                        VCheckedBackground="Transparent"
                        VCheckedImageOne="../Assets/TutorIconSelected.png"
                        VCornerRadius="0"
                        VImageOneHeight="80"
                        VImageOneWidth="80"
                        VNormalBackground="Transparent"
                        VNormalImageOne="../Assets/TutorIconUnselected.png"
                        VPointeroverBackgroundColor="Transparent"
                        Width="146" />

                    <!--  Home Tap  -->
                    <buttons:GroupButton
                        Command="{Binding HomeViewCommand}"
                        GroupName="tes2"
                        Height="100"
                        IsChecked="True"
                        VCheckedBackground="Transparent"
                        VCheckedImageOne="../Assets/HomeIconSelected.png"
                        VCornerRadius="0"
                        VImageOneHeight="80"
                        VImageOneWidth="80"
                        VNormalBackground="Transparent"
                        VNormalImageOne="../Assets/HomeIconUnselected.png"
                        VPointeroverBackgroundColor="Transparent"
                        Width="146" />

                    <!--  Services Tap  -->
                    <buttons:GroupButton
                        Command="{Binding ServicesViewCommand}"
                        GroupName="tes2"
                        Height="100"
                        VCheckedBackground="Transparent"
                        VCheckedImageOne="../Assets/ServiceIconSelected.png"
                        VCornerRadius="0"
                        VImageOneHeight="80"
                        VImageOneWidth="80"
                        VNormalBackground="Transparent"
                        VNormalImageOne="../Assets/ServiceIconUnselected.png"
                        VPointeroverBackgroundColor="Transparent"
                        Width="146" />

                    <!--  Users Tap  -->
                    <buttons:GroupButton
                        Command="{Binding UsersViewCommand}"
                        GroupName="tes2"
                        Height="100"
                        VCheckedBackground="Transparent"
                        VCheckedImageOne="../Assets/UserIconSelected.png"
                        VCornerRadius="0"
                        VImageOneHeight="80"
                        VImageOneWidth="80"
                        VNormalBackground="Transparent"
                        VNormalImageOne="../Assets/UserIconUnselected.png"
                        VPointeroverBackgroundColor="Transparent"
                        Width="146" />
                </StackPanel>
            </Border>
        </Grid>
    </Viewbox>

</UserControl>
