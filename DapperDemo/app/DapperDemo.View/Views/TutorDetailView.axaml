<UserControl
    d:DesignHeight="1560"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="Verion.Treinamento.DapperDemo.View.Views.TutorDetailView"
    x:DataType="viewmodels:TutorDetailViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:buttons="clr-namespace:Verion.Apresentacao.Avalonia.Buttons;assembly=Verion.Apresentacao.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:Verion.Treinamento.DapperDemo.Viewmodel.Viewmodels;assembly=Verion.Treinamento.DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Viewbox>
        <Grid Background="{StaticResource ColorBg}" Height="1560" Width="720">
            <ScrollViewer>
                <StackPanel Spacing="0">
                    <buttons:VButton
                        Classes="BtnGhost"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Left"
                        Margin="32,32,0,0"
                        VText="← Voltar"
                        Width="180" />

                    <StackPanel HorizontalAlignment="Center" Margin="32,32,32,24" Spacing="12">
                        <Border
                            BorderBrush="{StaticResource ColorDivider}"
                            BorderThickness="2"
                            CornerRadius="84"
                            Height="168"
                            HorizontalAlignment="Center"
                            Width="168">
                            <TextBlock
                                FontFamily="{StaticResource FontHeading}"
                                FontSize="59"
                                Foreground="{StaticResource ColorTextMuted70}"
                                HorizontalAlignment="Center"
                                Text="{Binding Initials}"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            Classes="Heading1"
                            FontSize="56"
                            HorizontalAlignment="Center"
                            Text="{Binding Name}" />
                        <TextBlock
                            Classes="Kicker"
                            HorizontalAlignment="Center"
                            Text="{Binding Neighborhood}" />
                    </StackPanel>

                    <StackPanel Margin="32,0,32,56" Spacing="28">
                        <Border BorderThickness="0,2,0,0" BorderBrush="{StaticResource ColorDivider}" Padding="0,20,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="Kicker" Text="Telefone" />
                                <TextBlock FontFamily="{StaticResource FontBody}" FontSize="26" Foreground="{StaticResource ColorText}" Text="{Binding Phone}" />
                            </StackPanel>
                        </Border>

                        <Border BorderThickness="0,2,0,0" BorderBrush="{StaticResource ColorDivider}" Padding="0,20,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="Kicker" Text="Cachorros" />
                                <TextBlock FontFamily="{StaticResource FontBody}" FontSize="26" Foreground="{StaticResource ColorText}" Text="{Binding DogNames}" />
                            </StackPanel>
                        </Border>

                        <Border BorderThickness="0,2,0,0" BorderBrush="{StaticResource ColorDivider}" Padding="0,20,0,0">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="Kicker" Text="Próximos serviços" />
                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="24"
                                    FontStyle="Italic"
                                    Foreground="{StaticResource ColorTextMuted45}"
                                    IsVisible="{Binding NoFuture}"
                                    Text="Nada agendado." />
                                <ItemsControl ItemsSource="{Binding FutureServices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="viewmodels:TutorFutureServiceRow">
                                            <Border BorderThickness="0,0,0,2" BorderBrush="{StaticResource ColorDivider}" Margin="0,0,0,12" Padding="0,0,0,12">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock FontFamily="{StaticResource FontBody}" FontSize="24" Foreground="{StaticResource ColorText}">
                                                        <Run Text="{Binding DogName}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding TypeLabel}" />
                                                    </TextBlock>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontFamily="{StaticResource FontBody}"
                                                        FontSize="22"
                                                        Foreground="{StaticResource ColorTextMuted55}"
                                                        Text="{Binding DateLabel}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Viewbox>
</UserControl>
