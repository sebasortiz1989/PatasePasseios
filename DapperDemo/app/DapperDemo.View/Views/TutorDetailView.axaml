<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.TutorDetailView"
    x:DataType="viewmodels:TutorDetailViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:buttons="using:AvaloniaFramework.Controls.Buttons"
    xmlns:components="using:DapperDemo.View.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Background="{StaticResource ColorBg}"
        Width="720">
        <ScrollViewer>
            <StackPanel Spacing="0">
                <buttons:VButton
                    Classes="BtnBack"
                    Command="{Binding BackCommand}"
                    Margin="32,32,0,0"
                    VText="← Voltar" />

                <StackPanel
                    HorizontalAlignment="Center"
                    Margin="32,32,32,24"
                    Spacing="12">
                    <Border
                        BorderBrush="{StaticResource ColorDivider}"
                        BorderThickness="2"
                        CornerRadius="84"
                        Height="168"
                        HorizontalAlignment="Center"
                        Width="168">
                        <TextBlock
                            FontFamily="{StaticResource FontHeading}"
                            FontSize="71"
                            Foreground="{StaticResource ColorTextMuted70}"
                            HorizontalAlignment="Center"
                            Text="{Binding Initials}"
                            VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        Classes="Heading1"
                        FontSize="67"
                        HorizontalAlignment="Center"
                        Text="{Binding Name}" />
                    <TextBlock
                        Classes="Kicker"
                        HorizontalAlignment="Center"
                        Text="{Binding Neighborhood}" />
                </StackPanel>

                <StackPanel Margin="32,0,32,56" Spacing="28">
                    <!--  Read view  -->
                    <StackPanel IsVisible="{Binding IsViewing}" Spacing="28">
                        <Border
                            BorderBrush="{StaticResource ColorDivider}"
                            BorderThickness="0,2,0,0"
                            Padding="0,20,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="Kicker" Text="Telefone" />
                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="31"
                                    Foreground="{StaticResource ColorText}"
                                    Text="{Binding Phone}" />
                            </StackPanel>
                        </Border>

                        <Border
                            BorderBrush="{StaticResource ColorDivider}"
                            BorderThickness="0,2,0,0"
                            Padding="0,20,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="Kicker" Text="Cachorros" />
                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="31"
                                    Foreground="{StaticResource ColorText}"
                                    Text="{Binding DogNames}" />
                            </StackPanel>
                        </Border>

                        <Border
                            BorderBrush="{StaticResource ColorDivider}"
                            BorderThickness="0,2,0,0"
                            Padding="0,20,0,0">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="Kicker" Text="Serviços em aberto" />
                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="29"
                                    FontStyle="Italic"
                                    Foreground="{StaticResource ColorTextMuted45}"
                                    IsVisible="{Binding NoPending}"
                                    Text="Nenhum serviço em aberto." />
                                <ItemsControl ItemsSource="{Binding PendingServices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="viewmodels:TutorFutureServiceRow">
                                            <Button Classes="RowButton" Command="{Binding OpenCommand}">
                                                <Border
                                                    BorderBrush="{StaticResource ColorDivider}"
                                                    BorderThickness="0,0,0,2"
                                                    Margin="0,0,0,12"
                                                    Padding="0,0,0,12">
                                                    <Grid ColumnDefinitions="*,Auto,14,Auto">
                                                        <TextBlock
                                                            FontFamily="{StaticResource FontBody}"
                                                            FontSize="29"
                                                            Foreground="{StaticResource ColorText}"
                                                            VerticalAlignment="Center">
                                                            <Run Text="{Binding DogName}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding TypeLabel}" />
                                                        </TextBlock>
                                                        <TextBlock
                                                            FontFamily="{StaticResource FontBody}"
                                                            FontSize="26"
                                                            Foreground="{StaticResource ColorTextMuted55}"
                                                            Grid.Column="1"
                                                            Text="{Binding DateLabel}"
                                                            VerticalAlignment="Center" />
                                                        <Border
                                                            Classes="TagSign"
                                                            Classes.Paid="{Binding Paid}"
                                                            Classes.Pending="{Binding !Paid}"
                                                            Grid.Column="3">
                                                            <TextBlock Text="{Binding PaidLabel}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!--  Money owed, and the button that settles it oldest-service-first.  -->
                        <Border
                            BorderBrush="{StaticResource ColorDivider}"
                            BorderThickness="0,2,0,0"
                            Padding="0,20,0,0">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="Kicker" Text="Em aberto" VerticalAlignment="Center" />
                                    <TextBlock
                                        FontFamily="{StaticResource FontHeading}"
                                        FontSize="41"
                                        Foreground="{StaticResource ColorAccentDark700}"
                                        Grid.Column="1"
                                        Text="{Binding TotalDueLabel}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasCredit}">
                                    <TextBlock
                                        Classes="Kicker"
                                        Text="Crédito do tutor"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontFamily="{StaticResource FontHeading}"
                                        FontSize="35"
                                        Foreground="{StaticResource ColorAccent}"
                                        Grid.Column="1"
                                        Text="{Binding CreditLabel}" />
                                </Grid>
                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="23"
                                    FontStyle="Italic"
                                    Foreground="{StaticResource ColorTextMuted45}"
                                    IsVisible="{Binding HasCredit}"
                                    Text="Será usado automaticamente no próximo serviço agendado."
                                    TextWrapping="Wrap" />

                                <buttons:VButton
                                    Classes="BtnPrimary"
                                    Command="{Binding OpenPaymentCommand}"
                                    Height="80"
                                    HorizontalAlignment="Stretch"
                                    IsVisible="{Binding !IsRegisteringPayment}"
                                    VText="Registrar pagamento" />

                                <StackPanel IsVisible="{Binding IsRegisteringPayment}" Spacing="12">
                                    <TextBlock Classes="FormLabel" Text="Valor recebido (R$)" />
                                    <TextBox Classes="FormInput" Text="{Binding PaymentAmount}" />
                                    <TextBlock
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="26"
                                        FontStyle="Italic"
                                        Foreground="{StaticResource ColorTextMuted70}"
                                        IsVisible="{Binding HasPaymentPreview}"
                                        Text="{Binding PaymentPreview}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Classes="FormMsg Error"
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="26"
                                        FontStyle="Italic"
                                        IsVisible="{Binding HasPaymentError}"
                                        Text="{Binding PaymentError}"
                                        TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,16,*">
                                        <buttons:VButton
                                            Classes="BtnSecondary"
                                            Command="{Binding CancelPaymentCommand}"
                                            Height="80"
                                            VText="Cancelar" />
                                        <buttons:VButton
                                            Classes="BtnPrimary"
                                            Command="{Binding ConfirmPaymentCommand}"
                                            Grid.Column="2"
                                            Height="80"
                                            VText="Confirmar" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock
                                    Classes="FormMsg"
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="26"
                                    FontStyle="Italic"
                                    IsVisible="{Binding HasPaymentMsg}"
                                    Text="{Binding PaymentMsg}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <buttons:VButton
                            Classes="BtnPrimary"
                            Command="{Binding EditCommand}"
                            Height="80"
                            HorizontalAlignment="Stretch"
                            Margin="0,16,0,0"
                            VText="Editar tutor" />

                        <!--  Destructive, so it asks first — see the ConfirmDialog at the end of this file.  -->
                        <buttons:VButton
                            Classes="BtnSecondary"
                            Command="{Binding AskDeleteCommand}"
                            Height="80"
                            HorizontalAlignment="Stretch"
                            VText="Excluir tutor" />
                    </StackPanel>

                    <!--  Editor. The dogs list is not here: a dog is moved from its own screen.  -->
                    <StackPanel IsVisible="{Binding IsEditing}" Spacing="28">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="FormLabel" Text="Nome" />
                            <TextBox Classes="FormInput" Text="{Binding EditName}" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Classes="FormLabel" Text="Telefone" />
                            <TextBox Classes="FormInput" Text="{Binding EditPhone}" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Classes="FormLabel" Text="Endereço" />
                            <TextBox Classes="FormInput" Text="{Binding EditAddress}" />
                        </StackPanel>

                        <TextBlock
                            Classes="FormMsg Error"
                            FontFamily="{StaticResource FontBody}"
                            FontSize="28"
                            FontStyle="Italic"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding HasEditError}"
                            Text="{Binding EditError}"
                            TextAlignment="Center" />

                        <Grid ColumnDefinitions="*,16,*">
                            <buttons:VButton
                                Classes="BtnSecondary"
                                Command="{Binding CancelEditCommand}"
                                Height="88"
                                VText="Cancelar" />
                            <buttons:VButton
                                Classes="BtnPrimary"
                                Command="{Binding SaveEditCommand}"
                                Grid.Column="2"
                                Height="88"
                                VText="Salvar" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Last child of the Grid, so the scrim covers the screen underneath it.  -->
        <components:ConfirmDialog
            CancelCommand="{Binding CancelDeleteCommand}"
            ConfirmCommand="{Binding ConfirmDeleteCommand}"
            IsOpen="{Binding ConfirmingDelete}"
            Message="O tutor, seus cachorros e todos os serviços deles serão excluídos para sempre. Esta ação não pode ser desfeita."
            Title="Excluir tutor?" />
    </Grid>
</UserControl>