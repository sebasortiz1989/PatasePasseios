<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.TabViews.UsersView"
    x:DataType="tabViewsViewmodels:UsersViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:components="using:DapperDemo.View.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:imaging="using:DapperDemo.View.Imaging"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tabViewsViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.TabViewsViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:utils="clr-namespace:DapperDemo.Viewmodel.Viewmodels.Utils;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!--  One dog's share of the month, with its kinds beneath it.  -->
        <DataTemplate DataType="utils:DogSummaryRow" x:Key="DogSummaryTemplate">
            <StackPanel>
                <Border Classes="RowRule" />
                <StackPanel Margin="28,21" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="TBody" Text="{Binding DogName}" />
                        <TextBlock
                            Classes="TBody Muted"
                            Grid.Column="1"
                            Text="{Binding TotalLabel}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="utils:DogSummaryLine">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="TCaption" Text="{Binding TypeLabel}" />
                                        <TextBlock Classes="TCaption" Text=" · " />
                                        <TextBlock Classes="TCaption" Text="{Binding CountLabel}" />
                                    </StackPanel>
                                    <TextBlock
                                        Classes="TCaption"
                                        Grid.Column="1"
                                        Text="{Binding AmountLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="utils:IncomeRow" x:Key="IncomeRowTemplate">
            <StackPanel>
                <Border Classes="RowRule" />
                <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                    <TextBlock Classes="TBody" Text="{Binding Label}" />
                    <TextBlock
                        Classes="TBody Muted"
                        Grid.Column="1"
                        Text="{Binding Amount}" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfacePrimary}">
        <ScrollViewer>
            <StackPanel>

                <!--  Identity: the sitter, then the two facts that belong to the name.  -->
                <StackPanel
                    IsVisible="{Binding IsViewingProfile}"
                    Margin="35,14,35,0"
                    Spacing="14">
                    <Panel
                        Height="168"
                        HorizontalAlignment="Left"
                        Width="168">
                        <Image
                            imaging:ImageLoader.Path="{Binding PhotoPath}"
                            IsVisible="{Binding HasPhoto}"
                            Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry Rect="0,0,168,168" />
                            </Image.Clip>
                        </Image>
                        <Border
                            Background="{DynamicResource SurfaceControl}"
                            CornerRadius="84"
                            IsVisible="{Binding NoPhoto}">
                            <TextBlock
                                Classes="TTitle"
                                HorizontalAlignment="Center"
                                Text="{Binding Initials}"
                                VerticalAlignment="Center" />
                        </Border>
                    </Panel>

                    <StackPanel Spacing="4">
                        <TextBlock
                            Classes="TTitle"
                            Text="{Binding CurrentUserName}"
                            TextWrapping="Wrap" />
                        <TextBlock Classes="TCaption" Text="{Binding Email}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="TCaption" Text="Nascimento " />
                            <TextBlock Classes="TCaption" Text="{Binding BirthDateLabel}" />
                            <TextBlock Classes="TCaption" Text="  ·  Pix " />
                            <TextBlock Classes="TCaption" Text="{Binding PixLabel}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsViewingProfile}">
                    <!--  The month, and what it came to. The one heaviest figure in the app.  -->
                    <TextBlock
                        Classes="TMicro"
                        Margin="35,42,35,14"
                        Text="FATURAMENTO" />

                    <Border Classes="ControlRing" Margin="30,0,30,21">
                        <Border Classes="FloatingControl">
                            <Grid ColumnDefinitions="Auto,*,Auto" Height="77">
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding PreviousPeriodCommand}"
                                    Grid.Column="0"
                                    Margin="18,0,0,0"
                                    Width="77">
                                    <Path
                                        Data="{StaticResource IconChevronLeft}"
                                        Height="35"
                                        Stretch="Uniform"
                                        Stroke="{DynamicResource InkPrimary}"
                                        StrokeJoin="Round"
                                        StrokeLineCap="Round"
                                        StrokeThickness="2.4"
                                        Width="35" />
                                </Button>
                                <!--  The label is the way back to "Ano todo" once the arrows have moved off it.  -->
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ToggleWholeYearCommand}"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center">
                                    <TextBlock Classes="TBody" Text="{Binding PeriodLabel}" />
                                </Button>
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding NextPeriodCommand}"
                                    Grid.Column="2"
                                    Margin="0,0,18,0"
                                    Width="77">
                                    <Path
                                        Data="{StaticResource IconChevronRight}"
                                        Height="35"
                                        Stretch="Uniform"
                                        Stroke="{DynamicResource InkPrimary}"
                                        StrokeJoin="Round"
                                        StrokeLineCap="Round"
                                        StrokeThickness="2.4"
                                        Width="35" />
                                </Button>
                            </Grid>
                        </Border>
                    </Border>

                    <Border Classes="Group">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="TCaption" Text="{Binding ReceivedHeading}" />
                                    <TextBlock
                                        Classes="TTitle"
                                        Foreground="{DynamicResource AccentDeep}"
                                        Text="{Binding MonthTotalLabel}" />
                                </StackPanel>
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ToggleMoneyVisibleCommand}"
                                    Grid.Column="1"
                                    Height="77"
                                    VerticalAlignment="Center"
                                    Width="77">
                                    <Panel>
                                        <Path
                                            Data="{StaticResource IconEyeOpen}"
                                            Height="42"
                                            IsVisible="{Binding MoneyVisible}"
                                            Stretch="Uniform"
                                            Stroke="{DynamicResource InkPrimary}"
                                            StrokeJoin="Round"
                                            StrokeLineCap="Round"
                                            StrokeThickness="1.6"
                                            Width="42" />
                                        <Path
                                            Data="{StaticResource IconEyeClosed}"
                                            Height="42"
                                            IsVisible="{Binding MoneyHidden}"
                                            Stretch="Uniform"
                                            Stroke="{DynamicResource InkPrimary}"
                                            StrokeJoin="Round"
                                            StrokeLineCap="Round"
                                            StrokeThickness="1.6"
                                            Width="42" />
                                    </Panel>
                                </Button>
                            </Grid>

                            <ItemsControl ItemTemplate="{StaticResource IncomeRowTemplate}" ItemsSource="{Binding IncomeBreakdown}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--  Per dog: what was received, then what is still owed.  -->
                    <StackPanel IsVisible="{Binding ShowMonthDetail}">
                        <TextBlock
                            Classes="TMicro"
                            Margin="35,42,35,14"
                            Text="POR CACHORRO" />
                        <TextBlock
                            Classes="TUi Muted"
                            IsVisible="{Binding HasNothingPaidInMonth}"
                            Margin="35,0,35,14"
                            Text="{Binding NoPaidLabel}"
                            TextWrapping="Wrap" />
                        <Border Classes="Group" IsVisible="{Binding !HasNothingPaidInMonth}">
                            <ItemsControl
                                Classes="RowGroup"
                                ItemTemplate="{StaticResource DogSummaryTemplate}"
                                ItemsSource="{Binding PaidSummaries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto" Margin="35,42,35,14">
                            <TextBlock
                                Classes="TMicro"
                                Text="{Binding PendingHeading}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Classes="TMicro"
                                Grid.Column="1"
                                Text="{Binding PendingTotalLabel}" />
                        </Grid>
                        <TextBlock
                            Classes="TUi Muted"
                            IsVisible="{Binding HasNothingPendingInMonth}"
                            Margin="35,0,35,14"
                            Text="{Binding NoPendingLabel}"
                            TextWrapping="Wrap" />
                        <Border Classes="Group" IsVisible="{Binding !HasNothingPendingInMonth}">
                            <ItemsControl
                                Classes="RowGroup"
                                ItemTemplate="{StaticResource DogSummaryTemplate}"
                                ItemsSource="{Binding PendingSummaries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Classes="TMicro"
                        Margin="35,42,35,14"
                        Text="RESUMO" />
                    <Border Classes="Group">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                                <TextBlock Classes="TBody" Text="Cachorros" />
                                <TextBlock
                                    Classes="TBody Muted"
                                    Grid.Column="1"
                                    Text="{Binding DogCountLabel}" />
                            </Grid>
                            <Border Classes="RowRule" />
                            <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                                <TextBlock Classes="TBody" Text="Tutores" />
                                <TextBlock
                                    Classes="TBody Muted"
                                    Grid.Column="1"
                                    Text="{Binding TutorCountLabel}" />
                            </Grid>
                            <Border Classes="RowRule" />
                            <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                                <TextBlock Classes="TBody" Text="{Binding ServiceCountKicker}" />
                                <TextBlock
                                    Classes="TBody Muted"
                                    Grid.Column="1"
                                    Text="{Binding ServiceCountLabel}" />
                            </Grid>
                            <Border Classes="RowRule" />
                            <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                                <TextBlock Classes="TBody" Text="Pendentes" />
                                <TextBlock
                                    Classes="TBody Owed"
                                    Grid.Column="1"
                                    Text="{Binding PendingCountLabel}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="ControlRing" Margin="30,28,30,0">
                        <Border Classes="FloatingControl">
                            <Button Classes="Submit" Command="{Binding ExportSummaryCommand}">
                                <TextBlock Classes="TBody" Text="Exportar resumo do mês (PNG)" />
                            </Button>
                        </Border>
                    </Border>
                    <TextBlock
                        Classes="TCaption"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding HasSummaryMsg}"
                        Margin="35,14,35,0"
                        Text="{Binding SummaryMsg}"
                        TextWrapping="Wrap" />

                    <!--  One .zip carries the database and the dog photos; a bare .db loses every picture.  -->
                    <TextBlock
                        Classes="TMicro"
                        Margin="35,42,35,14"
                        Text="BACKUP" />
                    <Border Classes="Group">
                        <StackPanel>
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ExportBackupCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0">
                                <TextBlock
                                    Classes="TBody"
                                    Margin="28,21"
                                    Text="Exportar backup" />
                            </Button>
                            <Border Classes="RowRule" />
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ImportBackupCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0">
                                <StackPanel Margin="28,21" Spacing="7">
                                    <TextBlock Classes="TBody" Text="Importar backup" />
                                    <TextBlock Classes="TCaption" Text="Substitui tudo neste aparelho e pede um novo login." />
                                </StackPanel>
                            </Button>
                            <Border Classes="RowRule" />
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding SendCloudBackupCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0">
                                <StackPanel Margin="28,21" Spacing="7">
                                    <TextBlock Classes="TBody" Text="Enviar backup agora" />
                                    <TextBlock
                                        Classes="TCaption"
                                        Text="{Binding CloudBackupLabel}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Classes="TCaption"
                        Classes.Owed="{Binding BackupMsgIsError}"
                        IsVisible="{Binding HasBackupMsg}"
                        Margin="35,14,35,0"
                        Text="{Binding BackupMsg}"
                        TextWrapping="Wrap" />

                    <!--  Ajustes is the last row before signing out; the account rows sit above it.  -->
                    <TextBlock
                        Classes="TMicro"
                        Margin="35,42,35,14"
                        Text="CONTA" />
                    <Border Classes="Group">
                        <StackPanel>
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding EditProfileCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0">
                                <TextBlock
                                    Classes="TBody"
                                    Margin="28,21"
                                    Text="Editar perfil" />
                            </Button>
                            <Border Classes="RowRule" />
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding OpenPasswordFormCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                IsVisible="{Binding ShowPasswordSummary}"
                                Padding="0">
                                <TextBlock
                                    Classes="TBody"
                                    Margin="28,21"
                                    Text="Alterar senha" />
                            </Button>

                            <StackPanel
                                IsVisible="{Binding ShowPasswordForm}"
                                Margin="28,21"
                                Spacing="14">
                                <TextBlock Classes="TCaption" Text="Senha atual" />
                                <TextBox
                                    Classes="Field"
                                    PasswordChar="•"
                                    Text="{Binding CurrentPw}" />
                                <TextBlock Classes="TCaption" Text="Nova senha" />
                                <TextBox
                                    Classes="Field"
                                    PasswordChar="•"
                                    Text="{Binding NewPw}" />
                                <TextBlock Classes="TCaption" Text="Confirmar nova senha" />
                                <TextBox
                                    Classes="Field"
                                    PasswordChar="•"
                                    Text="{Binding ConfirmPw}" />
                                <TextBlock
                                    Classes="TCaption"
                                    Classes.Owed="{Binding PwMsgIsError}"
                                    IsVisible="{Binding HasPwMsg}"
                                    Text="{Binding PwMsg}"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="28">
                                    <Button
                                        Classes="TextLink"
                                        Command="{Binding SavePasswordCommand}"
                                        Content="Salvar" />
                                    <Button
                                        Classes="TextLink"
                                        Command="{Binding CancelPasswordFormCommand}"
                                        Content="Cancelar" />
                                </StackPanel>
                            </StackPanel>

                            <Border Classes="RowRule" />
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding OpenSettingsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0">
                                <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                                    <TextBlock
                                        Classes="TBody"
                                        Text="Ajustes"
                                        VerticalAlignment="Center" />
                                    <Path
                                        Data="{StaticResource IconChevronRight}"
                                        Grid.Column="1"
                                        Height="30"
                                        Stretch="Uniform"
                                        Stroke="{DynamicResource InkSecondary}"
                                        StrokeJoin="Round"
                                        StrokeLineCap="Round"
                                        StrokeThickness="2.4"
                                        VerticalAlignment="Center"
                                        Width="30" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!--  Signing out destroys nothing, so it is a line rather than a heavy control.  -->
                    <Button
                        Classes="TextLink"
                        Command="{Binding LogoutCommand}"
                        Content="Sair da conta"
                        HorizontalAlignment="Center"
                        Margin="0,42,0,0" />

                    <TextBlock
                        Classes="TCaption"
                        HorizontalAlignment="Center"
                        Margin="0,21,0,0"
                        Text="{Binding VersionLabel}" />
                </StackPanel>

                <!--  Editing the profile  -->
                <StackPanel IsVisible="{Binding IsEditingProfile}">
                    <TextBlock
                        Classes="TTitle"
                        Margin="35,14,35,0"
                        Text="Editar perfil" />
                    <TextBlock
                        Classes="TMicro"
                        Margin="35,42,35,14"
                        Text="DADOS" />
                    <Border Classes="Group">
                        <StackPanel>
                            <StackPanel Margin="28,21" Spacing="7">
                                <TextBlock Classes="TCaption" Text="Nome" />
                                <TextBox Classes="Field" Text="{Binding EditName}" />
                            </StackPanel>
                            <Border Classes="RowRule" />
                            <StackPanel Margin="28,21" Spacing="7">
                                <TextBlock Classes="TCaption" Text="Chave Pix" />
                                <TextBox Classes="Field" Text="{Binding EditPix}" />
                            </StackPanel>
                            <Border Classes="RowRule" />
                            <StackPanel Margin="28,21" Spacing="7">
                                <TextBlock Classes="TCaption" Text="Data de nascimento" />
                                <CalendarDatePicker Classes="Field" SelectedDate="{Binding EditBirthDate}" />
                            </StackPanel>
                            <Border Classes="RowRule" />
                            <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                                <StackPanel Spacing="7" VerticalAlignment="Center">
                                    <TextBlock Classes="TBody" Text="Foto" />
                                    <Button
                                        Classes="TextLink"
                                        Command="{Binding RemovePhotoCommand}"
                                        Content="Remover"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding HasPhoto}" />
                                </StackPanel>
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ChoosePhotoCommand}"
                                    Grid.Column="1"
                                    Padding="0">
                                    <Border
                                        BorderBrush="{DynamicResource StrokeRaised}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Height="70"
                                        Width="70">
                                        <Image
                                            imaging:ImageLoader.DecodeWidth="192"
                                            imaging:ImageLoader.Path="{Binding PhotoPath}"
                                            IsVisible="{Binding HasPhoto}"
                                            Stretch="UniformToFill" />
                                    </Border>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Classes="TCaption"
                        IsVisible="{Binding HasProfileMsg}"
                        Margin="35,14,35,0"
                        Text="{Binding ProfileMsg}"
                        TextWrapping="Wrap" />

                    <Border Classes="ControlRing" Margin="30,28,30,0">
                        <Border Classes="FloatingControl">
                            <Button Classes="Submit" Command="{Binding SaveProfileCommand}">
                                <TextBlock Classes="TBody" Text="Salvar" />
                            </Button>
                        </Border>
                    </Border>

                    <Button
                        Classes="TextLink"
                        Command="{Binding CancelProfileCommand}"
                        Content="Cancelar"
                        HorizontalAlignment="Center"
                        Margin="0,28,0,0" />
                </StackPanel>

                <!--  Clearance for the floating tab bar, which content scrolls under.  -->
                <Border Height="168" />
            </StackPanel>
        </ScrollViewer>

        <components:ConfirmDialog
            ConfirmCommand="{Binding DismissInvalidBackupCommand}"
            ConfirmText="Entendi"
            IsOpen="{Binding ShowInvalidBackupAlert}"
            Message="{Binding InvalidBackupMessage}"
            ShowCancel="False"
            Title="{Binding InvalidBackupTitle}" />

        <components:ConfirmDialog
            CancelCommand="{Binding ReplaceRequest.CancelCommand}"
            ConfirmCommand="{Binding ReplaceRequest.ConfirmCommand}"
            IsOpen="{Binding ReplaceRequest.IsOpen}"
            Message="{Binding ReplaceRequest.Message}"
            Title="Substituir arquivo?" />
    </Grid>
</UserControl>
