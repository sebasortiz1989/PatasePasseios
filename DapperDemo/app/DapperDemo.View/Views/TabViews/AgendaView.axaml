<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.TabViews.AgendaView"
    x:DataType="tabViewsViewmodels:AgendaViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tabViewsViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.TabViewsViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:utils="clr-namespace:DapperDemo.Viewmodel.Viewmodels.Utils;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!--
            One service, inside its dog's group. Two lines and nothing else: what the booking is
            and when, then what it costs and where it stands. The dog is the group header, so it is
            not repeated here, and neither is the tutor — a dog names its tutor.
        -->
        <DataTemplate DataType="utils:ServiceRow" x:Key="ServiceRowTemplate">
            <Button
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding OpenCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="0">
                <StackPanel Margin="28,21" Spacing="7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="TBody" Text="{Binding TypeLabel}" />
                        <TextBlock Classes="TBody Muted" Text=" · " />
                        <TextBlock Classes="TBody Muted" Text="{Binding DayNum}" />
                        <TextBlock Classes="TBody Muted" Text=" " />
                        <TextBlock Classes="TBody Muted" Text="{Binding MonthShort}" />
                        <TextBlock Classes="TBody Muted" Text=", " />
                        <TextBlock Classes="TBody Muted" Text="{Binding TimeLabel}" />
                    </StackPanel>

                    <!--
                        Money, then execution, then payment — the order the charging rule reads in.
                        Only "Sem pagar" takes colour: it is the one fact the sitter opens the app
                        for, and colouring the others would flatten it back into decoration.
                    -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="TCaption" Text="{Binding PriceLabel}" />
                        <TextBlock Classes="TCaption" Text=" · " />
                        <TextBlock Classes="TCaption" Text="{Binding DoneLabel}" />
                        <TextBlock Classes="TCaption" Text=" · " />
                        <TextBlock
                            Classes="TCaption"
                            Classes.Owed="{Binding !Paid}"
                            Text="{Binding PaidLabel}" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!--
            One dog. The header states the count and the money so a collapsed group still says what
            it holds; the chevron is the only thing that changes when it opens.
        -->
        <DataTemplate DataType="utils:DogServiceGroup" x:Key="DogGroupTemplate">
            <Border Classes="Group" Margin="35,0,35,35">
                <StackPanel>
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ToggleCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0">
                        <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="TBody" Text="{Binding DogName}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="TCaption" Text="{Binding CountLabel}" />
                                    <TextBlock Classes="TCaption" Text=" · " />
                                    <TextBlock Classes="TCaption" Text="{Binding TotalLabel}" />
                                </StackPanel>
                            </StackPanel>
                            <Path
                                Data="{StaticResource IconChevronDown}"
                                Grid.Column="1"
                                Height="30"
                                IsVisible="{Binding IsExpanded}"
                                Stretch="Uniform"
                                Stroke="{DynamicResource InkSecondary}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="2.4"
                                VerticalAlignment="Center"
                                Width="30" />
                            <Path
                                Data="{StaticResource IconChevronRight}"
                                Grid.Column="1"
                                Height="30"
                                IsVisible="{Binding !IsExpanded}"
                                Stretch="Uniform"
                                Stroke="{DynamicResource InkSecondary}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="2.4"
                                VerticalAlignment="Center"
                                Width="30" />
                        </Grid>
                    </Button>

                    <Border Classes="RowRule" IsVisible="{Binding IsExpanded}" />

                    <ItemsControl
                        IsVisible="{Binding IsExpanded}"
                        ItemTemplate="{StaticResource ServiceRowTemplate}"
                        ItemsSource="{Binding Services}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        No DesignCanvas here: this screen is shown through CurrentView inside MainView, which
        carries the only canvas on the way down. Height is left to stretch.
    -->
    <Grid Background="{DynamicResource SurfacePrimary}" RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0">
            <StackPanel Margin="35,21,35,0" Spacing="8">
                <TextBlock Classes="TTitle" Text="Agenda" />
                <TextBlock Classes="TCaption" Text="{Binding TodayLabel}" />
            </StackPanel>

            <!--
                The date range. A segmented group rather than three loose chips: the three are one
                mutually exclusive question, and sharing a surface says so.
            -->
            <Border Classes="Group" Margin="35,35,35,0">
                <Grid ColumnDefinitions="*,Auto,*,Auto,*" Height="77">
                    <Button
                        Classes="SegOption"
                        Classes.Active="{Binding IsRangeHoje}"
                        Command="{Binding SetRangeHoje}"
                        Content="Hoje"
                        CornerRadius="21,0,0,21" />
                    <Border Classes="SegRule" Grid.Column="1" />
                    <Button
                        Classes="SegOption"
                        Classes.Active="{Binding IsRangeSemana}"
                        Command="{Binding SetRangeSemana}"
                        Content="Semana"
                        Grid.Column="2" />
                    <Border Classes="SegRule" Grid.Column="3" />
                    <Button
                        Classes="SegOption"
                        Classes.Active="{Binding IsRangeData}"
                        Command="{Binding SetRangeData}"
                        Content="Data"
                        CornerRadius="0,21,21,0"
                        Grid.Column="4" />
                </Grid>
            </Border>

        <!--
            The period. A stepped control rather than two drop-downs: a popup lays out in its own
            visual root and ignores the design canvas' scale, so at phone size its list came out
            far wider than the field that opened it.
        -->
            <Border
                Classes="ControlRing"
                IsVisible="{Binding ShowDatePicker}"
                Margin="30,21,30,0">
            <Border Classes="FloatingControl" Height="77">
                <Grid ColumnDefinitions="Auto,*,Auto" Height="77">
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding PreviousPeriodCommand}"
                        Grid.Column="0"
                        Margin="18,0,0,0"
                        Padding="0"
                        Width="77">
                        <Viewbox
                            Height="35"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="35">
                            <Path
                                Data="{StaticResource IconChevronLeft}"
                                Stretch="Uniform"
                                Stroke="{DynamicResource InkPrimary}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="1" />
                        </Viewbox>
                    </Button>
                    <!--  The label is the way back to "Ano todo" once the arrows have moved off it.  -->
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ToggleWholeYearCommand}"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center">
                        <TextBlock Classes="TBody" Text="{Binding PeriodLabel}" />
                    </Button>
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding NextPeriodCommand}"
                        Grid.Column="2"
                        Margin="0,0,18,0"
                        Padding="0"
                        Width="77">
                        <Viewbox
                            Height="35"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="35">
                            <Path
                                Data="{StaticResource IconChevronRight}"
                                Stretch="Uniform"
                                Stroke="{DynamicResource InkPrimary}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="1" />
                        </Viewbox>
                    </Button>
                </Grid>
                </Border>
            </Border>

            <!--
                Service kinds. Chips in a WrapPanel rather than a fourth and fifth segment: five
                cells across the measure leaves "Pet sitting" no room, and the row is allowed to
                break where a segmented group cannot.
            -->
            <WrapPanel Margin="35,35,35,0">
                <Button
                    Classes="Chip"
                    Classes.Active="{Binding IsTypeTodos}"
                    Command="{Binding SetTypeTodos}"
                    Content="Tudo"
                    Margin="0,0,16,14" />
                <Button
                    Classes="Chip"
                    Classes.Active="{Binding IsTypeWalk}"
                    Command="{Binding SetTypeWalk}"
                    Content="Passeio"
                    Margin="0,0,16,14" />
                <Button
                    Classes="Chip"
                    Classes.Active="{Binding IsTypeSitting}"
                    Command="{Binding SetTypeSitting}"
                    Content="Pet sitting"
                    Margin="0,0,16,14" />
                <Button
                    Classes="Chip"
                    Classes.Active="{Binding IsTypeHotel}"
                    Command="{Binding SetTypeHotel}"
                    Content="Hotel"
                    Margin="0,0,16,14" />
                <Button
                    Classes="Chip"
                    Classes.Active="{Binding IsTypeDayCare}"
                    Command="{Binding SetTypeDayCare}"
                    Content="Day Care"
                    Margin="0,0,16,14" />
            </WrapPanel>

            <!--
                A row in a group with a switch, not a loose checkbox. Every other boolean in the
                refresh reads this way, and the old square was the last control on the screen still
                drawing its own box on the page.
            -->
            <Border Classes="Group" Margin="35,21,35,0">
                <Grid ColumnDefinitions="*,Auto" Margin="28,18">
                    <TextBlock
                        Classes="TUi"
                        Text="Mostrar serviços já feitos"
                        VerticalAlignment="Center" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsChecked="{Binding HomeShowPaid}"
                        OffContent=""
                        OnContent=""
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>

        <!--  One sentence at the text margin. No illustration, no button.  -->
        <TextBlock
            Classes="TUi Muted"
            Grid.Row="1"
            IsVisible="{Binding HasNoServices}"
            Margin="35,42,35,0"
            Text="Nenhum serviço neste filtro."
            TextWrapping="Wrap"
            VerticalAlignment="Top" />

        <!--
            The list is the scroll host, the same way the dogs and tutors groups are: its viewport
            is bounded by the star row, so the panel realizes only the dog groups on screen. Wrapped
            in a StackPanel — which is what this was — the height is unbounded, every group is
            realized on every refresh, and the panel below cannot virtualize whatever it is told to.

            The empty-state line moved out for the same reason: it and the trailing spacer made the
            ItemsControl one child of three, so it could not be the ScrollViewer's content. The
            spacer became the ScrollViewer's own bottom padding, which is what lets the last group
            clear the floating tab bar.
        -->
        <ScrollViewer
            Grid.Row="1"
            Margin="0,42,0,0"
            Padding="0,0,0,168"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemTemplate="{StaticResource DogGroupTemplate}" ItemsSource="{Binding DogGroups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
