<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.TabViews.AgendaView"
    x:DataType="tabViewsViewmodels:AgendaViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tabViewsViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.TabViewsViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:utils="clr-namespace:DapperDemo.Viewmodel.Viewmodels.Utils;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!--
            One agenda row, shared by the flat list and by the rows inside an expanded dog. Defined
            once so a grouped row cannot drift from a flat one — same tags, same commands, same
            tap-through to the service screen.
        -->
        <DataTemplate x:Key="ServiceRowTemplate" DataType="utils:ServiceRow">
            <Button Classes="RowButton" Command="{Binding OpenCommand}">
                <Border
                    BorderBrush="{StaticResource ColorDivider}"
                    BorderThickness="0,2,0,0"
                    Padding="0,24">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <Border
                            BorderBrush="{StaticResource ColorDivider}"
                            BorderThickness="0,0,2,0"
                            Padding="0,0,16,0"
                            Width="91">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="{StaticResource FontHeading}"
                                    FontSize="46"
                                    Foreground="{StaticResource ColorText}"
                                    HorizontalAlignment="Center"
                                    Text="{Binding DayNum}" />
                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="20"
                                    Foreground="{StaticResource ColorTextMuted50}"
                                    HorizontalAlignment="Center"
                                    LetterSpacing="1"
                                    Text="{Binding MonthShort}" />
                            </StackPanel>
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="24,0,16,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontFamily="{StaticResource FontHeading}"
                                FontSize="37"
                                FontWeight="Medium"
                                Foreground="{StaticResource ColorText}"
                                Text="{Binding DogName}" />
                            <TextBlock
                                FontFamily="{StaticResource FontBody}"
                                FontSize="25"
                                Foreground="{StaticResource ColorTextMuted55}">
                                <Run Text="{Binding TypeLabel}" />
                                <Run Text=" · " />
                                <Run Text="{Binding TimeLabel}" />
                                <Run Text=" · " />
                                <Run Text="{Binding PriceLabel}" />
                            </TextBlock>
                        </StackPanel>
                        <!--  Two independent states, stacked so a narrow row still fits both.  -->
                        <StackPanel
                            Grid.Column="2"
                            Spacing="6"
                            VerticalAlignment="Center">
                            <!--  Closed off until the work is done: only executed work can be charged for.  -->
                            <Border
                                Classes="TagSign"
                                Classes.Paid="{Binding Paid}"
                                Classes.Pending="{Binding !Paid}">
                                <TextBlock Text="{Binding PaidLabel}" />
                            </Border>
                            <Button
                                Classes="Tag"
                                Classes.Done="{Binding Done}"
                                Classes.Todo="{Binding !Done}"
                                Command="{Binding ToggleDoneCommand}"
                                Content="{Binding DoneLabel}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource ColorBg}" Width="720">
        <ScrollViewer>
            <StackPanel Spacing="0">
                <StackPanel Margin="32,32,32,16" Spacing="2">
                    <TextBlock
                        Classes="Heading1"
                        FontSize="62"
                        Text="Agenda" />
                    <TextBlock Classes="Kicker" Text="{Binding TodayLabel}" />
                </StackPanel>

                <!--  Date range filters  -->
                <StackPanel
                    Margin="32,16,32,0"
                    Orientation="Horizontal"
                    Spacing="16">
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsRangeHoje}"
                        Command="{Binding SetRangeHoje}"
                        Content="Hoje" />
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsRangeSemana}"
                        Command="{Binding SetRangeSemana}"
                        Content="Semana" />
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsRangeData}"
                        Command="{Binding SetRangeData}"
                        Content="Data" />
                </StackPanel>

                <!--
                    Revealed by the Data chip: the month and year the list is scoped to. The month
                    list carries an "Ano todo" entry, so this one control covers a single month and
                    a whole year without needing a chip for each.
                -->
                <Grid
                    ColumnDefinitions="*,16,Auto"
                    IsVisible="{Binding ShowDatePicker}"
                    Margin="32,16,32,0">
                    <ComboBox
                        Classes="FormInput"
                        ItemsSource="{Binding MonthOptions}"
                        SelectedItem="{Binding SelectedMonth}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="utils:MonthOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox
                        Classes="FormInput"
                        Grid.Column="2"
                        ItemsSource="{Binding YearOptions}"
                        MinWidth="180"
                        SelectedItem="{Binding SelectedYear}" />
                </Grid>

                <!--
                    Service type filters. A WrapPanel rather than a horizontal StackPanel: five
                    chips no longer fit across the 720 canvas, so the row is allowed to break.
                    Spacing comes from each chip's margin, which WrapPanel honours.
                -->
                <WrapPanel Margin="32,16,32,0">
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsTypeTodos}"
                        Command="{Binding SetTypeTodos}"
                        Content="Tudo"
                        Margin="0,0,16,12" />
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsTypeWalk}"
                        Command="{Binding SetTypeWalk}"
                        Content="Passeio"
                        Margin="0,0,16,12" />
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsTypeSitting}"
                        Command="{Binding SetTypeSitting}"
                        Content="Pet sitting"
                        Margin="0,0,16,12" />
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsTypeHotel}"
                        Command="{Binding SetTypeHotel}"
                        Content="Hotel"
                        Margin="0,0,16,12" />
                    <Button
                        Classes="Chip"
                        Classes.Active="{Binding IsTypeDayCare}"
                        Command="{Binding SetTypeDayCare}"
                        Content="Day-Care"
                        Margin="0,0,16,12" />
                </WrapPanel>

                <CheckBox
                    Content="Mostrar serviços já pagos"
                    FontFamily="{StaticResource FontBody}"
                    FontSize="28"
                    Foreground="{StaticResource ColorTextMuted65}"
                    IsChecked="{Binding HomeShowPaid}"
                    Margin="32,24,32,16"
                    Theme="{StaticResource ClassicCheckBox}" />

                <Border
                    BorderBrush="{StaticResource ColorDivider}"
                    BorderThickness="0,2,0,0"
                    IsVisible="{Binding HasNoServices}"
                    Margin="32,0,32,0"
                    Padding="32,64">
                    <TextBlock
                        FontFamily="{StaticResource FontBody}"
                        FontSize="29"
                        FontStyle="Italic"
                        Foreground="{StaticResource ColorTextMuted45}"
                        HorizontalAlignment="Center"
                        Text="Nenhum serviço neste filtro." />
                </Border>

                <!--
                    Always grouped by dog. Every filter above — the period chips, the type chips and
                    "mostrar pagos" — narrows what a dog expands to; none of them change the shape of
                    the list. Each dog folds away until tapped.
                -->
                <ItemsControl
                    ItemsSource="{Binding DogGroups}"
                    Margin="32,0,32,48">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="utils:DogServiceGroup">
                            <StackPanel>
                                <!--  The whole header row is the tap target, not just a chevron.  -->
                                <Button Classes="RowButton" Command="{Binding ToggleCommand}">
                                    <Border
                                        BorderBrush="{StaticResource ColorDivider}"
                                        BorderThickness="0,2,0,0"
                                        Padding="0,24">
                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                            <!--
                                                Two geometries swapped by visibility rather than one
                                                rotated: a RotateTransform would need a converter
                                                for the angle, and this reads plainly in the markup.
                                            -->
                                            <Panel
                                                Grid.Column="0"
                                                Height="28"
                                                Margin="0,0,20,0"
                                                VerticalAlignment="Center"
                                                Width="28">
                                                <Path
                                                    Data="{StaticResource IconChevronRight}"
                                                    IsVisible="{Binding !IsExpanded}"
                                                    Stretch="Uniform"
                                                    Stroke="{StaticResource ColorAccent}"
                                                    StrokeJoin="Round"
                                                    StrokeLineCap="Round"
                                                    StrokeThickness="2" />
                                                <Path
                                                    Data="{StaticResource IconChevronDown}"
                                                    IsVisible="{Binding IsExpanded}"
                                                    Stretch="Uniform"
                                                    Stroke="{StaticResource ColorAccent}"
                                                    StrokeJoin="Round"
                                                    StrokeLineCap="Round"
                                                    StrokeThickness="2" />
                                            </Panel>

                                            <TextBlock
                                                FontFamily="{StaticResource FontHeading}"
                                                FontSize="40"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource ColorText}"
                                                Grid.Column="1"
                                                Text="{Binding DogName}"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                FontFamily="{StaticResource FontBody}"
                                                FontSize="25"
                                                Foreground="{StaticResource ColorTextMuted55}"
                                                Grid.Column="2"
                                                Text="{Binding CountLabel}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Button>

                                <!--  Indented so an expanded dog's services read as belonging to it.  -->
                                <ItemsControl
                                    IsVisible="{Binding IsExpanded}"
                                    ItemTemplate="{StaticResource ServiceRowTemplate}"
                                    ItemsSource="{Binding Services}"
                                    Margin="28,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
