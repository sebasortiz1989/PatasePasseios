<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.TabViews.DogsView"
    x:DataType="tabViewsViewmodels:DogsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:imaging="using:DapperDemo.View.Imaging"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tabViewsViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.TabViewsViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:utils="clr-namespace:DapperDemo.Viewmodel.Viewmodels.Utils;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!--
            One dog. The question is "is this the dog I mean", so: the photo to recognise it, the
            name, and breed and tutor to separate two dogs with the same one. The description and
            the next service are why you tap through, not how you choose.
        -->
        <DataTemplate DataType="utils:DogRow" x:Key="DogRowTemplate">
            <StackPanel>
                <Border Classes="RowRule" />
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding OpenCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="28,21">
                        <!--  Photo leading, so a column of faces scans down the edge of the group.  -->
                        <Panel Height="70" Width="70">
                            <Image
                                imaging:ImageLoader.DecodeWidth="192"
                                imaging:ImageLoader.Path="{Binding ImagePath}"
                                IsVisible="{Binding HasImage}"
                                Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Rect="0,0,70,70" />
                                </Image.Clip>
                            </Image>
                            <Border
                                Background="{DynamicResource SurfaceControl}"
                                CornerRadius="35"
                                IsVisible="{Binding NoImage}">
                                <TextBlock
                                    Classes="TCaption"
                                    HorizontalAlignment="Center"
                                    Text="{Binding Initials}"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Panel>

                        <StackPanel
                            Grid.Column="1"
                            Margin="21,0,14,0"
                            Spacing="7"
                            VerticalAlignment="Center">
                            <TextBlock Classes="TBody" Text="{Binding Name}" />
                            <TextBlock Classes="TCaption" Text="{Binding Subtitle}" />
                        </StackPanel>

                        <Path
                            Data="{StaticResource IconChevronRight}"
                            Grid.Column="2"
                            Height="30"
                            Stretch="Uniform"
                            Stroke="{DynamicResource InkSecondary}"
                            StrokeJoin="Round"
                            StrokeLineCap="Round"
                            StrokeThickness="2.4"
                            VerticalAlignment="Center"
                            Width="30" />
                    </Grid>
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfacePrimary}" RowDefinitions="Auto,Auto,*">

        <Grid ColumnDefinitions="*,Auto" Grid.Row="0" Margin="35,14,30,0">
            <TextBlock Classes="TTitle" Text="Cachorros" VerticalAlignment="Center" />
            <Border Classes="ControlRing" Grid.Column="1" VerticalAlignment="Center">
                <Border Classes="FloatingControl">
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding AddDogCommand}"
                        Height="77"
                        Padding="28,0">
                        <TextBlock Classes="TUi" Text="+ Novo" VerticalAlignment="Center" />
                    </Button>
                </Border>
            </Border>
        </Grid>

        <TextBlock
            Classes="TMicro"
            Grid.Row="1"
            IsVisible="{Binding !IsEmpty}"
            Margin="35,28,35,14"
            Text="{Binding DogCountLabel}" />

        <TextBlock
            Classes="TUi Muted"
            Grid.Row="1"
            IsVisible="{Binding IsEmpty}"
            Margin="35,28,35,0"
            Text="Nenhum cachorro cadastrado ainda."
            TextWrapping="Wrap" />

        <!--
            The group is the scroll host rather than a block inside a page-level ScrollViewer, so
            the list has a bounded viewport and can virtualize: with dozens of dogs only the rows
            on screen are realized, and only their photos decode. Inside a StackPanel the height is
            unbounded, every row is realized, and every photo decodes whether or not it is visible.

            The group runs to the bottom of the screen and content passes under the tab bar; the
            padding is what lets the last row clear it.
        -->
        <Border
            Classes="Group"
            Grid.Row="2"
            IsVisible="{Binding !IsEmpty}">
            <ScrollViewer Padding="0,0,0,168">
                <ItemsControl
                    Classes="RowGroup"
                    ItemTemplate="{StaticResource DogRowTemplate}"
                    ItemsSource="{Binding DogsCollection}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
