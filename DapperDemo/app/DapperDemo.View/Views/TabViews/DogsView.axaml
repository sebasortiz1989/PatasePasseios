<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.TabViews.DogsView"
    x:DataType="tabViewsViewmodels:DogsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:buttons="using:AvaloniaFramework.Controls.Buttons"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tabViewsViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.TabViewsViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:utils="clr-namespace:DapperDemo.Viewmodel.Viewmodels.Utils;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource ColorBg}" Width="720">
        <ScrollViewer>
            <StackPanel Spacing="0">
                <Grid ColumnDefinitions="*,Auto" Margin="32,32,32,16">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Classes="Heading1"
                            FontSize="68"
                            Text="Cachorros" />
                        <TextBlock Classes="Kicker" Text="{Binding DogCountLabel}" />
                    </StackPanel>
                    <buttons:VButton
                        Classes="BtnPrimary"
                        Command="{Binding AddDogCommand}"
                        Grid.Column="1"
                        Height="79"
                        VText="+ Novo"
                        VerticalAlignment="Center"
                        Width="180" />
                </Grid>

                <Border
                    BorderBrush="{DynamicResource ColorDivider}"
                    BorderThickness="0,2,0,0"
                    IsVisible="{Binding IsEmpty}"
                    Margin="32,0,32,0"
                    Padding="32,64">
                    <TextBlock
                        FontFamily="{StaticResource FontBody}"
                        FontSize="32"
                        FontStyle="Italic"
                        Foreground="{DynamicResource ColorTextMuted45}"
                        HorizontalAlignment="Center"
                        Text="Nenhum cachorro cadastrado ainda."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>

                <ItemsControl ItemsSource="{Binding DogsCollection}" Margin="32,0,32,32">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="utils:DogRow">
                            <Button Classes="RowButton" Command="{Binding OpenCommand}">
                                <Border
                                    BorderBrush="{DynamicResource ColorDivider}"
                                    BorderThickness="0,2,0,0"
                                    HorizontalAlignment="Stretch"
                                    Padding="0,24"
                                    VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!--  The dog's photo when it has one, its initials otherwise.  -->
                                        <Panel
                                            Grid.Column="0"
                                            Height="80"
                                            Margin="25,0,0,0"
                                            Width="80">
                                            <Image
                                                IsVisible="{Binding HasImage}"
                                                Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"
                                                Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <EllipseGeometry Rect="0,0,80,80" />
                                                </Image.Clip>
                                            </Image>
                                            <!--  The ring sits over the photo, so one border serves both states.  -->
                                            <Border
                                                BorderBrush="{DynamicResource ColorAccent}"
                                                BorderThickness="2"
                                                CornerRadius="40">
                                                <TextBlock
                                                    FontFamily="{StaticResource FontHeading}"
                                                    FontSize="37"
                                                    Foreground="{DynamicResource ColorAccentDark700}"
                                                    HorizontalAlignment="Center"
                                                    IsVisible="{Binding NoImage}"
                                                    Text="{Binding Initials}"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                        </Panel>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="24,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontFamily="{StaticResource FontHeading}"
                                                FontSize="44"
                                                FontWeight="Medium"
                                                Foreground="{DynamicResource ColorText}"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                FontFamily="{StaticResource FontBody}"
                                                FontSize="28"
                                                Foreground="{DynamicResource ColorTextMuted55}"
                                                Text="{Binding Subtitle}" />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="37"
                                            Foreground="{DynamicResource ColorAccent}"
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,25,0"
                                            Text="→"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
