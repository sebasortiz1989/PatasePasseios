<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.TabViews.ServicesView"
    x:DataType="tabViewsViewmodels:ServicesViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inputs="using:AvaloniaFramework.Controls.Inputs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tabViewsViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.TabViewsViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:utils="clr-namespace:DapperDemo.Viewmodel.Viewmodels.Utils;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!--  One time of day. Each row carries its own remove, and the last one cannot be removed.  -->
        <DataTemplate DataType="utils:ServiceTimeSlot" x:Key="TimeSlotTemplate">
            <StackPanel>
                <Border Classes="RowRule" />
                <Grid ColumnDefinitions="*,Auto" Margin="28,14">
                    <TimePicker
                        Classes="Field"
                        ClockIdentifier="24HourClock"
                        Margin="0,0,35,0"
                        SelectedTime="{Binding Time}" />
                    <!--
                        The gap and the padding are both about the thumb, not the eye: the field
                        stretches to the column edge, so without them Remover began where the field
                        ended and a tap aimed at one landed on the other.
                    -->
                    <Button
                        Classes="TextLink"
                        Command="{Binding RemoveCommand}"
                        Content="Remover"
                        Grid.Column="1"
                        IsVisible="{Binding CanRemove}"
                        Padding="0,16"
                        VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="utils:ServiceDateSlot" x:Key="DateSlotTemplate">
            <StackPanel>
                <Border Classes="RowRule" />
                <Grid ColumnDefinitions="*,Auto" Margin="28,14">
                    <CalendarDatePicker Classes="Field" Margin="0,0,35,0" SelectedDate="{Binding Date}" />
                    <!--  Spaced off the field for the same reason as the hour rows above.  -->
                    <Button
                        Classes="TextLink"
                        Command="{Binding RemoveCommand}"
                        Content="Remover"
                        Grid.Column="1"
                        IsVisible="{Binding CanRemove}"
                        Padding="0,16"
                        VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfacePrimary}" RowDefinitions="Auto,*">

        <TextBlock Classes="TTitle" Grid.Row="0" Margin="35,14,35,0" Text="Agendar" />

        <ScrollViewer Grid.Row="1" Margin="0,28,0,0">
            <StackPanel>

                <!--  What kind. Four peers, one true — the same segmented shape as everywhere else.  -->
                <TextBlock Classes="TMicro" Margin="35,0,35,14" Text="TIPO" />
                <Border Classes="Group">
                    <Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto,*" Height="77">
                        <Button
                            Classes="SegOption"
                            Classes.Active="{Binding IsTypeWalk}"
                            Command="{Binding SetTypeWalk}"
                            Content="Passeio"
                            CornerRadius="21,0,0,21" />
                        <Border Classes="SegRule" Grid.Column="1" />
                        <Button
                            Classes="SegOption"
                            Classes.Active="{Binding IsTypeSitting}"
                            Command="{Binding SetTypeSitting}"
                            Content="Pet sitting"
                            Grid.Column="2" />
                        <Border Classes="SegRule" Grid.Column="3" />
                        <Button
                            Classes="SegOption"
                            Classes.Active="{Binding IsTypeHotel}"
                            Command="{Binding SetTypeHotel}"
                            Content="Hotel"
                            Grid.Column="4" />
                        <Border Classes="SegRule" Grid.Column="5" />
                        <Button
                            Classes="SegOption"
                            Classes.Active="{Binding IsTypeDayCare}"
                            Command="{Binding SetTypeDayCare}"
                            Content="Day Care"
                            CornerRadius="0,21,21,0"
                            Grid.Column="6" />
                    </Grid>
                </Border>

                <TextBlock Classes="TMicro" Margin="35,42,35,14" Text="CACHORRO" />
                <Border Classes="Group">
                    <StackPanel>
                        <StackPanel Margin="28,21" Spacing="7">
                            <inputs:VSearchableComboBox
                                Classes="FieldPicker"
                                IsVisible="{Binding HasDogs}"
                                ItemsSource="{Binding DogOptions}"
                                PlaceholderText="Selecione…"
                                SelectedItem="{Binding SelectedDog}" />
                            <TextBlock
                                Classes="TBody Muted"
                                IsVisible="{Binding HasNoDogs}"
                                Text="Cadastre um cachorro primeiro." />
                        </StackPanel>
                        <Border Classes="RowRule" IsVisible="{Binding HasSelectedTutor}" />
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasSelectedTutor}" Margin="28,21">
                            <TextBlock Classes="TBody" Text="Tutor" />
                            <TextBlock Classes="TBody Muted" Grid.Column="1" Text="{Binding SelectedTutorName}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Hotel: a span. Everything else: one date, a range, or a list of days.  -->
                <TextBlock Classes="TMicro" Margin="35,42,35,14" Text="QUANDO" />

                <Border Classes="Group" IsVisible="{Binding SvcIsHotel}">
                    <StackPanel>
                        <StackPanel Margin="28,21" Spacing="7">
                            <TextBlock Classes="TCaption" Text="Entrada" />
                            <CalendarDatePicker Classes="Field" SelectedDate="{Binding SvcDatePart}" />
                            <TimePicker Classes="Field" ClockIdentifier="24HourClock" SelectedTime="{Binding SvcTimePart}" />
                        </StackPanel>
                        <Border Classes="RowRule" />
                        <StackPanel Margin="28,21" Spacing="7">
                            <TextBlock Classes="TCaption" Text="Saída" />
                            <CalendarDatePicker Classes="Field" SelectedDate="{Binding SvcEndDatePart}" />
                            <TimePicker Classes="Field" ClockIdentifier="24HourClock" SelectedTime="{Binding SvcEndTimePart}" />
                        </StackPanel>
                        <Border Classes="RowRule" />
                        <Grid ColumnDefinitions="*,Auto" Margin="28,14">
                            <TextBlock Classes="TUi" Text="Passeios incluídos" VerticalAlignment="Center" />
                            <ToggleSwitch
                                Grid.Column="1"
                                IsChecked="{Binding SvcRequiresWalking}"
                                OffContent=""
                                OnContent=""
                                VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel IsVisible="{Binding !SvcIsHotel}">
                    <Border Classes="Group">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="28,14">
                                <TextBlock Classes="TUi" Text="Repetir num período" VerticalAlignment="Center" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsChecked="{Binding SvcUseDateRange}"
                                    OffContent=""
                                    OnContent=""
                                    VerticalAlignment="Center" />
                            </Grid>

                            <Border Classes="RowRule" IsVisible="{Binding SvcIsSingleDate}" />
                            <StackPanel IsVisible="{Binding SvcIsSingleDate}" Margin="28,21" Spacing="7">
                                <TextBlock Classes="TCaption" Text="Data" />
                                <CalendarDatePicker Classes="Field" SelectedDate="{Binding SvcDatePart}" />
                            </StackPanel>

                            <Border Classes="RowRule" IsVisible="{Binding SvcUseDateRange}" />
                            <StackPanel IsVisible="{Binding SvcUseDateRange}" Margin="28,21" Spacing="7">
                                <TextBlock Classes="TCaption" Text="De" />
                                <CalendarDatePicker Classes="Field" SelectedDate="{Binding SvcRangeFromPart}" />
                                <TextBlock Classes="TCaption" Text="Até" />
                                <CalendarDatePicker Classes="Field" SelectedDate="{Binding SvcRepeatUntilPart}" />
                            </StackPanel>

                            <Border Classes="RowRule" IsVisible="{Binding SvcIsDayCare}" />
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SvcIsDayCare}" Margin="28,14">
                                <TextBlock Classes="TUi" Text="Passeios incluídos" VerticalAlignment="Center" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsChecked="{Binding SvcRequiresWalking}"
                                    OffContent=""
                                    OnContent=""
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Several days, chosen one at a time. Expands inline; never a calendar popup.  -->
                    <StackPanel IsVisible="{Binding SvcUsesDateList}">
                        <TextBlock Classes="TMicro" Margin="35,42,35,14" Text="DIAS" />
                        <Border Classes="Group">
                            <StackPanel>
                                <ItemsControl
                                    Classes="RowGroup"
                                    ItemTemplate="{StaticResource DateSlotTemplate}"
                                    ItemsSource="{Binding SvcDates}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Border Classes="RowRule" />
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding AddDateCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0">
                                    <TextBlock Classes="TBody Owed" Margin="28,21" Text="+ Adicionar dia" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  A visit is often twice daily, so the times are a list rather than one field.  -->
                    <StackPanel IsVisible="{Binding SvcUsesTimes}">
                        <TextBlock Classes="TMicro" Margin="35,42,35,14" Text="HORÁRIOS" />
                        <Border Classes="Group">
                            <StackPanel>
                                <ItemsControl
                                    Classes="RowGroup"
                                    ItemTemplate="{StaticResource TimeSlotTemplate}"
                                    ItemsSource="{Binding SvcTimes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Border Classes="RowRule" />
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding AddTimeCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0">
                                    <TextBlock Classes="TBody Owed" Margin="28,21" Text="+ Adicionar horário" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <TextBlock Classes="TMicro" Margin="35,42,35,14" Text="VALOR" />
                <Border Classes="Group">
                    <StackPanel>
                        <StackPanel IsVisible="{Binding SvcIsHotel}" Margin="28,21" Spacing="7">
                            <TextBlock Classes="TCaption" Text="Preço por dia (R$)" />
                            <TextBox Classes="Field" Text="{Binding SvcPricePerDay}" PlaceholderText="0,00" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding !SvcIsHotel}" Margin="28,21" Spacing="7">
                            <TextBlock Classes="TCaption" Text="Preço (R$)" />
                            <TextBox Classes="Field" Text="{Binding SvcPrice}" PlaceholderText="0,00" />
                        </StackPanel>

                        <Border Classes="RowRule" />

                        <!--
                            Outside the kind panels: a discount applies to every kind, and a repeat
                            applies it to every occurrence it creates.
                        -->
                        <StackPanel Margin="28,21" Spacing="7">
                            <TextBlock Classes="TCaption" Text="Desconto (%)" />
                            <TextBox Classes="Field" Text="{Binding SvcDiscount}" PlaceholderText="ex.: 10 para 10% de desconto" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock
                    Classes="TUi Muted"
                    IsVisible="{Binding HasSvcOccurrenceSummary}"
                    Margin="35,21,35,0"
                    Text="{Binding SvcOccurrenceSummary}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Classes="TCaption"
                    Classes.Owed="{Binding SvcMsgIsError}"
                    IsVisible="{Binding HasSvcMsg}"
                    Margin="35,14,35,0"
                    Text="{Binding SvcMsg}"
                    TextWrapping="Wrap" />

                <Border Classes="ControlRing" Margin="30,28,30,0">
                    <Border Classes="FloatingControl">
                        <Button Classes="Submit" Command="{Binding CreateServiceCommand}">
                            <TextBlock Classes="TBody" Text="Agendar" />
                        </Button>
                    </Border>
                </Border>

                <!--  Clearance for the floating tab bar, which content scrolls under.  -->
                <Border Height="258" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
