<UserControl
    d:DesignHeight="1560"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="Verion.Treinamento.DapperDemo.View.Views.ServiceDetailView"
    x:DataType="viewmodels:ServiceDetailViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:buttons="clr-namespace:Verion.Apresentacao.Avalonia.Buttons;assembly=Verion.Apresentacao.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:Verion.Treinamento.DapperDemo.Viewmodel.Viewmodels;assembly=Verion.Treinamento.DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Viewbox>
        <Grid Background="{StaticResource ColorBg}" Height="1560" Width="720">
            <ScrollViewer>
                <StackPanel Spacing="0">
                    <buttons:VButton
                        Classes="BtnGhost"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Left"
                        Margin="32,32,0,0"
                        VText="← Voltar"
                        Width="180" />

                    <StackPanel Margin="32,24,32,56" Spacing="0">
                        <TextBlock Classes="Kicker" Text="{Binding TypeLabel}" />
                        <TextBlock Classes="Heading1" FontSize="72" Margin="0,4,0,0" Text="{Binding DogName}" />
                        <TextBlock FontFamily="{StaticResource FontBody}" FontSize="28" FontStyle="Italic" Foreground="{StaticResource ColorTextMuted55}" Margin="0,4,0,0">
                            <Run Text="tutor: " />
                            <Run Text="{Binding TutorName}" />
                        </TextBlock>
                        <Border Background="{StaticResource ColorAccent}" Height="2" HorizontalAlignment="Left" Margin="0,32,0,0" Width="77" />

                        <Border BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,2,0,0" Margin="0,32,0,0" Padding="0,20,0,20">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock FontFamily="{StaticResource FontBody}" FontSize="25" Foreground="{StaticResource ColorTextMuted55}" LetterSpacing="1" Text="DATA" />
                                <TextBlock Grid.Column="1" FontFamily="{StaticResource FontBody}" FontSize="31" Foreground="{StaticResource ColorText}" Text="{Binding DateLabel}" />
                            </Grid>
                        </Border>

                        <StackPanel IsVisible="{Binding IsHotel}">
                            <Border BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,2,0,0" Padding="0,20,0,20">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock FontFamily="{StaticResource FontBody}" FontSize="25" Foreground="{StaticResource ColorTextMuted55}" LetterSpacing="1" Text="SAÍDA" />
                                    <TextBlock Grid.Column="1" FontFamily="{StaticResource FontBody}" FontSize="31" Foreground="{StaticResource ColorText}" Text="{Binding EndLabel}" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,2,0,0" Padding="0,20,0,20">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock FontFamily="{StaticResource FontBody}" FontSize="25" Foreground="{StaticResource ColorTextMuted55}" LetterSpacing="1" Text="PASSEIOS" />
                                    <TextBlock Grid.Column="1" FontFamily="{StaticResource FontBody}" FontSize="31" Foreground="{StaticResource ColorText}" Text="{Binding WalkingLabel}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,2,0,0" Padding="0,20,0,20">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock FontFamily="{StaticResource FontBody}" FontSize="25" Foreground="{StaticResource ColorTextMuted55}" LetterSpacing="1" Text="{Binding PriceFieldLabel}" />
                                <TextBlock Grid.Column="1" FontFamily="{StaticResource FontHeading}" FontSize="41" Foreground="{StaticResource ColorText}" Text="{Binding PriceLabel}" />
                            </Grid>
                        </Border>

                        <Border BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,2,0,2" Padding="0,20,0,20" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock FontFamily="{StaticResource FontBody}" FontSize="25" Foreground="{StaticResource ColorTextMuted55}" LetterSpacing="1" Text="PAGAMENTO" VerticalAlignment="Center" />
                                <Button
                                    Classes="Chip"
                                    Classes.Active="{Binding Paid}"
                                    Command="{Binding TogglePaidCommand}"
                                    Content="{Binding PaidActionLabel}"
                                    Grid.Column="1" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Viewbox>
</UserControl>
