<UserControl
    d:DesignHeight="1560"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.NavigationViews.SignUpView"
    x:DataType="navigationViewsViewmodels:SignUpViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:buttons="using:AvaloniaFramework.Controls.Buttons"
    xmlns:components="using:DapperDemo.View.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inputs="using:AvaloniaFramework.Controls.Inputs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigationViewsViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.NavigationViewsViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:viewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The drop-down button used to be retemplated here, with its own copy of a calendar glyph.
        ClassicalTheme now does it for every date field in the app, so this screen inherits the
        shared icon and divider instead of drifting from them.
    -->
    <UserControl.Styles>
        <Style Selector="CalendarDatePicker:pressed /template/ Border#Background">
            <Setter Property="Background" Value="{StaticResource ColorBg}" />
        </Style>

        <Style Selector="CalendarDatePicker:pointover /template/ Border#Background">
            <Setter Property="Background" Value="{StaticResource ColorBg}" />
        </Style>
    </UserControl.Styles>

    <components:DesignCanvas DesignHeight="1560" DesignWidth="720">
        <Grid Background="{StaticResource ColorBg}" Width="720">
            <StackPanel
                HorizontalAlignment="Center"
                Spacing="24"
                VerticalAlignment="Center"
                Width="560">
                <StackPanel
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8"
                    Spacing="8">
                    <TextBlock
                        Classes="Heading1"
                        FontSize="74"
                        HorizontalAlignment="Center"
                        Text="Criar Conta" />
                    <Border
                        Background="{StaticResource ColorAccent}"
                        Height="2"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Width="63" />
                </StackPanel>

                <!--  Optional: an account without a photo falls back to the accent circle.  -->
                <Panel
                    Height="168"
                    HorizontalAlignment="Center"
                    Width="168">
                    <Image
                        IsVisible="{Binding HasPhoto}"
                        Source="{Binding PhotoPath, Converter={StaticResource ImagePathConverter}}"
                        Stretch="UniformToFill">
                        <Image.Clip>
                            <EllipseGeometry Rect="0,0,168,168" />
                        </Image.Clip>
                    </Image>
                    <Border
                        BorderBrush="{StaticResource ColorAccent}"
                        BorderThickness="2"
                        CornerRadius="84">
                        <TextBlock
                            FontFamily="{StaticResource FontHeading}"
                            FontSize="66"
                            Foreground="{StaticResource ColorAccentDark700}"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding NoPhoto}"
                            Text="Foto"
                            VerticalAlignment="Center" />
                    </Border>
                </Panel>

                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <buttons:VButton
                        Classes="BtnSecondary"
                        Command="{Binding ChoosePhotoCommand}"
                        Height="70"
                        VText="Escolher foto"
                        Width="240" />
                    <buttons:VButton
                        Classes="BtnGhost"
                        Command="{Binding RemovePhotoCommand}"
                        Height="70"
                        IsVisible="{Binding HasPhoto}"
                        VText="Remover"
                        Width="180" />
                </StackPanel>

                <inputs:VTextBoxWithLabel
                    Classes="ClassicInput"
                    VDescriptionText="Nome completo"
                    VHeight="77"
                    VText="{Binding Name}"
                    VTextWatermark="Ana Ferreira"
                    VWidth="560" />

                <inputs:VTextBoxWithLabel
                    Classes="ClassicInput"
                    VDescriptionText="Email"
                    VHeight="77"
                    VText="{Binding Email}"
                    VTextWatermark="email@exemplo.com"
                    VWidth="560" />

                <inputs:VTextBoxWithLabel
                    Classes="ClassicInput"
                    VDescriptionText="Senha"
                    VHeight="77"
                    VPasswordChar="•"
                    VText="{Binding Password}"
                    VTextWatermark="••••••••"
                    VWidth="560" />

                <Grid Margin="0,8,0,0">
                    <CalendarDatePicker
                        Background="{StaticResource ColorBg}"
                        BorderBrush="{StaticResource ColorDivider}"
                        BorderThickness="2"
                        CornerRadius="7"
                        DisplayDateStart="{Binding MinimumDate}"
                        FontFamily="{StaticResource FontBody}"
                        FontSize="34"
                        Foreground="{StaticResource ColorText}"
                        Height="77"
                        HorizontalAlignment="Stretch"
                        Padding="18,0,0,0"
                        SelectedDate="{Binding BirthDate}"
                        VerticalAlignment="Center" />

                    <Border
                        Background="{StaticResource ColorBg}"
                        HorizontalAlignment="Left"
                        Margin="18,-13,0,0"
                        VerticalAlignment="Top">
                        <TextBlock
                            Background="Transparent"
                            FontFamily="{StaticResource FontBody}"
                            FontSize="28"
                            Foreground="{StaticResource ColorTextMuted70}"
                            Margin="3,0,3,0"
                            Text="Data de nascimento" />
                    </Border>
                </Grid>

                <TextBlock
                    FontFamily="{StaticResource FontBody}"
                    FontSize="31"
                    FontStyle="Italic"
                    Foreground="{StaticResource ColorAccentDark800}"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding HasSignupError}"
                    Text="{Binding SignupError}"
                    TextAlignment="Center" />

                <Grid ColumnDefinitions="*,16,*" Margin="0,8,0,0">
                    <buttons:VButton
                        Classes="BtnSecondary"
                        Command="{Binding BackCommand}"
                        Height="88"
                        VText="Voltar" />
                    <buttons:VButton
                        Classes="BtnPrimary"
                        Command="{Binding RegisterCommand}"
                        Grid.Column="2"
                        Height="88"
                        VText="Criar" />
                </Grid>
            </StackPanel>
        </Grid>
    </components:DesignCanvas>

</UserControl>
