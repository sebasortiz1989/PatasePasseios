<UserControl
    d:DesignHeight="1560"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.NavigationViews.SignUpView"
    x:DataType="navigationViewsViewmodels:SignUpViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:components="using:DapperDemo.View.Components"
    xmlns:converters="using:DapperDemo.View.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigationViewsViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.NavigationViewsViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <components:DesignCanvas DesignHeight="1560" DesignWidth="720">
        <Grid Background="{DynamicResource SurfacePrimary}" Width="720">
            <ScrollViewer>
                <StackPanel Margin="0,0,0,70">
                    <Button
                        Command="{Binding BackCommand}"
                        Margin="30,30,0,0"
                        Tag="Entrar"
                        Theme="{StaticResource BackControl}" />

                    <TextBlock Classes="TTitle" Margin="35,28,35,0" Text="Criar conta" />

                    <TextBlock Classes="TMicro" Margin="35,42,35,14" Text="SEUS DADOS" />

                    <Border Classes="Group">
                        <StackPanel>
                            <StackPanel Margin="28,21" Spacing="4">
                                <TextBlock Classes="TCaption" Text="Nome" />
                                <TextBox Classes="Field" Text="{Binding Name}" Watermark="Larissa Lopes" />
                            </StackPanel>

                            <Border Classes="RowRule" />

                            <StackPanel Margin="28,21" Spacing="4">
                                <TextBlock Classes="TCaption" Text="E-mail" />
                                <TextBox Classes="Field" Text="{Binding Email}" Watermark="voce@exemplo.com" />
                            </StackPanel>

                            <Border Classes="RowRule" />

                            <StackPanel Margin="28,21" Spacing="4">
                                <TextBlock Classes="TCaption" Text="Senha" />
                                <TextBox Classes="Field" PasswordChar="•" Text="{Binding Password}" />
                            </StackPanel>

                            <Border Classes="RowRule" />

                            <!--
                                The one popup left on this screen. Tolerated because a calendar's
                                content is short and uses theme-default sizes rather than
                                canvas-derived ones — see the styling reference.
                            -->
                            <StackPanel Margin="28,21" Spacing="4">
                                <TextBlock Classes="TCaption" Text="Data de nascimento" />
                                <CalendarDatePicker
                                    Classes="FormInput"
                                    DisplayDateStart="{Binding MinimumDate}"
                                    SelectedDate="{Binding BirthDate}" />
                            </StackPanel>

                            <Border Classes="RowRule" />

                            <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Classes="TBody" Text="Foto" />
                                    <TextBlock
                                        Classes="TCaption"
                                        IsVisible="{Binding NoPhoto}"
                                        Text="Nenhuma escolhida" />
                                    <Button
                                        Classes="TextLink"
                                        Command="{Binding RemovePhotoCommand}"
                                        Content="Remover"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding HasPhoto}" />
                                </StackPanel>
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ChoosePhotoCommand}"
                                    Grid.Column="1"
                                    Padding="0">
                                    <Border
                                        BorderBrush="{DynamicResource StrokeRaised}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Height="70"
                                        Width="70">
                                        <Image
                                            IsVisible="{Binding HasPhoto}"
                                            Source="{Binding PhotoPath, Converter={StaticResource ImagePathConverter}, ConverterParameter=192}"
                                            Stretch="UniformToFill" />
                                    </Border>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Classes="TCaption Owed"
                        IsVisible="{Binding HasSignupError}"
                        Margin="35,14,35,0"
                        Text="{Binding SignupError}"
                        TextWrapping="Wrap" />

                    <Border Classes="ControlRing" Margin="30,28,30,0">
                        <Border Classes="FloatingControl">
                            <Button Classes="Submit" Command="{Binding RegisterCommand}">
                                <TextBlock Classes="TBody" Text="Criar conta" />
                            </Button>
                        </Border>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </components:DesignCanvas>
</UserControl>
