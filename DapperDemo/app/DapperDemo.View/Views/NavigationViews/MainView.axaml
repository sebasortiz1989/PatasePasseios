<UserControl
    d:DesignHeight="1560"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.NavigationViews.MainView"
    x:DataType="navigationViewsViewmodels:MainViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:components="using:DapperDemo.View.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigationViewsViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.NavigationViewsViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:viewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The row holding the screens is starred rather than the authored 1460: DesignCanvas scales by
        width and hands the leftover height to this Grid, so on a taller-than-design device that row
        grows and the 100-unit navigation bar stays put at the bottom.
    -->
    <components:DesignCanvas DesignHeight="1560" DesignWidth="720">
        <Grid Background="{DynamicResource SurfacePrimary}" Width="720">

            <TransitioningContentControl Content="{Binding CurrentView.ViewShown}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.25" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>

            <!--
                The bar is an object on the page rather than a band welded to its bottom edge: 650
                wide, inset 35, with the same fill, 1px edge and 5px ring of page colour every other
                floating control carries. Content passes underneath, which is why each screen ends
                with its own bottom clearance — 258 units, which is this margin plus the bar's 108
                and the same 30-unit cushion it always had. Move one and move the others.

                120 units off the bottom, not the 30 it was: the app draws to the edge of the screen
                and 30 units is 15dp on a phone, so the bar sat inside Android's own navigation bar
                — measured on a 1080x2340 device, 64px of it — and reaching for Perfil pressed Back.
                The canvas maps 720 units to about 360dp there, so a unit is half a dp: 96 units is
                exactly the 48dp navigation bar and 120 leaves a 12dp gap above it, which is what it
                takes for a thumb aimed low at Perfil to miss the Back button.
                A fixed number rather than the real inset, because TopLevel.InsetsManager reports the
                safe area in layout units and converting it means reading DesignCanvas' scale back
                out, which it does not expose. Worth doing properly if this reads as too much room on
                a device with no navigation bar at all.
            -->
            <!--
                Hidden while a screen is covered — see ScreenOverlay. The bar is added after the
                control hosting the tabs, so it paints over whatever a tab draws; a dialog or a
                full-screen photo cannot get above it from inside the tab.
            -->
            <Border
                Classes="ControlRing"
                HorizontalAlignment="Center"
                Margin="0,0,0,120"
                Name="NavigationBar"
                VerticalAlignment="Bottom">
                <Border Classes="FloatingControl" Height="98" Width="650">
                <Grid ColumnDefinitions="*,*,*,*,*">
                    <RadioButton
                        Command="{Binding DogsViewCommand}"
                        Grid.Column="0"
                        GroupName="MainTabs"
                        Tag="Cães"
                        Theme="{StaticResource NavTab}">
                        <Path
                            Data="{StaticResource IconDogs}"
                            Height="37"
                            Stretch="Uniform"
                            Stroke="{Binding $parent[RadioButton].Foreground}"
                            StrokeJoin="Round"
                            StrokeLineCap="Round"
                            StrokeThickness="1.4"
                            Width="37" />
                    </RadioButton>

                    <RadioButton
                        Command="{Binding TutorsViewCommand}"
                        Grid.Column="1"
                        GroupName="MainTabs"
                        Tag="Tutores"
                        Theme="{StaticResource NavTab}">
                        <Path
                            Data="{StaticResource IconTutors}"
                            Height="37"
                            Stretch="Uniform"
                            Stroke="{Binding $parent[RadioButton].Foreground}"
                            StrokeJoin="Round"
                            StrokeLineCap="Round"
                            StrokeThickness="1.4"
                            Width="37" />
                    </RadioButton>

                    <RadioButton
                        Command="{Binding HomeViewCommand}"
                        Grid.Column="2"
                        GroupName="MainTabs"
                        IsChecked="True"
                        Tag="Agenda"
                        Theme="{StaticResource NavTab}">
                        <Path
                            Data="{StaticResource IconHome}"
                            Height="37"
                            Stretch="Uniform"
                            Stroke="{Binding $parent[RadioButton].Foreground}"
                            StrokeJoin="Round"
                            StrokeLineCap="Round"
                            StrokeThickness="1.4"
                            Width="37" />
                    </RadioButton>

                    <RadioButton
                        Command="{Binding ServicesViewCommand}"
                        Grid.Column="3"
                        GroupName="MainTabs"
                        Tag="Novo"
                        Theme="{StaticResource NavTab}">
                        <Path
                            Data="{StaticResource IconNew}"
                            Height="37"
                            Stretch="Uniform"
                            Stroke="{Binding $parent[RadioButton].Foreground}"
                            StrokeJoin="Round"
                            StrokeLineCap="Round"
                            StrokeThickness="1.4"
                            Width="37" />
                    </RadioButton>

                    <RadioButton
                        Command="{Binding UsersViewCommand}"
                        Grid.Column="4"
                        GroupName="MainTabs"
                        Tag="Perfil"
                        Theme="{StaticResource NavTab}">
                        <Path
                            Data="{StaticResource IconProfile}"
                            Height="37"
                            Stretch="Uniform"
                            Stroke="{Binding $parent[RadioButton].Foreground}"
                            StrokeJoin="Round"
                            StrokeLineCap="Round"
                            StrokeThickness="1.4"
                            Width="37" />
                    </RadioButton>
                </Grid>
                </Border>
            </Border>

        </Grid>
    </components:DesignCanvas>

</UserControl>
