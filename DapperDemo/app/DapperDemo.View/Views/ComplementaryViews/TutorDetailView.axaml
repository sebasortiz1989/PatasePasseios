<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.ComplementaryViews.TutorDetailView"
    x:DataType="complementaryViewsViewmodels:TutorDetailViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:complementaryViewsViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.ComplementaryViewsViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:components="using:DapperDemo.View.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:imaging="using:DapperDemo.View.Imaging"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:DapperDemo.Viewmodel.Viewmodels.Utils;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate DataType="utils:ServiceGroupRow" x:Key="PendingRowTemplate">
            <StackPanel>
                <Border Classes="RowRule" />
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding OpenCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="0">
                    <StackPanel Margin="28,21" Spacing="7">
                        <TextBlock Classes="TBody" Text="{Binding DateLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Classes="TCaption"
                                IsVisible="{Binding ShowsDogName}"
                                Text="{Binding DogName}" />
                            <TextBlock
                                Classes="TCaption"
                                IsVisible="{Binding ShowsDogName}"
                                Text=" · " />
                            <TextBlock Classes="TCaption" Text="{Binding DoneLabel}" />
                            <TextBlock Classes="TCaption" Text=" · " />
                            <TextBlock
                                Classes="TCaption"
                                Classes.Owed="{Binding !Paid}"
                                Text="{Binding PaidLabel}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="utils:ServiceTypeGroup" x:Key="PendingGroupTemplate">
            <Border Classes="Group" Margin="35,0,35,35">
                <StackPanel>
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ToggleCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0">
                        <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="TBody" Text="{Binding TypeLabel}" />
                                <TextBlock Classes="TCaption" Text="{Binding CountLabel}" />
                            </StackPanel>
                            <Path
                                Data="{StaticResource IconChevronDown}"
                                Grid.Column="1"
                                Height="30"
                                IsVisible="{Binding IsExpanded}"
                                Stretch="Uniform"
                                Stroke="{DynamicResource InkSecondary}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="2.4"
                                VerticalAlignment="Center"
                                Width="30" />
                            <Path
                                Data="{StaticResource IconChevronRight}"
                                Grid.Column="1"
                                Height="30"
                                IsVisible="{Binding !IsExpanded}"
                                Stretch="Uniform"
                                Stroke="{DynamicResource InkSecondary}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="2.4"
                                VerticalAlignment="Center"
                                Width="30" />
                        </Grid>
                    </Button>
                    <ItemsControl
                        IsVisible="{Binding IsExpanded}"
                        ItemTemplate="{StaticResource PendingRowTemplate}"
                        ItemsSource="{Binding Services}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="utils:DogRow" x:Key="TutorDogRowTemplate">
            <StackPanel>
                <Border Classes="RowRule" />
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding OpenCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="28,21">
                        <Panel Height="70" Width="70">
                            <Image
                                imaging:ImageLoader.DecodeWidth="192"
                                imaging:ImageLoader.Path="{Binding ImagePath}"
                                IsVisible="{Binding HasImage}"
                                Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Rect="0,0,70,70" />
                                </Image.Clip>
                            </Image>
                            <Border
                                Background="{DynamicResource SurfaceControl}"
                                CornerRadius="35"
                                IsVisible="{Binding NoImage}">
                                <TextBlock
                                    Classes="TCaption"
                                    HorizontalAlignment="Center"
                                    Text="{Binding Initials}"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Panel>
                        <StackPanel
                            Grid.Column="1"
                            Margin="21,0,14,0"
                            Spacing="7"
                            VerticalAlignment="Center">
                            <TextBlock Classes="TBody" Text="{Binding Name}" />
                            <TextBlock Classes="TCaption" Text="{Binding Subtitle}" />
                        </StackPanel>
                        <Path
                            Data="{StaticResource IconChevronRight}"
                            Grid.Column="2"
                            Height="30"
                            Stretch="Uniform"
                            Stroke="{DynamicResource InkSecondary}"
                            StrokeJoin="Round"
                            StrokeLineCap="Round"
                            StrokeThickness="2.4"
                            VerticalAlignment="Center"
                            Width="30" />
                    </Grid>
                </Button>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="utils:TutorPaymentRow" x:Key="PaymentRowTemplate">
            <StackPanel>
                <Border Classes="RowRule" />
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="28,21">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="TBody" Text="{Binding AmountLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="TCaption" Text="{Binding DateLabel}" />
                            <TextBlock
                                Classes="TCaption"
                                IsVisible="{Binding HasCredit}"
                                Text=" · " />
                            <TextBlock
                                Classes="TCaption"
                                IsVisible="{Binding HasCredit}"
                                Text="{Binding CreditLabel}" />
                        </StackPanel>
                    </StackPanel>
                    <Button
                        Classes="TextLink"
                        Command="{Binding EditCommand}"
                        Content="Editar"
                        Grid.Column="1"
                        Margin="0,0,28,0"
                        VerticalAlignment="Center" />
                    <Button
                        Classes="TextLink"
                        Command="{Binding DeleteCommand}"
                        Content="Excluir"
                        Grid.Column="2"
                        VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfacePrimary}" Width="720">
        <ScrollViewer>
            <StackPanel>
                <Button
                    Command="{Binding BackCommand}"
                    Margin="30,30,0,0"
                    Tag="{Binding Navigation.BackLabel}"
                    Theme="{StaticResource BackControl}" />

                <StackPanel IsVisible="{Binding !IsEditing}">
                    <StackPanel Margin="35,28,35,0" Spacing="14">
                        <Border
                            Background="{DynamicResource SurfaceControl}"
                            CornerRadius="84"
                            Height="168"
                            HorizontalAlignment="Left"
                            Width="168">
                            <TextBlock
                                Classes="TTitle"
                                HorizontalAlignment="Center"
                                Text="{Binding Initials}"
                                VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Classes="TTitle"
                                Text="{Binding Name}"
                                TextWrapping="Wrap" />
                            <TextBlock Classes="TCaption" Text="{Binding Neighborhood}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        Classes="TMicro"
                        Margin="35,42,35,14"
                        Text="CONTATO" />
                    <Border Classes="Group">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                                <TextBlock Classes="TBody" Text="Telefone" />
                                <TextBlock
                                    Classes="TBody Muted"
                                    Grid.Column="1"
                                    Text="{Binding Phone}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  The dog screen links to its tutor, so this links back.  -->
                    <TextBlock
                        Classes="TMicro"
                        Margin="35,42,35,14"
                        Text="CACHORROS" />

                    <TextBlock
                        Classes="TUi Muted"
                        IsVisible="{Binding NoDogs}"
                        Margin="35,0"
                        Text="Nenhum cachorro cadastrado."
                        TextWrapping="Wrap" />

                    <Border Classes="Group" IsVisible="{Binding !NoDogs}">
                        <ItemsControl
                            Classes="RowGroup"
                            ItemTemplate="{StaticResource TutorDogRowTemplate}"
                            ItemsSource="{Binding Dogs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>

                    <TextBlock
                        Classes="TMicro"
                        Margin="35,42,35,14"
                        Text="CONTA" />
                    <Border Classes="Group">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                                <TextBlock Classes="TBody" Text="A pagar" />
                                <TextBlock
                                    Classes="TBody Owed"
                                    FontWeight="SemiBold"
                                    Grid.Column="1"
                                    Text="{Binding TotalDueLabel}" />
                            </Grid>

                            <Border Classes="RowRule" IsVisible="{Binding HasUpcoming}" />
                            <Grid
                                ColumnDefinitions="*,Auto"
                                IsVisible="{Binding HasUpcoming}"
                                Margin="28,21">
                                <TextBlock Classes="TBody" Text="A executar" />
                                <TextBlock
                                    Classes="TBody Muted"
                                    Grid.Column="1"
                                    Text="{Binding UpcomingTotalLabel}" />
                            </Grid>

                            <Border Classes="RowRule" IsVisible="{Binding HasCredit}" />
                            <Grid
                                ColumnDefinitions="*,Auto"
                                IsVisible="{Binding HasCredit}"
                                Margin="28,21">
                                <TextBlock Classes="TBody" Text="Crédito" />
                                <TextBlock
                                    Classes="TBody Muted"
                                    Grid.Column="1"
                                    Text="{Binding CreditLabel}" />
                            </Grid>

                            <Border Classes="RowRule" />
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding OpenPaymentCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                IsVisible="{Binding !IsRegisteringPayment}"
                                Padding="0">
                                <TextBlock
                                    Classes="TBody"
                                    Margin="28,21"
                                    Text="Registrar pagamento" />
                            </Button>

                            <StackPanel
                                IsVisible="{Binding IsRegisteringPayment}"
                                Margin="28,21"
                                Spacing="14">
                                <TextBlock Classes="TCaption" Text="Valor recebido" />
                                <TextBox
                                    Classes="Field"
                                    PlaceholderText="0,00"
                                    Text="{Binding PaymentAmount}" />
                                <TextBlock
                                    Classes="TCaption"
                                    IsVisible="{Binding HasPaymentPreview}"
                                    Text="{Binding PaymentPreview}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Classes="TCaption Owed"
                                    IsVisible="{Binding HasPaymentError}"
                                    Text="{Binding PaymentError}"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="28">
                                    <Button
                                        Classes="TextLink"
                                        Command="{Binding ConfirmPaymentCommand}"
                                        Content="Confirmar" />
                                    <Button
                                        Classes="TextLink"
                                        Command="{Binding CancelPaymentCommand}"
                                        Content="Cancelar" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Classes="TCaption"
                        IsVisible="{Binding HasPaymentMsg}"
                        Margin="35,14,35,0"
                        Text="{Binding PaymentMsg}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Classes="TMicro"
                        Margin="35,42,35,14"
                        Text="EM ABERTO" />

                    <!--
                        The period this list is scoped to. Stepped rather than picked from a
                        drop-down: popups ignore the design canvas' scale.
                    -->
                    <Border Classes="ControlRing" Margin="30,0,30,21">
                        <Border Classes="FloatingControl">
                            <Grid ColumnDefinitions="Auto,*,Auto" Height="77">
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding PreviousPeriodCommand}"
                                    Grid.Column="0"
                                    Margin="18,0,0,0"
                                    Padding="0"
                                    Width="77">
                                    <Path
                                        Data="{StaticResource IconChevronLeft}"
                                        Height="35"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform"
                                        Stroke="{DynamicResource InkPrimary}"
                                        StrokeJoin="Round"
                                        StrokeLineCap="Round"
                                        StrokeThickness="2.4"
                                        VerticalAlignment="Center"
                                        Width="35" />
                                </Button>
                                <!--  The label is the way back to "Ano todo" once the arrows have moved off it.  -->
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ToggleWholeYearCommand}"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center">
                                    <TextBlock Classes="TBody" Text="{Binding PeriodLabel}" />
                                </Button>
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding NextPeriodCommand}"
                                    Grid.Column="2"
                                    Margin="0,0,18,0"
                                    Padding="0"
                                    Width="77">
                                    <Path
                                        Data="{StaticResource IconChevronRight}"
                                        Height="35"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform"
                                        Stroke="{DynamicResource InkPrimary}"
                                        StrokeJoin="Round"
                                        StrokeLineCap="Round"
                                        StrokeThickness="2.4"
                                        VerticalAlignment="Center"
                                        Width="35" />
                                </Button>
                            </Grid>
                        </Border>
                    </Border>

                    <Border Classes="Group" Margin="35,0,35,35">
                        <Grid ColumnDefinitions="*,Auto" Margin="28,14">
                            <TextBlock
                                Classes="TUi"
                                Text="Mostrar serviços já pagos"
                                VerticalAlignment="Center" />
                            <ToggleSwitch
                                Grid.Column="1"
                                IsChecked="{Binding ShowPaidServices}"
                                OffContent=""
                                OnContent=""
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBlock
                        Classes="TUi Muted"
                        IsVisible="{Binding NoPending}"
                        Margin="35,0,35,35"
                        Text="Nenhum serviço neste período."
                        TextWrapping="Wrap" />

                    <ItemsControl ItemTemplate="{StaticResource PendingGroupTemplate}" ItemsSource="{Binding PendingServices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock
                        Classes="TMicro"
                        Margin="35,0,35,14"
                        Text="HISTÓRICO" />

                    <!--
                        Correcting a mistyped amount. Editing is delete + re-apply underneath, so
                        the whole allocation is worked out again rather than nudged.
                    -->
                    <Border
                        Classes="Group"
                        IsVisible="{Binding IsEditingPayment}"
                        Margin="35,0,35,21">
                        <StackPanel Margin="28,21" Spacing="14">
                            <TextBlock Classes="TCaption" Text="Novo valor do pagamento" />
                            <TextBox
                                Classes="Field"
                                PlaceholderText="0,00"
                                Text="{Binding EditPaymentAmount}" />
                            <TextBlock
                                Classes="TCaption Owed"
                                IsVisible="{Binding HasEditPaymentError}"
                                Text="{Binding EditPaymentError}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="28">
                                <Button
                                    Classes="TextLink"
                                    Command="{Binding SavePaymentEditCommand}"
                                    Content="Salvar" />
                                <Button
                                    Classes="TextLink"
                                    Command="{Binding CancelPaymentEditCommand}"
                                    Content="Cancelar" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Classes="TUi Muted"
                        IsVisible="{Binding NoPayments}"
                        Margin="35,0"
                        Text="Nenhum pagamento registrado."
                        TextWrapping="Wrap" />

                    <Border Classes="Group" IsVisible="{Binding !NoPayments}">
                        <ItemsControl
                            Classes="RowGroup"
                            ItemTemplate="{StaticResource PaymentRowTemplate}"
                            ItemsSource="{Binding Payments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>

                    <Border Classes="ControlRing" Margin="30,35,30,0">
                        <Border Classes="FloatingControl">
                            <Button Classes="Submit" Command="{Binding ExportCommand}">
                                <TextBlock Classes="TBody" Text="Exportar resumo (PNG)" />
                            </Button>
                        </Border>
                    </Border>

                    <TextBlock
                        Classes="TCaption"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding HasExportMsg}"
                        Margin="35,14,35,0"
                        Text="{Binding ExportMsg}"
                        TextWrapping="Wrap" />

                    <Border Classes="Group" Margin="35,35,35,0">
                        <StackPanel>
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding EditCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0">
                                <TextBlock
                                    Classes="TBody"
                                    Margin="28,21"
                                    Text="Editar" />
                            </Button>
                            <Border Classes="RowRule" />
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding AskDeleteCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0">
                                <TextBlock
                                    Classes="TBody Owed"
                                    Margin="28,21"
                                    Text="Excluir" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Editing state  -->
                <StackPanel IsVisible="{Binding IsEditing}">
                    <TextBlock
                        Classes="TTitle"
                        Margin="35,28,35,0"
                        Text="Editar tutor" />
                    <TextBlock
                        Classes="TMicro"
                        Margin="35,42,35,14"
                        Text="DADOS" />
                    <Border Classes="Group">
                        <StackPanel>
                            <StackPanel Margin="28,21" Spacing="7">
                                <TextBlock Classes="TCaption" Text="Nome completo" />
                                <TextBox Classes="Field" Text="{Binding EditName}" />
                            </StackPanel>
                            <Border Classes="RowRule" />
                            <StackPanel Margin="28,21" Spacing="7">
                                <TextBlock Classes="TCaption" Text="Telefone" />
                                <TextBox Classes="Field" Text="{Binding EditPhone}" />
                            </StackPanel>
                            <Border Classes="RowRule" />
                            <StackPanel Margin="28,21" Spacing="7">
                                <TextBlock Classes="TCaption" Text="Endereço" />
                                <TextBox Classes="Field" Text="{Binding EditAddress}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Classes="TCaption Owed"
                        IsVisible="{Binding HasEditError}"
                        Margin="35,14,35,0"
                        Text="{Binding EditError}"
                        TextWrapping="Wrap" />

                    <Border Classes="ControlRing" Margin="30,28,30,0">
                        <Border Classes="FloatingControl">
                            <Button Classes="Submit" Command="{Binding SaveEditCommand}">
                                <TextBlock Classes="TBody" Text="Salvar" />
                            </Button>
                        </Border>
                    </Border>

                    <Button
                        Classes="TextLink"
                        Command="{Binding CancelEditCommand}"
                        Content="Cancelar"
                        HorizontalAlignment="Center"
                        Margin="0,28,0,0" />
                </StackPanel>

                <!--  Clearance for the floating tab bar, which content scrolls under.  -->
                <Border Height="168" />
            </StackPanel>
        </ScrollViewer>

        <components:ConfirmDialog
            CancelCommand="{Binding CancelDeleteCommand}"
            ConfirmCommand="{Binding ConfirmDeleteCommand}"
            IsOpen="{Binding ConfirmingDelete}"
            Message="O tutor, seus cachorros e todos os serviços deles serão excluídos para sempre. Não é possível desfazer."
            Title="Excluir tutor?" />

        <components:ConfirmDialog
            CancelCommand="{Binding CancelPaymentDeleteCommand}"
            ConfirmCommand="{Binding ConfirmPaymentDeleteCommand}"
            IsOpen="{Binding ConfirmingPaymentDelete}"
            Message="Os serviços quitados por ele voltam a ficar em aberto e o crédito que ele gerou é devolvido. Os serviços em si não são excluídos."
            Title="Excluir este pagamento?" />

        <components:ConfirmDialog
            CancelCommand="{Binding ReplaceRequest.CancelCommand}"
            ConfirmCommand="{Binding ReplaceRequest.ConfirmCommand}"
            IsOpen="{Binding ReplaceRequest.IsOpen}"
            Message="{Binding ReplaceRequest.Message}"
            Title="Substituir arquivo?" />
    </Grid>
</UserControl>
