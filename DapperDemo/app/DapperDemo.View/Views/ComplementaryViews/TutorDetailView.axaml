<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.ComplementaryViews.TutorDetailView"
    x:DataType="complementaryViewsViewmodels:TutorDetailViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:buttons="using:AvaloniaFramework.Controls.Buttons"
    xmlns:complementaryViewsViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.ComplementaryViewsViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:components="using:DapperDemo.View.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:DapperDemo.Viewmodel.Viewmodels.Utils;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Background="{DynamicResource ColorBg}"
        RowDefinitions="Auto,*"
        Width="720">

        <!--
            Outside the ScrollViewer, in its own row, so it stays put while the rest scrolls
            under it. It carries the background as well, or the content would show through as
            it passes behind.
        -->
        <Border Background="{DynamicResource ColorBg}" Grid.Row="0">
            <buttons:VButton
                Classes="BtnBack"
                Command="{Binding BackCommand}"
                Margin="32,32,0,12"
                VText="← Voltar" />
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="0">
                <StackPanel
                    HorizontalAlignment="Center"
                    Margin="32,32,32,24"
                    Spacing="12">
                    <Border
                        BorderBrush="{DynamicResource ColorDivider}"
                        BorderThickness="2"
                        CornerRadius="84"
                        Height="168"
                        HorizontalAlignment="Center"
                        Width="168">
                        <TextBlock
                            FontFamily="{StaticResource FontHeading}"
                            FontSize="78"
                            Foreground="{DynamicResource ColorTextMuted70}"
                            HorizontalAlignment="Center"
                            Text="{Binding Initials}"
                            VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        Classes="Heading1"
                        FontSize="74"
                        HorizontalAlignment="Center"
                        Text="{Binding Name}" />
                    <TextBlock
                        Classes="Kicker"
                        HorizontalAlignment="Center"
                        Text="{Binding Neighborhood}" />
                </StackPanel>

                <StackPanel Margin="32,0,32,56" Spacing="28">
                    <!--  Read view  -->
                    <StackPanel IsVisible="{Binding IsViewing}" Spacing="28">
                        <Border
                            BorderBrush="{DynamicResource ColorDivider}"
                            BorderThickness="0,2,0,0"
                            Padding="0,20,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="Kicker" Text="Telefone" />
                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="34"
                                    Foreground="{DynamicResource ColorText}"
                                    Text="{Binding Phone}" />
                            </StackPanel>
                        </Border>

                        <Border
                            BorderBrush="{DynamicResource ColorDivider}"
                            BorderThickness="0,2,0,0"
                            Padding="0,20,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="Kicker" Text="Cachorros" />
                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="34"
                                    Foreground="{DynamicResource ColorText}"
                                    Text="{Binding DogNames}" />
                            </StackPanel>
                        </Border>

                        <Border
                            BorderBrush="{DynamicResource ColorDivider}"
                            BorderThickness="0,2,0,0"
                            Padding="0,20,0,0">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="Kicker" Text="Serviços" />

                                <!--
                                    Scopes the list only. The totals above stay whole-account: a
                                    balance owed does not shrink because one month is on screen.
                                -->
                                <Grid ColumnDefinitions="*,16,Auto">
                                    <ComboBox
                                        Classes="FormInput"
                                        ItemsSource="{Binding MonthOptions}"
                                        SelectedItem="{Binding SelectedMonth}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="utils:MonthOption">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox
                                        Classes="FormInput"
                                        Grid.Column="2"
                                        ItemsSource="{Binding YearOptions}"
                                        MinWidth="180"
                                        SelectedItem="{Binding SelectedYear}" />
                                </Grid>

                                <CheckBox
                                    Content="Mostrar serviços já pagos"
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="30"
                                    Foreground="{DynamicResource ColorTextMuted65}"
                                    IsChecked="{Binding ShowPaidServices}"
                                    Theme="{StaticResource ClassicCheckBox}" />

                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="32"
                                    FontStyle="Italic"
                                    Foreground="{DynamicResource ColorTextMuted45}"
                                    IsVisible="{Binding NoPending}"
                                    Text="Nenhum serviço neste período." />
                                <!--
                                    Grouped by kind: the heading carries the service name, which leaves the row's widest
                                    column free for the date. Collapsed until tapped, the same as the agenda's dog groups.
                                -->
                                <ItemsControl ItemsSource="{Binding PendingServices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="utils:ServiceTypeGroup">
                                            <StackPanel>
                                                <!--  The whole heading is the tap target, not just the chevron.  -->
                                                <Button Classes="RowButton" Command="{Binding ToggleCommand}">
                                                    <Border
                                                        BorderBrush="{DynamicResource ColorDivider}"
                                                        BorderThickness="0,0,0,2"
                                                        Padding="0,18">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                            <Panel
                                                                Grid.Column="0"
                                                                Height="26"
                                                                Margin="0,0,18,0"
                                                                VerticalAlignment="Center"
                                                                Width="26">
                                                                <Path
                                                                    Data="{StaticResource IconChevronRight}"
                                                                    IsVisible="{Binding !IsExpanded}"
                                                                    Stretch="Uniform"
                                                                    Stroke="{DynamicResource ColorAccent}"
                                                                    StrokeJoin="Round"
                                                                    StrokeLineCap="Round"
                                                                    StrokeThickness="2" />
                                                                <Path
                                                                    Data="{StaticResource IconChevronDown}"
                                                                    IsVisible="{Binding IsExpanded}"
                                                                    Stretch="Uniform"
                                                                    Stroke="{DynamicResource ColorAccent}"
                                                                    StrokeJoin="Round"
                                                                    StrokeLineCap="Round"
                                                                    StrokeThickness="2" />
                                                            </Panel>

                                                            <TextBlock
                                                                FontFamily="{StaticResource FontHeading}"
                                                                FontSize="36"
                                                                FontWeight="Medium"
                                                                Foreground="{DynamicResource ColorText}"
                                                                Grid.Column="1"
                                                                Text="{Binding TypeLabel}"
                                                                VerticalAlignment="Center" />

                                                            <TextBlock
                                                                FontFamily="{StaticResource FontBody}"
                                                                FontSize="26"
                                                                Foreground="{DynamicResource ColorTextMuted55}"
                                                                Grid.Column="2"
                                                                Text="{Binding CountLabel}"
                                                                VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </Button>

                                                <ItemsControl IsVisible="{Binding IsExpanded}" ItemsSource="{Binding Services}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="utils:ServiceGroupRow">
                                                            <Button Classes="RowButton" Command="{Binding OpenCommand}">
                                                                <Border
                                                                    BorderBrush="{DynamicResource ColorDivider}"
                                                                    BorderThickness="0,0,0,2"
                                                                    Padding="0,16">
                                                                    <Grid ColumnDefinitions="*,Auto,14,Auto,10,Auto">
                                                                        <!--
                                                                            With the dog's name: the date sits in an Auto column so it always gets the
                                                                            width it needs, and the name takes whatever is left, trimming to an ellipsis
                                                                            rather than pushing the date into the tags. A horizontal StackPanel could not
                                                                            do this — it hands every child infinite width, so nothing ever trims and the
                                                                            row simply overflows.
                                                                        -->
                                                                        <Grid
                                                                            ColumnDefinitions="*,Auto"
                                                                            IsVisible="{Binding ShowsDogName}"
                                                                            VerticalAlignment="Center">
                                                                            <TextBlock
                                                                                FontFamily="{StaticResource FontBody}"
                                                                                FontSize="30"
                                                                                Foreground="{DynamicResource ColorText}"
                                                                                Grid.Column="0"
                                                                                Margin="0,0,10,0"
                                                                                Text="{Binding DogName}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                TextWrapping="NoWrap" />
                                                                            <TextBlock
                                                                                FontFamily="{StaticResource FontBody}"
                                                                                FontSize="30"
                                                                                Foreground="{DynamicResource ColorTextMuted65}"
                                                                                Grid.Column="1"
                                                                                TextWrapping="NoWrap">
                                                                                <Run Foreground="{DynamicResource ColorTextMuted55}" Text="·" />
                                                                                <Run Text="{Binding DateLabel}" />
                                                                            </TextBlock>
                                                                        </Grid>

                                                                        <!--  Date only, on a screen that is already about one dog.  -->
                                                                        <TextBlock
                                                                            FontFamily="{StaticResource FontBody}"
                                                                            FontSize="30"
                                                                            Foreground="{DynamicResource ColorTextMuted65}"
                                                                            IsVisible="{Binding !ShowsDogName}"
                                                                            Text="{Binding DateLabel}"
                                                                            TextWrapping="NoWrap"
                                                                            VerticalAlignment="Center" />

                                                                        <!--  Whether it happened, and whether it was paid for — two separate states.  -->
                                                                        <Border
                                                                            Classes="TagSign"
                                                                            Classes.Done="{Binding Done}"
                                                                            Classes.Todo="{Binding !Done}"
                                                                            Grid.Column="3">
                                                                            <TextBlock Text="{Binding DoneLabel}" />
                                                                        </Border>
                                                                        <Border
                                                                            Classes="TagSign"
                                                                            Classes.Paid="{Binding Paid}"
                                                                            Classes.Pending="{Binding !Paid}"
                                                                            Grid.Column="5">
                                                                            <TextBlock Text="{Binding PaidLabel}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!--  Money owed, and the button that settles it oldest-service-first.  -->
                        <Border
                            BorderBrush="{DynamicResource ColorDivider}"
                            BorderThickness="0,2,0,0"
                            Padding="0,20,0,0">
                            <StackPanel Spacing="12">
                                <!--  Only executed work is billable, so this is what may be asked for today.  -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Classes="Kicker"
                                        Text="A cobrar (já executado)"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontFamily="{StaticResource FontHeading}"
                                        FontSize="45"
                                        Foreground="{DynamicResource ColorAccentDark700}"
                                        Grid.Column="1"
                                        Text="{Binding TotalDueLabel}" />
                                </Grid>

                                <!--  Booked but not yet carried out: revenue coming, not money owed.  -->
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasUpcoming}">
                                    <TextBlock
                                        Classes="Kicker"
                                        Text="A executar"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontFamily="{StaticResource FontHeading}"
                                        FontSize="38"
                                        Foreground="{DynamicResource ColorTextMuted70}"
                                        Grid.Column="1"
                                        Text="{Binding UpcomingTotalLabel}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasCredit}">
                                    <TextBlock
                                        Classes="Kicker"
                                        Text="Crédito do tutor"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontFamily="{StaticResource FontHeading}"
                                        FontSize="38"
                                        Foreground="{DynamicResource ColorAccent}"
                                        Grid.Column="1"
                                        Text="{Binding CreditLabel}" />
                                </Grid>
                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="25"
                                    FontStyle="Italic"
                                    Foreground="{DynamicResource ColorTextMuted45}"
                                    IsVisible="{Binding HasCredit}"
                                    Text="Adiantamento do tutor. Será usado automaticamente quando o próximo serviço for marcado como feito."
                                    TextWrapping="Wrap" />

                                <buttons:VButton
                                    Classes="BtnPrimary"
                                    Command="{Binding OpenPaymentCommand}"
                                    Height="88"
                                    HorizontalAlignment="Stretch"
                                    IsVisible="{Binding !IsRegisteringPayment}"
                                    VText="Registrar pagamento" />

                                <StackPanel IsVisible="{Binding IsRegisteringPayment}" Spacing="12">
                                    <TextBlock Classes="FormLabel" Text="Valor recebido (R$)" />
                                    <TextBox Classes="FormInput" Text="{Binding PaymentAmount}" />
                                    <TextBlock
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="29"
                                        FontStyle="Italic"
                                        Foreground="{DynamicResource ColorTextMuted70}"
                                        IsVisible="{Binding HasPaymentPreview}"
                                        Text="{Binding PaymentPreview}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Classes="FormMsg Error"
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="29"
                                        FontStyle="Italic"
                                        IsVisible="{Binding HasPaymentError}"
                                        Text="{Binding PaymentError}"
                                        TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,16,*">
                                        <buttons:VButton
                                            Classes="BtnSecondary"
                                            Command="{Binding CancelPaymentCommand}"
                                            Height="88"
                                            VText="Cancelar" />
                                        <buttons:VButton
                                            Classes="BtnPrimary"
                                            Command="{Binding ConfirmPaymentCommand}"
                                            Grid.Column="2"
                                            Height="88"
                                            VText="Confirmar" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock
                                    Classes="FormMsg"
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="29"
                                    FontStyle="Italic"
                                    IsVisible="{Binding HasPaymentMsg}"
                                    Text="{Binding PaymentMsg}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!--
                            What the tutor has already handed over, in the same period as the list
                            above. A payment typed wrong scatters money across service rows, so
                            each one can be corrected or undone from here.
                        -->
                        <Border
                            BorderBrush="{DynamicResource ColorDivider}"
                            BorderThickness="0,2,0,0"
                            Padding="0,20,0,0">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="Kicker" Text="Pagamentos recebidos" />

                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="32"
                                    FontStyle="Italic"
                                    Foreground="{DynamicResource ColorTextMuted45}"
                                    IsVisible="{Binding NoPayments}"
                                    Text="Nenhum pagamento neste período." />

                                <!--  Hidden while a correction is open, so the form replaces the list rather than sitting under it.  -->
                                <ItemsControl IsVisible="{Binding !IsEditingPayment}" ItemsSource="{Binding Payments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="utils:TutorPaymentRow">
                                            <Border
                                                BorderBrush="{DynamicResource ColorDivider}"
                                                BorderThickness="0,0,0,2"
                                                Margin="0,0,0,12"
                                                Padding="0,0,0,12">
                                                <Grid ColumnDefinitions="*,12,Auto,10,Auto">
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontFamily="{StaticResource FontHeading}"
                                                            FontSize="36"
                                                            Foreground="{DynamicResource ColorAccentDark700}"
                                                            Text="{Binding AmountLabel}" />
                                                        <TextBlock
                                                            FontFamily="{StaticResource FontBody}"
                                                            FontSize="28"
                                                            Foreground="{DynamicResource ColorTextMuted65}"
                                                            Text="{Binding DateLabel}" />
                                                        <TextBlock
                                                            FontFamily="{StaticResource FontBody}"
                                                            FontSize="25"
                                                            FontStyle="Italic"
                                                            Foreground="{DynamicResource ColorTextMuted45}"
                                                            IsVisible="{Binding HasCredit}"
                                                            Text="{Binding CreditLabel}" />
                                                    </StackPanel>
                                                    <Button
                                                        Classes="Chip"
                                                        Command="{Binding EditCommand}"
                                                        Content="Corrigir"
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center" />
                                                    <Button
                                                        Classes="Chip"
                                                        Command="{Binding DeleteCommand}"
                                                        Content="Excluir"
                                                        Grid.Column="4"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--
                                    Correcting re-spreads the whole amount from scratch: the old
                                    payment is undone first, so raising it reaches services the
                                    smaller amount never got to and lowering it lets them go again.
                                -->
                                <StackPanel IsVisible="{Binding IsEditingPayment}" Spacing="12">
                                    <TextBlock Classes="FormLabel" Text="Corrigir valor recebido (R$)" />
                                    <TextBox Classes="FormInput" Text="{Binding EditPaymentAmount}" />
                                    <TextBlock
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="26"
                                        FontStyle="Italic"
                                        Foreground="{DynamicResource ColorTextMuted70}"
                                        Text="O pagamento será refeito com o novo valor: os serviços que ele quitou voltam a ficar em aberto e o valor é distribuído de novo, do mais antigo para o mais recente."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Classes="FormMsg Error"
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="29"
                                        FontStyle="Italic"
                                        IsVisible="{Binding HasEditPaymentError}"
                                        Text="{Binding EditPaymentError}"
                                        TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,16,*">
                                        <buttons:VButton
                                            Classes="BtnSecondary"
                                            Command="{Binding CancelPaymentEditCommand}"
                                            Height="88"
                                            VText="Cancelar" />
                                        <buttons:VButton
                                            Classes="BtnPrimary"
                                            Command="{Binding SavePaymentEditCommand}"
                                            Grid.Column="2"
                                            Height="88"
                                            VText="Salvar" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Every service by month with the Pix key, ready to send to the tutor.  -->
                        <StackPanel Margin="0,16,0,0" Spacing="8">
                            <buttons:VButton
                                Classes="BtnSecondary"
                                Command="{Binding ExportCommand}"
                                Height="88"
                                HorizontalAlignment="Stretch"
                                VText="Exportar resumo (PNG)" />
                            <TextBlock
                                Classes="FormMsg"
                                FontFamily="{StaticResource FontBody}"
                                FontSize="26"
                                FontStyle="Italic"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding HasExportMsg}"
                                Text="{Binding ExportMsg}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <buttons:VButton
                            Classes="BtnPrimary"
                            Command="{Binding EditCommand}"
                            Height="88"
                            HorizontalAlignment="Stretch"
                            VText="Editar tutor" />

                        <!--  Destructive, so it asks first — see the ConfirmDialog at the end of this file.  -->
                        <buttons:VButton
                            Classes="BtnSecondary"
                            Command="{Binding AskDeleteCommand}"
                            Height="88"
                            HorizontalAlignment="Stretch"
                            VText="Excluir tutor" />
                    </StackPanel>

                    <!--  Editor. The dogs list is not here: a dog is moved from its own screen.  -->
                    <StackPanel IsVisible="{Binding IsEditing}" Spacing="28">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="FormLabel" Text="Nome" />
                            <TextBox Classes="FormInput" Text="{Binding EditName}" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Classes="FormLabel" Text="Telefone" />
                            <TextBox Classes="FormInput" Text="{Binding EditPhone}" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Classes="FormLabel" Text="Endereço" />
                            <TextBox Classes="FormInput" Text="{Binding EditAddress}" />
                        </StackPanel>

                        <TextBlock
                            Classes="FormMsg Error"
                            FontFamily="{StaticResource FontBody}"
                            FontSize="31"
                            FontStyle="Italic"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding HasEditError}"
                            Text="{Binding EditError}"
                            TextAlignment="Center" />

                        <Grid ColumnDefinitions="*,16,*">
                            <buttons:VButton
                                Classes="BtnSecondary"
                                Command="{Binding CancelEditCommand}"
                                Height="97"
                                VText="Cancelar" />
                            <buttons:VButton
                                Classes="BtnPrimary"
                                Command="{Binding SaveEditCommand}"
                                Grid.Column="2"
                                Height="97"
                                VText="Salvar" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Last children of the Grid, so the scrim covers the screen underneath it.  -->
        <components:ConfirmDialog
            Grid.RowSpan="2"
            CancelCommand="{Binding CancelDeleteCommand}"
            ConfirmCommand="{Binding ConfirmDeleteCommand}"
            IsOpen="{Binding ConfirmingDelete}"
            Message="O tutor, seus cachorros e todos os serviços deles serão excluídos para sempre. Esta ação não pode ser desfeita."
            Title="Excluir tutor?" />

        <!--  Only one of the two is ever open, so they can share the same corner of the Grid.  -->
        <components:ConfirmDialog
            Grid.RowSpan="2"
            CancelCommand="{Binding CancelPaymentDeleteCommand}"
            ConfirmCommand="{Binding ConfirmPaymentDeleteCommand}"
            IsOpen="{Binding ConfirmingPaymentDelete}"
            Message="Os serviços quitados por ele voltam a ficar em aberto e o crédito que ele gerou é devolvido. Os serviços em si não são excluídos."
            Title="Excluir este pagamento?" />

        <!--
            Asked from inside an export, on the platforms where the app names the file itself.
            Android's save dialog never offers to replace — it quietly invents a new name — so this
            is where that choice is actually made.
        -->
        <components:ConfirmDialog
            Grid.RowSpan="2"
            CancelCommand="{Binding ReplaceRequest.CancelCommand}"
            ConfirmCommand="{Binding ReplaceRequest.ConfirmCommand}"
            IsOpen="{Binding ReplaceRequest.IsOpen}"
            Message="{Binding ReplaceRequest.Message}"
            Title="Substituir arquivo?" />
    </Grid>
</UserControl>