<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.ComplementaryViews.DogDetailView"
    x:DataType="complementaryViewsViewmodels:DogDetailViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:buttons="using:AvaloniaFramework.Controls.Buttons"
    xmlns:complementaryViewsViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.ComplementaryViewsViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:components="using:DapperDemo.View.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inputs="using:AvaloniaFramework.Controls.Inputs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:DapperDemo.Viewmodel.Viewmodels.Utils;assembly=DapperDemo.Viewmodel"
    xmlns:viewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Background="{StaticResource ColorBg}"
        RowDefinitions="Auto,*"
        Width="720">

        <!--
            Outside the ScrollViewer, in its own row, so it stays put while the rest scrolls
            under it. It carries the background as well, or the content would show through as
            it passes behind.
        -->
        <Border Background="{StaticResource ColorBg}" Grid.Row="0">
            <buttons:VButton
                Classes="BtnBack"
                Command="{Binding BackCommand}"
                Margin="32,32,0,12"
                VText="← Voltar" />
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="0">
                <StackPanel
                    HorizontalAlignment="Center"
                    Margin="32,32,32,24"
                    Spacing="12">
                    <!--  Photo when there is one, initials otherwise, so the layout never collapses.  -->
                    <Panel
                        Height="168"
                        HorizontalAlignment="Center"
                        Width="168">
                        <Image
                            IsVisible="{Binding HasPhoto}"
                            Source="{Binding PhotoPath, Converter={StaticResource ImagePathConverter}}"
                            Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry Rect="0,0,168,168" />
                            </Image.Clip>
                        </Image>
                        <Border
                            BorderBrush="{StaticResource ColorAccent}"
                            BorderThickness="2"
                            CornerRadius="84">
                            <TextBlock
                                FontFamily="{StaticResource FontHeading}"
                                FontSize="78"
                                Foreground="{StaticResource ColorAccentDark700}"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding NoPhoto}"
                                Text="{Binding Initials}"
                                VerticalAlignment="Center" />
                        </Border>
                    </Panel>

                    <!--  Photo controls only while editing; reading a record should not offer to change it.  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        IsVisible="{Binding IsEditing}"
                        Orientation="Horizontal"
                        Spacing="12">
                        <buttons:VButton
                            Classes="BtnSecondary"
                            Command="{Binding ChoosePhotoCommand}"
                            Height="70"
                            VText="Escolher foto"
                            Width="240" />
                        <buttons:VButton
                            Classes="BtnGhost"
                            Command="{Binding RemovePhotoCommand}"
                            Height="70"
                            IsVisible="{Binding HasPhoto}"
                            VText="Remover"
                            Width="180" />
                    </StackPanel>

                    <TextBlock
                        Classes="Heading1"
                        FontSize="74"
                        HorizontalAlignment="Center"
                        Text="{Binding Name}" />
                    <TextBlock
                        Classes="Kicker"
                        HorizontalAlignment="Center"
                        Text="{Binding Breed}" />
                </StackPanel>

                <StackPanel Margin="32,0,32,56" Spacing="28">
                    <!--  Read view  -->
                    <StackPanel IsVisible="{Binding IsViewing}" Spacing="28">
                        <Border
                            BorderBrush="{StaticResource ColorDivider}"
                            BorderThickness="0,2,0,0"
                            Padding="0,20,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="Kicker" Text="Tutor" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="34"
                                        Foreground="{StaticResource ColorText}"
                                        Text="{Binding OwnerName}"
                                        VerticalAlignment="Center" />

                                    <!--  Straight to this dog's tutor; their Back returns here.  -->
                                    <buttons:VButton
                                        Classes="BtnGhost"
                                        Command="{Binding OpenTutorCommand}"
                                        Grid.Column="1"
                                        Height="56"
                                        VText="Ver tutor →"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            BorderBrush="{StaticResource ColorDivider}"
                            BorderThickness="0,2,0,0"
                            Padding="0,20,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="Kicker" Text="Descrição" />
                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="34"
                                    Foreground="{StaticResource ColorText}"
                                    LineHeight="48"
                                    Text="{Binding Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            BorderBrush="{StaticResource ColorDivider}"
                            BorderThickness="0,2,0,0"
                            Padding="0,20,0,0">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="Kicker" Text="Serviços" />

                                <!--  Which period the list covers. "Ano todo" is the default month entry.  -->
                                <Grid ColumnDefinitions="*,16,Auto">
                                    <ComboBox
                                        Classes="FormInput"
                                        ItemsSource="{Binding MonthOptions}"
                                        SelectedItem="{Binding SelectedMonth}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="utils:MonthOption">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox
                                        Classes="FormInput"
                                        Grid.Column="2"
                                        ItemsSource="{Binding YearOptions}"
                                        MinWidth="180"
                                        SelectedItem="{Binding SelectedYear}" />
                                </Grid>

                                <CheckBox
                                    Content="Mostrar serviços já pagos"
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="30"
                                    Foreground="{StaticResource ColorTextMuted65}"
                                    IsChecked="{Binding ShowPaidServices}"
                                    Theme="{StaticResource ClassicCheckBox}" />

                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="32"
                                    FontStyle="Italic"
                                    Foreground="{StaticResource ColorTextMuted45}"
                                    IsVisible="{Binding NoFuture}"
                                    Text="Nenhum serviço neste período." />
                                <!--
                                    Grouped by kind: the heading carries the service name, which leaves the row's widest
                                    column free for the date. Collapsed until tapped, the same as the agenda's dog groups.
                                -->
                                <ItemsControl ItemsSource="{Binding FutureServices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="utils:ServiceTypeGroup">
                                            <StackPanel>
                                                <!--  The whole heading is the tap target, not just the chevron.  -->
                                                <Button Classes="RowButton" Command="{Binding ToggleCommand}">
                                                    <Border
                                                        BorderBrush="{StaticResource ColorDivider}"
                                                        BorderThickness="0,0,0,2"
                                                        Padding="0,18">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                            <Panel
                                                                Grid.Column="0"
                                                                Height="26"
                                                                Margin="0,0,18,0"
                                                                VerticalAlignment="Center"
                                                                Width="26">
                                                                <Path
                                                                    Data="{StaticResource IconChevronRight}"
                                                                    IsVisible="{Binding !IsExpanded}"
                                                                    Stretch="Uniform"
                                                                    Stroke="{StaticResource ColorAccent}"
                                                                    StrokeJoin="Round"
                                                                    StrokeLineCap="Round"
                                                                    StrokeThickness="2" />
                                                                <Path
                                                                    Data="{StaticResource IconChevronDown}"
                                                                    IsVisible="{Binding IsExpanded}"
                                                                    Stretch="Uniform"
                                                                    Stroke="{StaticResource ColorAccent}"
                                                                    StrokeJoin="Round"
                                                                    StrokeLineCap="Round"
                                                                    StrokeThickness="2" />
                                                            </Panel>

                                                            <TextBlock
                                                                FontFamily="{StaticResource FontHeading}"
                                                                FontSize="36"
                                                                FontWeight="Medium"
                                                                Foreground="{StaticResource ColorText}"
                                                                Grid.Column="1"
                                                                Text="{Binding TypeLabel}"
                                                                VerticalAlignment="Center" />

                                                            <TextBlock
                                                                FontFamily="{StaticResource FontBody}"
                                                                FontSize="26"
                                                                Foreground="{StaticResource ColorTextMuted55}"
                                                                Grid.Column="2"
                                                                Text="{Binding CountLabel}"
                                                                VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </Button>

                                                <ItemsControl IsVisible="{Binding IsExpanded}" ItemsSource="{Binding Services}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="utils:ServiceGroupRow">
                                                            <Button Classes="RowButton" Command="{Binding OpenCommand}">
                                                                <Border
                                                                    BorderBrush="{StaticResource ColorDivider}"
                                                                    BorderThickness="0,0,0,2"
                                                                    Padding="0,16">
                                                                    <Grid ColumnDefinitions="*,Auto,14,Auto,10,Auto">
                                                                        <!--  The dog leads the row only where a screen has more than one.  -->
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock
                                                                                FontFamily="{StaticResource FontBody}"
                                                                                FontSize="30"
                                                                                Foreground="{StaticResource ColorText}"
                                                                                IsVisible="{Binding ShowsDogName}"
                                                                                Text="{Binding DogName}" />
                                                                            <TextBlock
                                                                                FontFamily="{StaticResource FontBody}"
                                                                                FontSize="30"
                                                                                Foreground="{StaticResource ColorTextMuted55}"
                                                                                IsVisible="{Binding ShowsDogName}"
                                                                                Text=" · " />
                                                                            <TextBlock
                                                                                FontFamily="{StaticResource FontBody}"
                                                                                FontSize="30"
                                                                                Foreground="{StaticResource ColorTextMuted65}"
                                                                                Text="{Binding DateLabel}" />
                                                                        </StackPanel>

                                                                        <!--  Whether it happened, and whether it was paid for — two separate states.  -->
                                                                        <Border
                                                                            Classes="TagSign"
                                                                            Classes.Done="{Binding Done}"
                                                                            Classes.Todo="{Binding !Done}"
                                                                            Grid.Column="3">
                                                                            <TextBlock Text="{Binding DoneLabel}" />
                                                                        </Border>
                                                                        <Border
                                                                            Classes="TagSign"
                                                                            Classes.Paid="{Binding Paid}"
                                                                            Classes.Pending="{Binding !Paid}"
                                                                            Grid.Column="5">
                                                                            <TextBlock Text="{Binding PaidLabel}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <buttons:VButton
                            Classes="BtnPrimary"
                            Command="{Binding EditCommand}"
                            Height="88"
                            HorizontalAlignment="Stretch"
                            Margin="0,16,0,0"
                            VText="Editar cachorro" />

                        <!--  Destructive, so it asks first — see the ConfirmDialog at the end of this file.  -->
                        <buttons:VButton
                            Classes="BtnSecondary"
                            Command="{Binding AskDeleteCommand}"
                            Height="88"
                            HorizontalAlignment="Stretch"
                            VText="Excluir cachorro" />
                    </StackPanel>

                    <!--  Editor. Same fields as the new-dog form, so the two screens agree on what a dog is.  -->
                    <StackPanel IsVisible="{Binding IsEditing}" Spacing="28">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="FormLabel" Text="Nome" />
                            <TextBox Classes="FormInput" Text="{Binding EditName}" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Classes="FormLabel" Text="Raça" />
                            <TextBox Classes="FormInput" Text="{Binding EditBreed}" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Classes="FormLabel" Text="Tutor" />
                            <!--  Typeable: the tutor list grows, and scrolling it to find a name does not.  -->
                            <inputs:VSearchableComboBox
                                Classes="FormInput"
                                ItemsSource="{Binding TutorOptions}"
                                PlaceholderText="Selecione…"
                                SelectedItem="{Binding EditTutor}" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Classes="FormLabel" Text="Descrição" />
                            <TextBox
                                AcceptsReturn="True"
                                Classes="FormInput Multiline"
                                Text="{Binding EditDescription}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            Classes="FormMsg Error"
                            FontFamily="{StaticResource FontBody}"
                            FontSize="31"
                            FontStyle="Italic"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding HasEditError}"
                            Text="{Binding EditError}"
                            TextAlignment="Center" />

                        <Grid ColumnDefinitions="*,16,*">
                            <buttons:VButton
                                Classes="BtnSecondary"
                                Command="{Binding CancelEditCommand}"
                                Height="97"
                                VText="Cancelar" />
                            <buttons:VButton
                                Classes="BtnPrimary"
                                Command="{Binding SaveEditCommand}"
                                Grid.Column="2"
                                Height="97"
                                VText="Salvar" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Last child of the Grid, so the scrim covers the screen underneath it.  -->
        <components:ConfirmDialog
            Grid.RowSpan="2"
            CancelCommand="{Binding CancelDeleteCommand}"
            ConfirmCommand="{Binding ConfirmDeleteCommand}"
            IsOpen="{Binding ConfirmingDelete}"
            Message="O cachorro e todos os serviços dele serão excluídos para sempre. Esta ação não pode ser desfeita."
            Title="Excluir cachorro?" />
    </Grid>
</UserControl>