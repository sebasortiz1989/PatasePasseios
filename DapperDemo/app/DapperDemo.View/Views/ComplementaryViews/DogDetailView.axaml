<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.ComplementaryViews.DogDetailView"
    x:DataType="complementaryViewsViewmodels:DogDetailViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:complementaryViewsViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.ComplementaryViewsViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:components="using:DapperDemo.View.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:imaging="using:DapperDemo.View.Imaging"
    xmlns:inputs="using:AvaloniaFramework.Controls.Inputs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:DapperDemo.Viewmodel.Viewmodels.Utils;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate DataType="utils:ServiceGroupRow" x:Key="ServiceGroupRowTemplate">
            <StackPanel>
                <Border Classes="RowRule" />
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding OpenCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="0">
                    <StackPanel Margin="28,21" Spacing="7">
                        <TextBlock Classes="TBody" Text="{Binding DateLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="TCaption" IsVisible="{Binding ShowsDogName}" Text="{Binding DogName}" />
                            <TextBlock Classes="TCaption" IsVisible="{Binding ShowsDogName}" Text=" · " />
                            <TextBlock Classes="TCaption" Text="{Binding DoneLabel}" />
                            <TextBlock Classes="TCaption" Text=" · " />
                            <TextBlock
                                Classes="TCaption"
                                Classes.Owed="{Binding !Paid}"
                                Text="{Binding PaidLabel}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!--  One kind of service, folded away until tapped. The count never hides.  -->
        <DataTemplate DataType="utils:ServiceTypeGroup" x:Key="ServiceTypeGroupTemplate">
            <Border Classes="Group" Margin="35,0,35,35">
                <StackPanel>
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ToggleCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0">
                        <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="TBody" Text="{Binding TypeLabel}" />
                                <TextBlock Classes="TCaption" Text="{Binding CountLabel}" />
                            </StackPanel>
                            <Path
                                Data="{StaticResource IconChevronDown}"
                                Grid.Column="1"
                                Height="30"
                                IsVisible="{Binding IsExpanded}"
                                Stretch="Uniform"
                                Stroke="{DynamicResource InkSecondary}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="2.4"
                                VerticalAlignment="Center"
                                Width="30" />
                            <Path
                                Data="{StaticResource IconChevronRight}"
                                Grid.Column="1"
                                Height="30"
                                IsVisible="{Binding !IsExpanded}"
                                Stretch="Uniform"
                                Stroke="{DynamicResource InkSecondary}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="2.4"
                                VerticalAlignment="Center"
                                Width="30" />
                        </Grid>
                    </Button>

                    <ItemsControl
                        IsVisible="{Binding IsExpanded}"
                        ItemTemplate="{StaticResource ServiceGroupRowTemplate}"
                        ItemsSource="{Binding Services}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfacePrimary}" Width="720">
        <ScrollViewer>
            <StackPanel>
                <Button
                    Command="{Binding BackCommand}"
                    Margin="30,30,0,0"
                    Tag="{Binding Navigation.BackLabel}"
                    Theme="{StaticResource BackControl}" />

                <!--  Identity: the photo, the name, the breed. Not a group — this is the page's head.  -->
                <StackPanel IsVisible="{Binding !IsEditing}" Margin="35,28,35,0" Spacing="14">
                    <!--
                        The photo opens full screen when tapped. The button wraps the initials
                        fallback too, but OpenPhotoCommand does nothing when there is no photo, so
                        a dog without one has no dead affordance.
                    -->
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding OpenPhotoCommand}"
                        HorizontalAlignment="Left"
                        Padding="0">
                        <Panel Height="168" Width="168">
                            <Image
                                imaging:ImageLoader.Path="{Binding PhotoPath}"
                                IsVisible="{Binding HasPhoto}"
                                Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Rect="0,0,168,168" />
                                </Image.Clip>
                            </Image>
                            <Border
                                Background="{DynamicResource SurfaceControl}"
                                CornerRadius="84"
                                IsVisible="{Binding NoPhoto}">
                                <TextBlock
                                    Classes="TTitle"
                                    HorizontalAlignment="Center"
                                    Text="{Binding Initials}"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Panel>
                    </Button>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="TTitle" Text="{Binding Name}" TextWrapping="Wrap" />
                        <TextBlock Classes="TCaption" Text="{Binding Breed}" />
                    </StackPanel>
                </StackPanel>

                <!--  Reading state  -->
                <StackPanel IsVisible="{Binding !IsEditing}">
                    <TextBlock Classes="TMicro" Margin="35,42,35,14" Text="TUTOR" />
                    <Border Classes="Group">
                        <Button
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding OpenTutorCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0">
                            <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                                <TextBlock Classes="TBody" Text="{Binding OwnerName}" VerticalAlignment="Center" />
                                <Path
                                    Data="{StaticResource IconChevronRight}"
                                    Grid.Column="1"
                                    Height="30"
                                    Stretch="Uniform"
                                    Stroke="{DynamicResource InkSecondary}"
                                    StrokeJoin="Round"
                                    StrokeLineCap="Round"
                                    StrokeThickness="2.4"
                                    VerticalAlignment="Center"
                                    Width="30" />
                            </Grid>
                        </Button>
                    </Border>

                    <TextBlock Classes="TMicro" Margin="35,42,35,14" Text="DESCRIÇÃO" />
                    <Border Classes="Group">
                        <TextBlock
                            Classes="TBody"
                            Margin="28,21"
                            Text="{Binding Description}"
                            TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Classes="TMicro" Margin="35,42,35,14" Text="SERVIÇOS" />

                    <!--
                        The period this list is scoped to. Stepped rather than picked from a
                        drop-down: popups ignore the design canvas' scale.
                    -->
                    <Border Classes="ControlRing" Margin="30,0,30,21">
                        <Border Classes="FloatingControl">
                            <Grid ColumnDefinitions="Auto,*,Auto" Height="77">
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding PreviousPeriodCommand}"
                                    Grid.Column="0"
                                    Margin="18,0,0,0"
                                    Padding="0"
                                    Width="77">
                                    <Path
                                        Data="{StaticResource IconChevronLeft}"
                                        Height="35"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform"
                                        Stroke="{DynamicResource InkPrimary}"
                                        StrokeJoin="Round"
                                        StrokeLineCap="Round"
                                        StrokeThickness="2.4"
                                        VerticalAlignment="Center"
                                        Width="35" />
                                </Button>
                                <!--  The label is the way back to "Ano todo" once the arrows have moved off it.  -->
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ToggleWholeYearCommand}"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center">
                                    <TextBlock Classes="TBody" Text="{Binding PeriodLabel}" />
                                </Button>
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding NextPeriodCommand}"
                                    Grid.Column="2"
                                    Margin="0,0,18,0"
                                    Padding="0"
                                    Width="77">
                                    <Path
                                        Data="{StaticResource IconChevronRight}"
                                        Height="35"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform"
                                        Stroke="{DynamicResource InkPrimary}"
                                        StrokeJoin="Round"
                                        StrokeLineCap="Round"
                                        StrokeThickness="2.4"
                                        VerticalAlignment="Center"
                                        Width="35" />
                                </Button>
                            </Grid>
                        </Border>
                    </Border>

                    <Border Classes="Group" Margin="35,0,35,35">
                        <Grid ColumnDefinitions="*,Auto" Margin="28,14">
                            <TextBlock Classes="TUi" Text="Mostrar serviços já pagos" VerticalAlignment="Center" />
                            <ToggleSwitch
                                Grid.Column="1"
                                IsChecked="{Binding ShowPaidServices}"
                                OffContent=""
                                OnContent=""
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBlock
                        Classes="TUi Muted"
                        IsVisible="{Binding NoFuture}"
                        Margin="35,0,35,35"
                        Text="Nenhum serviço neste período."
                        TextWrapping="Wrap" />

                    <ItemsControl ItemTemplate="{StaticResource ServiceTypeGroupTemplate}" ItemsSource="{Binding FutureServices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!--  Excluir is accent.strong, not a red: this palette has no danger colour.  -->
                    <Border Classes="Group">
                        <StackPanel>
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding EditCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0">
                                <TextBlock Classes="TBody" Margin="28,21" Text="Editar" />
                            </Button>
                            <Border Classes="RowRule" />
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding AskDeleteCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0">
                                <TextBlock Classes="TBody Owed" Margin="28,21" Text="Excluir" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Editing state  -->
                <StackPanel IsVisible="{Binding IsEditing}">
                    <TextBlock Classes="TTitle" Margin="35,28,35,0" Text="Editar cachorro" />
                    <TextBlock Classes="TMicro" Margin="35,42,35,14" Text="DADOS" />

                    <Border Classes="Group">
                        <StackPanel>
                            <StackPanel Margin="28,21" Spacing="7">
                                <TextBlock Classes="TCaption" Text="Nome" />
                                <TextBox Classes="Field" Text="{Binding EditName}" />
                            </StackPanel>
                            <Border Classes="RowRule" />
                            <StackPanel Margin="28,21" Spacing="7">
                                <TextBlock Classes="TCaption" Text="Raça" />
                                <TextBox Classes="Field" Text="{Binding EditBreed}" />
                            </StackPanel>
                            <Border Classes="RowRule" />
                            <StackPanel Margin="28,21" Spacing="7">
                                <TextBlock Classes="TCaption" Text="Tutor" />
                                <inputs:VSearchableComboBox
                                    Classes="FieldPicker"
                                    ItemsSource="{Binding TutorOptions}"
                                    PlaceholderText="Selecione…"
                                    SelectedItem="{Binding EditTutor}" />
                            </StackPanel>
                            <Border Classes="RowRule" />
                            <StackPanel Margin="28,21" Spacing="7">
                                <TextBlock Classes="TCaption" Text="Descrição" />
                                <TextBox
                                    AcceptsReturn="True"
                                    Classes="Field"
                                    Text="{Binding EditDescription}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Classes="RowRule" />
                            <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                                <StackPanel Spacing="7" VerticalAlignment="Center">
                                    <TextBlock Classes="TBody" Text="Foto" />
                                    <Button
                                        Classes="TextLink"
                                        Command="{Binding RemovePhotoCommand}"
                                        Content="Remover"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding HasPhoto}" />
                                </StackPanel>
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ChoosePhotoCommand}"
                                    Grid.Column="1"
                                    Padding="0">
                                    <Border
                                        BorderBrush="{DynamicResource StrokeRaised}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Height="70"
                                        Width="70">
                                        <Image
                                            imaging:ImageLoader.DecodeWidth="192"
                                            imaging:ImageLoader.Path="{Binding PhotoPath}"
                                            IsVisible="{Binding HasPhoto}"
                                            Stretch="UniformToFill" />
                                    </Border>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Classes="TCaption Owed"
                        IsVisible="{Binding HasEditError}"
                        Margin="35,14,35,0"
                        Text="{Binding EditError}"
                        TextWrapping="Wrap" />

                    <Border Classes="ControlRing" Margin="30,28,30,0">
                        <Border Classes="FloatingControl">
                            <Button Classes="Submit" Command="{Binding SaveEditCommand}">
                                <TextBlock Classes="TBody" Text="Salvar" />
                            </Button>
                        </Border>
                    </Border>

                    <Button
                        Classes="TextLink"
                        Command="{Binding CancelEditCommand}"
                        Content="Cancelar"
                        HorizontalAlignment="Center"
                        Margin="0,28,0,0" />
                </StackPanel>

                <!--  Clearance for the floating tab bar, which content scrolls under.  -->
                <Border Height="168" />
            </StackPanel>
        </ScrollViewer>

        <components:PhotoViewer
            CloseCommand="{Binding ClosePhotoCommand}"
            IsOpen="{Binding ViewingPhoto}"
            Path="{Binding PhotoPath}" />

        <components:ConfirmDialog
            CancelCommand="{Binding CancelDeleteCommand}"
            ConfirmCommand="{Binding ConfirmDeleteCommand}"
            IsOpen="{Binding ConfirmingDelete}"
            Message="O cachorro e todos os serviços dele serão excluídos para sempre. Não é possível desfazer."
            Title="Excluir cachorro?" />
    </Grid>
</UserControl>
