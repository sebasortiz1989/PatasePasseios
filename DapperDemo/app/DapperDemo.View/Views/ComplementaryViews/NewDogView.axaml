<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.ComplementaryViews.NewDogView"
    x:DataType="complementaryViewsViewmodels:NewDogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:buttons="using:AvaloniaFramework.Controls.Buttons"
    xmlns:complementaryViewsViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.ComplementaryViewsViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inputs="using:AvaloniaFramework.Controls.Inputs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:DapperDemo.Viewmodel.Viewmodels.Utils;assembly=DapperDemo.Viewmodel"
    xmlns:viewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Background="{StaticResource ColorBg}"
        RowDefinitions="Auto,*"
        Width="720">

        <!--
            Outside the ScrollViewer, in its own row, so it stays put while the form scrolls
            under it. It carries the background as well, or the fields would show through as
            they pass behind.
        -->
        <Border Background="{StaticResource ColorBg}" Grid.Row="0">
            <buttons:VButton
                Classes="BtnBack"
                Command="{Binding BackCommand}"
                Margin="32,32,0,12"
                VText="← Voltar" />
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="0">
                <StackPanel Margin="32,24,32,16" Spacing="2">
                    <TextBlock
                        Classes="Heading1"
                        FontSize="68"
                        Text="Novo cachorro" />
                    <TextBlock Classes="Kicker" Text="Cadastrar" />
                </StackPanel>

                <!--  A dog needs an owner, so with no tutors yet the form sends the user there first  -->
                <Border
                    BorderBrush="{StaticResource ColorDivider}"
                    BorderThickness="0,2,0,0"
                    IsVisible="{Binding HasNoTutors}"
                    Margin="32,16,32,0"
                    Padding="32,64">
                    <TextBlock
                        FontFamily="{StaticResource FontBody}"
                        FontSize="32"
                        FontStyle="Italic"
                        Foreground="{StaticResource ColorTextMuted45}"
                        HorizontalAlignment="Center"
                        Text="Cadastre um tutor primeiro."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>

                <StackPanel
                    IsVisible="{Binding HasTutors}"
                    Margin="32,16,32,48"
                    Spacing="28">
                    <!--  Optional: a dog with no photo falls back to its initials everywhere.  -->
                    <StackPanel HorizontalAlignment="Center" Spacing="16">
                        <Panel
                            Height="168"
                            HorizontalAlignment="Center"
                            Width="168">
                            <Image
                                IsVisible="{Binding HasPhoto}"
                                Source="{Binding PhotoPath, Converter={StaticResource ImagePathConverter}}"
                                Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Rect="0,0,168,168" />
                                </Image.Clip>
                            </Image>
                            <Border
                                BorderBrush="{StaticResource ColorDivider}"
                                BorderThickness="2"
                                CornerRadius="84">
                                <TextBlock
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="30"
                                    FontStyle="Italic"
                                    Foreground="{StaticResource ColorTextMuted45}"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding NoPhoto}"
                                    Text="sem foto"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Panel>
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <buttons:VButton
                                Classes="BtnSecondary"
                                Command="{Binding ChoosePhotoCommand}"
                                Height="70"
                                VText="Escolher foto"
                                Width="240" />
                            <buttons:VButton
                                Classes="BtnGhost"
                                Command="{Binding RemovePhotoCommand}"
                                Height="70"
                                IsVisible="{Binding HasPhoto}"
                                VText="Remover"
                                Width="180" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock
                            FontFamily="{StaticResource FontBody}"
                            FontSize="28"
                            Foreground="{StaticResource ColorTextMuted70}"
                            Text="Nome" />
                        <TextBox
                            Background="Transparent"
                            BorderBrush="{StaticResource ColorDivider}"
                            BorderThickness="2"
                            CaretBrush="{StaticResource ColorAccent}"
                            CornerRadius="7"
                            FontFamily="{StaticResource FontBody}"
                            FontSize="34"
                            Foreground="{StaticResource ColorText}"
                            MinHeight="82"
                            Padding="18,0"
                            PlaceholderText="Toby"
                            Text="{Binding Name}"
                            VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock
                            FontFamily="{StaticResource FontBody}"
                            FontSize="28"
                            Foreground="{StaticResource ColorTextMuted70}"
                            Text="Raça" />
                        <TextBox
                            Background="Transparent"
                            BorderBrush="{StaticResource ColorDivider}"
                            BorderThickness="2"
                            CaretBrush="{StaticResource ColorAccent}"
                            CornerRadius="7"
                            FontFamily="{StaticResource FontBody}"
                            FontSize="34"
                            Foreground="{StaticResource ColorText}"
                            MinHeight="82"
                            Padding="18,0"
                            PlaceholderText="Golden Retriever"
                            Text="{Binding Breed}"
                            VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock
                            FontFamily="{StaticResource FontBody}"
                            FontSize="28"
                            Foreground="{StaticResource ColorTextMuted70}"
                            Text="Tutor" />
                        <!--  Typeable: the tutor list grows, and scrolling it to find a name does not.  -->
                        <inputs:VSearchableComboBox
                            Classes="FormInput"
                            ItemsSource="{Binding TutorOptions}"
                            PlaceholderText="Selecione…"
                            SelectedItem="{Binding SelectedTutor}" />
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock
                            FontFamily="{StaticResource FontBody}"
                            FontSize="28"
                            Foreground="{StaticResource ColorTextMuted70}"
                            Text="Descrição" />
                        <TextBox
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderBrush="{StaticResource ColorDivider}"
                            BorderThickness="2"
                            CaretBrush="{StaticResource ColorAccent}"
                            CornerRadius="7"
                            FontFamily="{StaticResource FontBody}"
                            FontSize="34"
                            Foreground="{StaticResource ColorText}"
                            MinHeight="160"
                            Padding="18,12"
                            PlaceholderText="Temperamento, cuidados, rotina…"
                            Text="{Binding Description}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock
                        Classes="FormMsg Error"
                        FontFamily="{StaticResource FontBody}"
                        FontSize="31"
                        FontStyle="Italic"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding HasError}"
                        Text="{Binding ErrorMessage}"
                        TextAlignment="Center" />

                    <buttons:VButton
                        Classes="BtnPrimary"
                        Command="{Binding SaveCommand}"
                        Height="97"
                        HorizontalAlignment="Stretch"
                        VText="Salvar cachorro" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
