<UserControl
    d:DesignHeight="1460"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="DapperDemo.View.Views.ComplementaryViews.NewDogView"
    x:DataType="complementaryViewsViewmodels:NewDogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:complementaryViewsViewmodels="clr-namespace:DapperDemo.Viewmodel.Viewmodels.ComplementaryViewsViewmodels;assembly=DapperDemo.Viewmodel"
    xmlns:converters="using:DapperDemo.View.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inputs="using:AvaloniaFramework.Controls.Inputs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource SurfacePrimary}" Width="720">
        <ScrollViewer>
            <StackPanel>
                <Button
                    Command="{Binding BackCommand}"
                    Margin="30,30,0,0"
                    Tag="Cachorros"
                    Theme="{StaticResource BackControl}" />

                <TextBlock Classes="TTitle" Margin="35,28,35,0" Text="Novo cachorro" />

                <TextBlock Classes="TMicro" Margin="35,42,35,14" Text="DADOS" />

                <Border Classes="Group">
                    <StackPanel>
                        <StackPanel Margin="28,21" Spacing="4">
                            <TextBlock Classes="TCaption" Text="Nome" />
                            <TextBox Classes="Field" Text="{Binding Name}" Watermark="Toby" />
                        </StackPanel>

                        <Border Classes="RowRule" />

                        <StackPanel Margin="28,21" Spacing="4">
                            <TextBlock Classes="TCaption" Text="Raça" />
                            <TextBox Classes="Field" Text="{Binding Breed}" Watermark="Golden Retriever" />
                        </StackPanel>

                        <Border Classes="RowRule" />

                        <!--  Typeable: the tutor list grows, and scrolling it to find a name does not.  -->
                        <StackPanel Margin="28,21" Spacing="4">
                            <TextBlock Classes="TCaption" Text="Tutor" />
                            <inputs:VSearchableComboBox
                                Classes="FieldPicker"
                                IsVisible="{Binding HasTutors}"
                                ItemsSource="{Binding TutorOptions}"
                                PlaceholderText="Selecione…"
                                SelectedItem="{Binding SelectedTutor}" />
                            <TextBlock
                                Classes="TBody Muted"
                                IsVisible="{Binding HasNoTutors}"
                                Text="Cadastre um tutor primeiro." />
                        </StackPanel>

                        <Border Classes="RowRule" />

                        <StackPanel Margin="28,21" Spacing="4">
                            <TextBlock Classes="TCaption" Text="Descrição" />
                            <TextBox
                                AcceptsReturn="True"
                                Classes="Field"
                                Text="{Binding Description}"
                                TextWrapping="Wrap"
                                Watermark="Temperamento, cuidados, rotina…" />
                        </StackPanel>

                        <Border Classes="RowRule" />

                        <!--
                            The photo row's trailing edge is the picture itself — an empty square
                            when unset, with no glyph and no plus. Tapping the row chooses one.
                        -->
                        <Grid ColumnDefinitions="*,Auto" Margin="28,21">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="TBody" Text="Foto" />
                                <TextBlock
                                    Classes="TCaption"
                                    IsVisible="{Binding NoPhoto}"
                                    Text="Nenhuma escolhida" />
                                <Button
                                    Classes="TextLink"
                                    Command="{Binding RemovePhotoCommand}"
                                    Content="Remover"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding HasPhoto}" />
                            </StackPanel>
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ChoosePhotoCommand}"
                                Grid.Column="1"
                                Padding="0">
                                <Border
                                    BorderBrush="{DynamicResource StrokeRaised}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Height="70"
                                    Width="70">
                                    <Image
                                        IsVisible="{Binding HasPhoto}"
                                        Source="{Binding PhotoPath, Converter={StaticResource ImagePathConverter}, ConverterParameter=192}"
                                        Stretch="UniformToFill" />
                                </Border>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock
                    Classes="TCaption Owed"
                    IsVisible="{Binding HasError}"
                    Margin="35,14,35,0"
                    Text="{Binding ErrorMessage}"
                    TextWrapping="Wrap" />

                <Border Classes="ControlRing" Margin="30,28,30,0">
                    <Border Classes="FloatingControl">
                        <Button Classes="Submit" Command="{Binding SaveCommand}">
                            <TextBlock Classes="TBody" Text="Salvar cachorro" />
                        </Button>
                    </Border>
                </Border>

                <!--  Clearance for the floating tab bar, which content scrolls under.  -->
                <Border Height="168" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
