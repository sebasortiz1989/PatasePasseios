<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:buttons="using:AvaloniaFramework.Controls.Buttons"
    xmlns:inputs="using:AvaloniaFramework.Controls.Inputs"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Classical design system tokens, ported from the Claude Design project's styles.css.
        Every screen's colors/fonts should come from these resources, never a raw hex/font name.
        Cormorant Garamond / Lora aren't bundled offline, so headings/body both fall back to
        system serif stacks; swap FontHeading/FontBody here if real font files are added later.
        Pixel values below are the source design's px scaled by ~1.7476 (this app's existing
        720-wide canvas versus the design's 412-wide canvas).
    -->
    <Styles.Resources>
        <SolidColorBrush Color="#F3F2F2" x:Key="ColorBg" />
        <SolidColorBrush Color="#EAE9E9" x:Key="ColorSurface" />
        <SolidColorBrush Color="#201F1D" x:Key="ColorText" />
        <SolidColorBrush Color="#73201F1D" x:Key="ColorTextMuted45" />
        <SolidColorBrush Color="#80201F1D" x:Key="ColorTextMuted50" />
        <SolidColorBrush Color="#8C201F1D" x:Key="ColorTextMuted55" />
        <SolidColorBrush Color="#A6201F1D" x:Key="ColorTextMuted65" />
        <SolidColorBrush Color="#B3201F1D" x:Key="ColorTextMuted70" />
        <SolidColorBrush Color="#BF201F1D" x:Key="ColorTextMuted75" />
        <SolidColorBrush Color="#29201F1D" x:Key="ColorDivider" />
        <SolidColorBrush Color="#B68235" x:Key="ColorAccent" />
        <SolidColorBrush Color="#7D5411" x:Key="ColorAccentDark700" />
        <SolidColorBrush Color="#5A3B0A" x:Key="ColorAccentDark800" />
        <SolidColorBrush Color="#1FB68235" x:Key="ColorAccentTint12" />

        <FontFamily x:Key="FontHeading">Times New Roman,Georgia,serif</FontFamily>
        <FontFamily x:Key="FontBody">Georgia,Times New Roman,serif</FontFamily>

        <!--
            Bottom-navigation icons, transcribed from the design system's 24×24 stroke icons.
            They are stroked (never filled) so a single geometry serves both the muted and the
            accent state — the stroke follows the tab's Foreground.
        -->
        <StreamGeometry x:Key="IconDogs">M11.25 16.25h1.5L12 17z M16 14v.5 M8 14v.5 M11.5 21.5a5 5 0 0 1-5-5c0-2 .5-3 1.5-4.5.6-.9 1.2-1.6 1.2-2.5a2.7 2.7 0 0 0-.7-1.8 M12.5 21.5a5 5 0 0 0 5-5c0-2-.5-3-1.5-4.5-.6-.9-1.2-1.6-1.2-2.5a2.7 2.7 0 0 1 .7-1.8 M6.5 7.5C5 6.5 4 5 4 3.5c1.5 0 3 .5 4 2 M17.5 7.5C19 6.5 20 5 20 3.5c-1.5 0-3 .5-4 2</StreamGeometry>
        <StreamGeometry x:Key="IconTutors">M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0z M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75</StreamGeometry>
        <!--
            Home: a house with a paw inside it. The paw is drawn as five stroked ellipses (four
            toes and a pad) rather than filled shapes, so it matches the other tabs' outline
            weight instead of reading as a solid blob at 37px.
        -->
        <StreamGeometry x:Key="IconHome">M3.2 11.3 12 4.4l8.8 6.9 M5.8 10.2V19.7h12.4V10.2 M9 13.9a.8 .8 0 1 0 1.6 0 .8 .8 0 1 0-1.6 0z M10.7 12.7a.8 .8 0 1 0 1.6 0 .8 .8 0 1 0-1.6 0z M12.6 12.7a.8 .8 0 1 0 1.6 0 .8 .8 0 1 0-1.6 0z M14.3 13.9a.8 .8 0 1 0 1.6 0 .8 .8 0 1 0-1.6 0z M10.2 16.7a2.2 1.7 0 1 0 4.4 0 2.2 1.7 0 1 0-4.4 0z</StreamGeometry>
        <StreamGeometry x:Key="IconNew">M12 5v14 M5 12h14</StreamGeometry>
        <StreamGeometry x:Key="IconProfile">M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2 M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0z</StreamGeometry>

        <!--  Same stroked 24×24 convention: the billing eye, open and struck through.  -->
        <StreamGeometry x:Key="IconEyeOpen">M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z</StreamGeometry>
        <StreamGeometry x:Key="IconEyeClosed">M17.9 17.9A10.1 10.1 0 0 1 12 19c-6.4 0-10-7-10-7a18.4 18.4 0 0 1 5.1-5.9 M10.9 5.2A9.1 9.1 0 0 1 12 5c6.4 0 10 7 10 7a18.5 18.5 0 0 1-2.2 3.2 M14.1 14.1a3 3 0 1 1-4.2-4.2 M2 2l20 20</StreamGeometry>

        <!--
            A bottom-navigation tab: stroked icon over a small caption, accent when selected and
            muted otherwise. Content is the icon; Tag is the caption.
        -->
        <ControlTheme TargetType="RadioButton" x:Key="NavTab">
            <Setter Property="Foreground" Value="{StaticResource ColorTextMuted50}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Grid RowDefinitions="6,*">
                            <!--
                                Selection is carried by three cues, not just the icon's colour: a
                                bar along the tab's top edge, a tinted rounded surface behind it,
                                and a heavier caption. One colour change alone was too easy to miss
                                on a five-tab bar.
                            -->
                            <Border
                                Background="Transparent"
                                CornerRadius="0,0,4,4"
                                Grid.Row="0"
                                Margin="18,0"
                                Name="PART_Indicator" />
                            <Border
                                Background="Transparent"
                                CornerRadius="8"
                                Grid.Row="1"
                                Margin="6,4,6,3"
                                Name="PART_Surface"
                                Padding="0,7,0,5">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Spacing="5"
                                    VerticalAlignment="Center">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="17"
                                        Foreground="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Center"
                                        LetterSpacing="0.7"
                                        Name="PART_Caption"
                                        Text="{TemplateBinding Tag}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:checked">
                <Setter Property="Foreground" Value="{StaticResource ColorAccent}" />
            </Style>
            <Style Selector="^:checked /template/ Border#PART_Indicator">
                <Setter Property="Background" Value="{StaticResource ColorAccent}" />
            </Style>
            <Style Selector="^:checked /template/ Border#PART_Surface">
                <Setter Property="Background" Value="{StaticResource ColorAccentTint12}" />
            </Style>
            <Style Selector="^:checked /template/ TextBlock#PART_Caption">
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Design.PreviewWith>
        <Border Background="{StaticResource ColorBg}" Padding="20">
            <!--  Add Controls for Previewer Here  -->
        </Border>
    </Design.PreviewWith>

    <!--  Headings / labels  -->
    <Style Selector="TextBlock.Heading1">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="62" />
        <Setter Property="Foreground" Value="{StaticResource ColorText}" />
        <Setter Property="LineHeight" Value="68" />
    </Style>

    <Style Selector="TextBlock.CardTitle">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource ColorText}" />
    </Style>

    <Style Selector="TextBlock.Kicker">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="LetterSpacing" Value="2" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextMuted50}" />
    </Style>

    <!--  Buttons — outlined, never filled, per the source system's "Do not fill" rule  -->
    <Style Selector="buttons|VButton.BtnPrimary">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
        <Setter Property="VFontWeight" Value="600" />
        <Setter Property="VFontSize" Value="29" />
        <Setter Property="VBorderThickness" Value="2" />
        <Setter Property="VCornerRadius" Value="7" />
        <Setter Property="VNormalBackground" Value="Transparent" />
        <Setter Property="VNormalBorderBrush" Value="{StaticResource ColorAccent}" />
        <Setter Property="VNormalForeground" Value="{StaticResource ColorAccent}" />
        <Setter Property="VPressedBackground" Value="{StaticResource ColorAccentTint12}" />
        <Setter Property="VPressedBorderBrush" Value="{StaticResource ColorAccent}" />
        <Setter Property="VPressedForeground" Value="{StaticResource ColorAccentDark800}" />
        <Setter Property="VTextHorizontalAlignment" Value="Center" />
        <Setter Property="VTextVerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="buttons|VButton.BtnSecondary">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
        <Setter Property="VFontWeight" Value="600" />
        <Setter Property="VFontSize" Value="29" />
        <Setter Property="VBorderThickness" Value="2" />
        <Setter Property="VCornerRadius" Value="7" />
        <Setter Property="VNormalBackground" Value="Transparent" />
        <Setter Property="VNormalBorderBrush" Value="{StaticResource ColorDivider}" />
        <Setter Property="VNormalForeground" Value="{StaticResource ColorText}" />
        <Setter Property="VPressedBackground" Value="{StaticResource ColorSurface}" />
        <Setter Property="VPressedBorderBrush" Value="{StaticResource ColorDivider}" />
        <Setter Property="VPressedForeground" Value="{StaticResource ColorText}" />
        <Setter Property="VTextHorizontalAlignment" Value="Center" />
        <Setter Property="VTextVerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="buttons|VButton.BtnGhost">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="VFontWeight" Value="Normal" />
        <Setter Property="VFontSize" Value="26" />
        <Setter Property="VBorderThickness" Value="0" />
        <Setter Property="VCornerRadius" Value="7" />
        <Setter Property="VNormalBackground" Value="Transparent" />
        <Setter Property="VNormalBorderBrush" Value="Transparent" />
        <Setter Property="VNormalForeground" Value="{StaticResource ColorAccent}" />
        <Setter Property="VPressedBackground" Value="{StaticResource ColorAccentTint12}" />
        <Setter Property="VPressedBorderBrush" Value="Transparent" />
        <Setter Property="VPressedForeground" Value="{StaticResource ColorAccentDark800}" />
        <Setter Property="VTextHorizontalAlignment" Value="Center" />
        <Setter Property="VTextVerticalAlignment" Value="Center" />
    </Style>

    <!--  Cards  -->
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorDivider}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <!--
        Tag / Chip / SegOption are Buttons (not static Borders) since every place they're used
        is tappable (paid toggle, filter chips, segmented type picker). Border/Foreground/Background
        are bound per-instance from computed ViewModel brush properties (active vs inactive),
        mirroring the source design's own per-instance computed style approach.
    -->
    <Style Selector="Button.Tag">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="Padding" Value="17,5" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.Tag.Pending">
        <Setter Property="BorderBrush" Value="{StaticResource ColorDivider}" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextMuted55}" />
    </Style>
    <Style Selector="Button.Tag.Paid">
        <Setter Property="BorderBrush" Value="{StaticResource ColorAccent}" />
        <Setter Property="Foreground" Value="{StaticResource ColorAccentDark800}" />
    </Style>

    <!--
        The read-only twin of Button.Tag, for lists where paid/pending is a label rather than a
        control. A Button here would sit inside the row's own tap target and look pressable while
        doing nothing. Border carries no text properties, so the type styling lives on its child.
    -->
    <Style Selector="Border.TagSign">
        <Setter Property="Padding" Value="17,5" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.TagSign.Pending">
        <Setter Property="BorderBrush" Value="{StaticResource ColorDivider}" />
    </Style>
    <Style Selector="Border.TagSign.Paid">
        <Setter Property="BorderBrush" Value="{StaticResource ColorAccent}" />
    </Style>
    <Style Selector="Border.TagSign > TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="23" />
    </Style>
    <Style Selector="Border.TagSign.Pending > TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ColorTextMuted55}" />
    </Style>
    <Style Selector="Border.TagSign.Paid > TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ColorAccentDark800}" />
    </Style>

    <Style Selector="Button.Chip">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="Padding" Value="21,9" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorDivider}" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextMuted65}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.Chip.Active">
        <Setter Property="BorderBrush" Value="{StaticResource ColorAccent}" />
        <Setter Property="Foreground" Value="{StaticResource ColorAccentDark800}" />
        <Setter Property="Background" Value="{StaticResource ColorAccentTint12}" />
    </Style>

    <Style Selector="Button.SegOption">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Padding" Value="21,12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextMuted65}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.SegOption.Active">
        <Setter Property="Foreground" Value="{StaticResource ColorAccent}" />
    </Style>

    <!--  Flat, chrome-less row container so an entire list row is one tap target  -->
    <Style Selector="Button.RowButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.RowButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ColorSurface}" />
    </Style>

    <!--  Inline form feedback — success in the accent, errors in the deepest accent step  -->
    <Style Selector="TextBlock.FormMsg">
        <Setter Property="Foreground" Value="{StaticResource ColorAccentDark700}" />
    </Style>
    <Style Selector="TextBlock.FormMsg.Error">
        <Setter Property="Foreground" Value="{StaticResource ColorAccentDark800}" />
    </Style>

    <!--  Form fields  -->
    <Style Selector="inputs|VTextBoxWithLabel.ClassicInput">
        <Setter Property="VBorderBrush" Value="{StaticResource ColorDivider}" />
        <Setter Property="VBorderBrushFocus" Value="{StaticResource ColorAccent}" />
        <Setter Property="VContentFontSize" Value="31" />
        <Setter Property="VCornerRadius" Value="7" />
        <Setter Property="VDescriptionFontSize" Value="25" />
        <Setter Property="VDescriptionForeground" Value="{StaticResource ColorTextMuted70}" />
        <Setter Property="VDescriptionBackground" Value="{StaticResource ColorBg}" />
        <Setter Property="VTextForeground" Value="{StaticResource ColorText}" />
        <Setter Property="VTextForegroundFocus" Value="{StaticResource ColorText}" />
        <Setter Property="VTextFontSize" Value="31" />
        <Setter Property="VCaretBrush" Value="{StaticResource ColorAccent}" />
        <Setter Property="VCaretBrushFocus" Value="{StaticResource ColorAccent}" />
    </Style>

    <!--  Icon-only button, sized for a thumb. Used for the billing eye.  -->
    <Style Selector="Button.IconToggle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorDivider}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Width" Value="72" />
        <Setter Property="Height" Value="72" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.IconToggle:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ColorAccentTint12}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorAccent}" />
    </Style>

    <!--
        The bare TextBox/ComboBox field shape, previously copied inline into every form. The
        detail screens' editors reuse it, so it lives here rather than being pasted a fourth time.
    -->
    <Style Selector="TextBlock.FormLabel">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextMuted70}" />
    </Style>
    <Style Selector="TextBox.FormInput">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorDivider}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="31" />
        <Setter Property="Foreground" Value="{StaticResource ColorText}" />
        <Setter Property="MinHeight" Value="82" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!--  A multi-line field needs top padding and cannot centre its content.  -->
    <Style Selector="TextBox.FormInput.Multiline">
        <Setter Property="MinHeight" Value="160" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="ComboBox.FormInput">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorDivider}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="FontSize" Value="31" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="82" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <!--
        Text selection. Fluent's default highlight reads as a near-black block on this light
        surface; these put it on the accent instead. SelectionBrush/SelectionForegroundBrush are
        plain TextBox properties, so this reaches the TextBox inside VTextBoxWithLabel's template
        as well as the bare ones.
    -->
    <Style Selector="TextBox">
        <Setter Property="SelectionBrush" Value="{StaticResource ColorAccentTint12}" />
        <Setter Property="SelectionForegroundBrush" Value="{StaticResource ColorAccentDark800}" />
        <Setter Property="CaretBrush" Value="{StaticResource ColorAccent}" />
    </Style>

    <!--
        The back affordance every screen starts with. Left-aligned and auto-width so the label
        hugs the edge — the earlier per-view fixed widths (180/200) centred "← Voltar" inside an
        oversized invisible box, which is what made them look inconsistent.
    -->
    <Style Selector="buttons|VButton.BtnBack">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="VFontSize" Value="28" />
        <Setter Property="VFontWeight" Value="Normal" />
        <Setter Property="VBorderThickness" Value="0" />
        <Setter Property="VCornerRadius" Value="7" />
        <Setter Property="VNormalBackground" Value="Transparent" />
        <Setter Property="VNormalBorderBrush" Value="Transparent" />
        <Setter Property="VNormalForeground" Value="{StaticResource ColorAccent}" />
        <Setter Property="VPressedBackground" Value="{StaticResource ColorAccentTint12}" />
        <Setter Property="VPressedBorderBrush" Value="Transparent" />
        <Setter Property="VPressedForeground" Value="{StaticResource ColorAccentDark800}" />
        <Setter Property="VTextHorizontalAlignment" Value="Left" />
        <Setter Property="VTextVerticalAlignment" Value="Center" />
        <Setter Property="VPadding" Value="8,10" />
        <Setter Property="Height" Value="66" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!--  Dropdown surface and item highlight, so a picked option reads brown rather than filled.  -->
    <Style Selector="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{StaticResource ColorText}" />
        <Setter Property="PlaceholderForeground" Value="{StaticResource ColorTextMuted50}" />
    </Style>
    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{StaticResource ColorBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorDivider}" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{StaticResource ColorText}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{StaticResource ColorAccentTint12}" />
        <Setter Property="Foreground" Value="{StaticResource ColorText}" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="{StaticResource ColorAccentTint12}" />
        <Setter Property="Foreground" Value="{StaticResource ColorAccentDark800}" />
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{StaticResource ColorAccentTint12}" />
        <Setter Property="Foreground" Value="{StaticResource ColorAccentDark800}" />
    </Style>

    <!--  Generic list selection, for anything else that uses ListBoxItem.  -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ColorAccentTint12}" />
        <Setter Property="Foreground" Value="{StaticResource ColorAccentDark800}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ColorAccentTint12}" />
    </Style>

    <!--
        Calendar and clock popups. Fluent draws these from its own accent and surface colours,
        which clash with the Classical palette, so the shared surfaces are restated here.
    -->
    <Style Selector="CalendarDatePicker">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{StaticResource ColorText}" />
    </Style>

    <!--
        The drop-down button that opens the calendar. Fluent sizes it for a mouse on a desktop
        window; on this 720-wide canvas it ends up a tiny tap target, so it is scaled to match
        the 74px-high field it sits in.
    -->
    <!--
        Filled rather than a ghost: it sits inside the text field's own border, so without its own
        colour the one part of a date field that is actually clickable looks like decoration.
    -->
    <Style Selector="CalendarDatePicker /template/ Button#PART_Button">
        <Setter Property="Width" Value="66" />
        <Setter Property="Height" Value="66" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{StaticResource ColorAccent}" />
        <Setter Property="Foreground" Value="{StaticResource ColorText}" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ Button#PART_Button:pointerover">
        <Setter Property="Background" Value="{StaticResource ColorAccentDark700}" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ Button#PART_Button:pressed">
        <Setter Property="Background" Value="{StaticResource ColorAccentDark800}" />
    </Style>
    <!--
        The glyph is black rather than the background colour: on the accent fill the pale version
        was washed out to the point of being hard to find. The name-independent rule below it is
        deliberate belt-and-braces — the glyph only inherits Foreground if the template does not
        set its own, and the button's part name is not guaranteed across Avalonia versions.
    -->
    <Style Selector="CalendarDatePicker /template/ Button#PART_Button PathIcon">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource ColorText}" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ PathIcon">
        <Setter Property="Foreground" Value="{StaticResource ColorText}" />
    </Style>

    <Style Selector="Calendar">
        <Setter Property="Background" Value="{StaticResource ColorBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorDivider}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{StaticResource ColorText}" />
    </Style>

    <Style Selector="CalendarItem">
        <Setter Property="Background" Value="{StaticResource ColorBg}" />
        <Setter Property="HeaderBackground" Value="{StaticResource ColorBg}" />
    </Style>

    <Style Selector="CalendarDayButton">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{StaticResource ColorText}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="CalendarDayButton:pointerover">
        <Setter Property="Background" Value="{StaticResource ColorAccentTint12}" />
    </Style>
    <Style Selector="CalendarDayButton:selected">
        <Setter Property="Background" Value="{StaticResource ColorAccentTint12}" />
        <Setter Property="Foreground" Value="{StaticResource ColorAccentDark800}" />
    </Style>
    <Style Selector="CalendarDayButton:today">
        <Setter Property="Foreground" Value="{StaticResource ColorAccent}" />
    </Style>
    <Style Selector="CalendarDayButton:blackout">
        <Setter Property="Foreground" Value="{StaticResource ColorTextMuted45}" />
    </Style>

    <Style Selector="CalendarButton">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{StaticResource ColorText}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="CalendarButton:selected">
        <Setter Property="Background" Value="{StaticResource ColorAccentTint12}" />
        <Setter Property="Foreground" Value="{StaticResource ColorAccentDark800}" />
    </Style>

    <Style Selector="TimePicker">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorDivider}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource ColorText}" />
    </Style>

    <!--
        Fluent's flyout button sizes itself to its content and sits at the top of the 74px-high
        field, which left the time reading high rather than centred. Selectors here are matched by
        type instead of PART name so they survive template renames; the only Button and TextBlocks
        inside a TimePicker's template are the field itself.
    -->
    <Style Selector="TimePicker /template/ Button">
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TimePicker /template/ Grid">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TimePicker /template/ TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="34" />
    </Style>

    <Style Selector="TimePickerPresenter">
        <Setter Property="Background" Value="{StaticResource ColorBg}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    </Style>

    <!--  The scrollable hour/minute columns inside the clock popup.  -->
    <Style Selector="DateTimePickerPanel > ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{StaticResource ColorText}" />
    </Style>
    <Style Selector="DateTimePickerPanel > ListBoxItem:pointerover">
        <Setter Property="Background" Value="{StaticResource ColorAccentTint12}" />
    </Style>
    <Style Selector="DateTimePickerPanel > ListBoxItem:selected">
        <Setter Property="Background" Value="{StaticResource ColorAccentTint12}" />
        <Setter Property="Foreground" Value="{StaticResource ColorAccentDark800}" />
    </Style>

</Styles>
