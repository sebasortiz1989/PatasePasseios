<UserControl
    x:Class="DapperDemo.View.Components.PeriodPicker"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:utils="clr-namespace:DapperDemo.Viewmodel.Viewmodels.Utils;assembly=DapperDemo.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The period picker, expanded inline rather than in a popup: a popup lays out in its own
        visual root and so ignores the design canvas' scale, which is why this app has none. Same
        trick the searchable field pickers use.

        It exists because the arrows alone made a past month expensive — reaching a December of
        last year meant walking back a month at a time, seven taps or more. Year row, then a month
        cell, is three.

        Bindings target the control's own Picker through #Root rather than the ambient DataContext,
        the same as ConfirmDialog and ReportPreview.

        IsOpen gates this inner border and not the UserControl itself. A host that has its own
        reason to hide the whole control — Agenda, which shows a period only in the Data range —
        binds IsVisible on the instance, and that is a local value on the very same object as a
        root IsVisible here would be. The host's binding is applied after this file is loaded, so
        it would silently replace the IsOpen gate and leave the picker permanently expanded. One
        condition per object composes; two do not.
    -->
    <Border
        Classes="Group"
        IsVisible="{Binding #Root.Picker.IsOpen}"
        Margin="35,21,35,0">
        <StackPanel Margin="28,21" Spacing="14">

            <!--  The year, stepped without closing the picker.  -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding #Root.Picker.PreviousYearCommand}"
                    Grid.Column="0"
                    Padding="0"
                    Width="70">
                    <Viewbox
                        Height="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="30">
                        <Path
                            Data="{StaticResource IconChevronLeft}"
                            Stretch="Uniform"
                            Stroke="{DynamicResource InkPrimary}"
                            StrokeJoin="Round"
                            StrokeLineCap="Round"
                            StrokeThickness="1" />
                    </Viewbox>
                </Button>
                <TextBlock
                    Classes="TBody"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Text="{Binding #Root.Picker.YearLabel}"
                    VerticalAlignment="Center" />
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding #Root.Picker.NextYearCommand}"
                    Grid.Column="2"
                    Padding="0"
                    Width="70">
                    <Viewbox
                        Height="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="30">
                        <Path
                            Data="{StaticResource IconChevronRight}"
                            Stretch="Uniform"
                            Stroke="{DynamicResource InkPrimary}"
                            StrokeJoin="Round"
                            StrokeLineCap="Round"
                            StrokeThickness="1" />
                    </Viewbox>
                </Button>
            </Grid>

            <Border Classes="RowRule" Margin="0" />

            <!--
                The whole-year cell leads and reads as the year itself; the twelve months follow,
                four to a row. The selected cell wears the same accent tint the filter chips use,
                so selection reads the same way everywhere.
            -->
            <ItemsControl ItemsSource="{Binding #Root.Picker.Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="utils:PeriodCell">
                        <Button
                            Classes="Chip"
                            Classes.Active="{Binding IsSelected}"
                            Command="{Binding SelectCommand}"
                            Content="{Binding Label}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="3" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
