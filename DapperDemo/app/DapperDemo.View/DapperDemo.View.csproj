<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>Verion.Treinamento.DapperDemo.View</AssemblyName>
        <RootNamespace>Verion.Treinamento.DapperDemo.View</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.1" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
        <PackageReference Include="Verion.Apresentacao.Avalonia" Version="19.0.23" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DapperDemo.Viewmodel\DapperDemo.Viewmodel.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\SignUpView.axaml.cs">
        <DependentUpon>SignUpView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\MainView\DogsView.axaml.cs">
        <DependentUpon>DogsView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainView\HomeView.axaml.cs">
        <DependentUpon>HomeView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainView\ServicesView.axaml.cs">
        <DependentUpon>ServicesView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainView\TutorsView.axaml.cs">
        <DependentUpon>TutorsView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainView\UsersView.axaml.cs">
        <DependentUpon>UsersView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>
</Project>
