<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>DapperDemo.View</AssemblyName>
        <RootNamespace>DapperDemo.View</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="AvaloniaFramework" />
        <Using Include="AvaloniaFramework.DependencyInjection" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.1" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
        <!--
            PDF export. Confined to Reports\QuestPdfReportExporter.cs — the view models build a
            ReportDocument and never see this package. Community licence, which covers individuals
            and small companies; see README.
        -->
        <PackageReference Include="QuestPDF" Version="2025.7.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\external\AvaloniaFramework\AvaloniaFramework\AvaloniaFramework.csproj" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DapperDemo.Viewmodel\DapperDemo.Viewmodel.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\SignUpView.axaml.cs">
        <DependentUpon>SignUpView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\MainView\DogsView.axaml.cs">
        <DependentUpon>DogsView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainView\HomeView.axaml.cs">
        <DependentUpon>HomeView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainView\ServicesView.axaml.cs">
        <DependentUpon>ServicesView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainView\TutorsView.axaml.cs">
        <DependentUpon>TutorsView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainView\UsersView.axaml.cs">
        <DependentUpon>UsersView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainViewViews\AgendaView.axaml.cs">
        <DependentUpon>HomeView.axaml</DependentUpon>
      </Compile>
    </ItemGroup>
</Project>
