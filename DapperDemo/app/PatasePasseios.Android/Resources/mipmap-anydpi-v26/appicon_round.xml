<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon for API 26 and up: Android masks the two layers itself, so the icon takes
    whatever shape the launcher uses — circle, squircle, rounded square — instead of being a
    fixed square the launcher then crops.

    The foreground is inset because an adaptive icon's outer ~25% can be cropped by the mask;
    only the middle is guaranteed visible, so the artwork has to sit inside it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@mipmap/appicon_foreground"
            android:inset="18%" />
    </foreground>
    <monochrome>
        <inset
            android:drawable="@mipmap/appicon_foreground"
            android:inset="18%" />
    </monochrome>
</adaptive-icon>
