<UserControl
    d:DesignHeight="1560"
    d:DesignWidth="720"
    mc:Ignorable="d"
    x:Class="PatasePasseios.View.Views.NavigationViews.LoginView"
    x:DataType="navigationViewsViewmodels:LoginViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:components="using:PatasePasseios.View.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigationViewsViewmodels="clr-namespace:PatasePasseios.Viewmodel.Viewmodels.NavigationViewsViewmodels;assembly=PatasePasseios.Viewmodel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <components:DesignCanvas DesignHeight="1560" DesignWidth="720">
        <Grid Background="{DynamicResource SurfacePrimary}" Width="720">
            <!--
                The sign-in screen is short enough to sit in the middle of the window rather than
                hanging off the top. A ScrollViewer measures its content against infinite height, so
                VerticalAlignment alone would do nothing — the Panel is pinned to the viewport's own
                height, and the content centres inside that. It still scrolls when the keyboard is
                up or the text ramp is at Máximo, because the Panel only sets a minimum.
            -->
            <ScrollViewer Name="Scroller">
                <Panel MinHeight="{Binding #Scroller.Bounds.Height}">
                    <StackPanel Margin="0,70" VerticalAlignment="Center">

                        <!--  The brand line is the one display-size thing in the app.  -->
                        <StackPanel Margin="35,0" Spacing="10">
                            <TextBlock Classes="TDisplay" Text="Patas &amp; Passeios" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            <TextBlock Classes="TCaption" Text="Serviços para cães" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!--
                            Two groups rather than one with a rule between them: e-mail and senha are
                            separate answers, and the refresh uses a group per idea.
                        -->
                        <Border Classes="Group" Margin="35,56,35,0">
                            <StackPanel Margin="28,21" Spacing="7">
                                <TextBlock Classes="TCaption" Text="E-mail" />
                                <TextBox
                                    Classes="Field"
                                    Text="{Binding Email}"
                                    PlaceholderText="voce@exemplo.com" />
                            </StackPanel>
                        </Border>

                        <Border Classes="Group" Margin="35,21,35,0">
                            <StackPanel Margin="28,21" Spacing="7">
                                <TextBlock Classes="TCaption" Text="Senha" />
                                <TextBox
                                    Classes="Field"
                                    PasswordChar="•"
                                    Text="{Binding Password}" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Classes="TCaption Owed"
                            IsVisible="{Binding HasLoginError}"
                            Margin="35,14,35,0"
                            Text="{Binding LoginError}"
                            TextWrapping="Wrap" />

                        <Border Classes="ControlRing" Margin="30,28,30,0">
                            <Border Classes="FloatingControl">
                                <Button Classes="Submit" Command="{Binding LoginCommand}">
                                    <TextBlock Classes="TBody" Text="Entrar" />
                                </Button>
                            </Border>
                        </Border>

                        <!--  Secondary routes are lines at the margin, never a second button.  -->
                        <StackPanel HorizontalAlignment="Center" Margin="35,35,35,0" Spacing="24">
                            <Button
                                Classes="TextLink"
                                Command="{Binding SignUpCommand}"
                                Content="Criar uma conta" />
                            <Button
                                Classes="TextLink"
                                Command="{Binding ImportBackupCommand}"
                                Content="Importar backup" />
                        </StackPanel>

                        <TextBlock
                            Classes="TCaption"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding HasBackupMsg}"
                            Margin="35,21,35,0"
                            Text="{Binding BackupMsg}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Classes="TCaption"
                            HorizontalAlignment="Center"
                            Margin="0,35,0,0"
                            Text="{Binding VersionLabel}" />
                    </StackPanel>
                </Panel>
            </ScrollViewer>

            <components:ConfirmDialog
                ConfirmCommand="{Binding DismissInvalidBackupCommand}"
                ConfirmText="Entendi"
                IsOpen="{Binding ShowInvalidBackupAlert}"
                Message="{Binding InvalidBackupMessage}"
                ShowCancel="False"
                Title="{Binding InvalidBackupTitle}" />
        </Grid>
    </components:DesignCanvas>
</UserControl>
