<UserControl
    IsVisible="{Binding #Root.IsOpen}"
    x:Class="PatasePasseios.View.Components.ConfirmDialog"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:buttons="using:AvaloniaFramework.Controls.Buttons"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Bindings here target the control's own properties through #Root rather than the ambient
        DataContext: a UserControl inherits its parent's DataContext, so a plain {Binding Message}
        would look for Message on the screen's view model instead of on this control.
    -->
    <!--
        Over a scrim there is no page colour to ring with, so this is the one floating thing in the
        app with fill and edge but no ring — the scrim does the separating.
    -->
    <Border Background="{DynamicResource Scrim}">
        <Border
            Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource StrokeControl}"
            BorderThickness="1"
            CornerRadius="21"
            HorizontalAlignment="Center"
            Margin="48"
            VerticalAlignment="Center"
            Width="595">
            <StackPanel>
                <StackPanel Margin="35,35,35,28" Spacing="14">
                    <TextBlock
                        Classes="TBody"
                        Text="{Binding #Root.Title}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Classes="TUi Muted"
                        Text="{Binding #Root.Message}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border Classes="RowRule" Margin="0" />

                <!--  Não sits left as the safe default; Sim carries the destructive action.  -->
                <Grid
                    ColumnDefinitions="*,Auto,*"
                    Height="84"
                    IsVisible="{Binding #Root.ShowCancel}">
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding #Root.CancelCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center">
                        <TextBlock Classes="TBody" Text="{Binding #Root.CancelText}" />
                    </Button>
                    <Border Classes="SegRule" Grid.Column="1" />
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding #Root.ConfirmCommand}"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center">
                        <TextBlock
                            Classes="TBody Owed"
                            FontWeight="SemiBold"
                            Text="{Binding #Root.ConfirmText}" />
                    </Button>
                </Grid>

                <!--
                    Alert form: one full-width cell. A separate element rather than a spanning
                    column, because hiding a Grid child leaves its column occupying space and the
                    lone button would sit off-centre.
                -->
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding #Root.ConfirmCommand}"
                    Height="84"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    IsVisible="{Binding !#Root.ShowCancel}">
                    <TextBlock
                        Classes="TBody Owed"
                        FontWeight="SemiBold"
                        Text="{Binding #Root.ConfirmText}" />
                </Button>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
